[{"texto": "En mil novecientos dieciséis, un meteorólogo inglés cambió su oficina por una ambulancia en el frente francés.", "fin": 7.62, "palabras": [["En", 0.08], ["mil", 0.25], ["novecientos", 0.47], ["dieciséis", 1.12], ["un", 2.39], ["meteorólogo", 2.5], ["inglés", 3.24], ["cambió", 3.74], ["su", 4.17], ["oficina", 4.33], ["por", 4.94], ["una", 5.15], ["ambulancia", 5.36], ["en", 6.17], ["el", 6.32], ["frente", 6.46], ["francés", 6.86]]}, {"texto": "Se llamaba Lúis Frai Ríchardson. Era cuáquero y objetor de conciencia: no aceptaba tomar un arma.", "fin": 7.78, "palabras": [["Se", 0.1], ["llamaba", 0.28], ["Lúis", 0.78], ["Frai", 1.26], ["Ríchardson", 1.67], ["Era", 2.97], ["cuáquero", 3.22], ["y", 3.81], ["objetor", 3.93], ["de", 4.49], ["conciencia", 4.6], ["no", 5.89], ["aceptaba", 6.08], ["tomar", 6.75], ["un", 7.14], ["arma", 7.29]]}, {"texto": "Durante la guerra trabajó en una idea extraordinaria: calcular el tiempo atmosférico resolviendo las ecuaciones que lo describen. Hizo los cálculos a mano, en el frente.", "fin": 12.06, "palabras": [["Durante", 0.07], ["la", 0.53], ["guerra", 0.64], ["trabajó", 1.01], ["en", 1.57], ["una", 1.69], ["idea", 1.92], ["extraordinaria", 2.31], ["calcular", 3.94], ["el", 4.5], ["tiempo", 4.67], ["atmosférico", 5.04], ["resolviendo", 5.85], ["las", 6.57], ["ecuaciones", 6.78], ["que", 7.54], ["lo", 7.68], ["describen", 7.79], ["Hizo", 9.0], ["los", 9.31], ["cálculos", 9.54], ["a", 10.17], ["mano", 10.24], ["en", 11.14], ["el", 11.32], ["frente", 11.46]]}, {"texto": "Su primer intento fue un fracaso práctico. Pero el principio que exploraba se convertiría en una de las bases de la predicción meteorológica moderna.", "fin": 9.99, "palabras": [["Su", 0.08], ["primer", 0.29], ["intento", 0.65], ["fue", 1.25], ["un", 1.5], ["fracaso", 1.64], ["práctico", 2.25], ["Pero", 3.44], ["el", 3.62], ["principio", 3.74], ["que", 4.36], ["exploraba", 4.51], ["se", 5.18], ["convertiría", 5.35], ["en", 6.21], ["una", 6.36], ["de", 6.58], ["las", 6.72], ["bases", 6.96], ["de", 7.4], ["la", 7.5], ["predicción", 7.62], ["meteorológica", 8.32], ["moderna", 9.31]]}, {"texto": "En mil novecientos veinte, la oficina meteorológica pasó a depender del Ministerio del Aire, y Ríchardson renunció: no quería trabajar para la guerra.", "fin": 10.37, "palabras": [["En", 0.08], ["mil", 0.24], ["novecientos", 0.44], ["veinte", 1.07], ["la", 1.99], ["oficina", 2.1], ["meteorológica", 2.6], ["pasó", 3.56], ["a", 3.9], ["depender", 3.94], ["del", 4.53], ["Ministerio", 4.71], ["del", 5.35], ["Aire", 5.54], ["y", 6.46], ["Ríchardson", 6.57], ["renunció", 7.26], ["no", 8.29], ["quería", 8.49], ["trabajar", 8.89], ["para", 9.5], ["la", 9.72], ["guerra", 9.85]]}, {"texto": "Entonces decidió estudiar la guerra misma, con números. Se preguntó, por ejemplo, si los países que comparten más frontera pelean más entre sí.", "fin": 11.1, "palabras": [["Entonces", 0.08], ["decidió", 0.74], ["estudiar", 1.24], ["la", 1.82], ["guerra", 1.94], ["misma", 2.29], ["con", 3.17], ["números", 3.39], ["Se", 4.5], ["preguntó", 4.74], ["por", 5.78], ["ejemplo", 5.96], ["si", 7.01], ["los", 7.17], ["países", 7.39], ["que", 7.88], ["comparten", 8.0], ["más", 8.68], ["frontera", 8.97], ["pelean", 9.54], ["más", 10.07], ["entre", 10.43], ["sí", 10.72]]}, {"texto": "Para eso necesitaba un dato que parecía sencillo: cuánto mide cada frontera.", "fin": 5.5, "palabras": [["Para", 0.1], ["eso", 0.36], ["necesitaba", 0.62], ["un", 1.4], ["dato", 1.6], ["que", 1.94], ["parecía", 2.1], ["sencillo", 2.65], ["cuánto", 3.75], ["mide", 4.12], ["cada", 4.46], ["frontera", 4.79]]}, {"texto": "Y no lo era. Para la frontera entre España y Portugal encontró dos cifras: novecientos ochenta y siete kilómetros, y mil doscientos catorce.", "fin": 10.1, "palabras": [["Y", 0.1], ["no", 0.19], ["lo", 0.44], ["era", 0.65], ["Para", 1.51], ["la", 1.69], ["frontera", 1.82], ["entre", 2.32], ["España", 2.6], ["y", 3.1], ["Portugal", 3.17], ["encontró", 3.81], ["dos", 4.4], ["cifras", 4.71], ["novecientos", 5.68], ["ochenta", 6.44], ["y", 6.83], ["siete", 6.9], ["kilómetros", 7.25], ["y", 8.39], ["mil", 8.49], ["doscientos", 8.79], ["catorce", 9.42]]}, {"texto": "Entre Bélgica y los Países Bajos pasaba lo mismo: trescientos ochenta, contra cuatrocientos cuarenta y nueve.", "fin": 7.93, "palabras": [["Entre", 0.08], ["Bélgica", 0.4], ["y", 0.96], ["los", 1.03], ["Países", 1.25], ["Bajos", 1.83], ["pasaba", 2.28], ["lo", 2.75], ["mismo", 2.88], ["trescientos", 4.0], ["ochenta", 4.67], ["contra", 5.71], ["cuatrocientos", 6.07], ["cuarenta", 6.96], ["y", 7.39], ["nueve", 7.44]]}, {"texto": "Incluso hoy, distintas fuentes dan cifras distintas para la misma línea.", "fin": 5.43, "palabras": [["Incluso", 0.08], ["hoy", 0.71], ["distintas", 1.57], ["fuentes", 2.17], ["dan", 2.68], ["cifras", 2.92], ["distintas", 3.39], ["para", 4.12], ["la", 4.35], ["misma", 4.47], ["línea", 4.88]]}, {"texto": "Ríchardson sospechó que nadie se había equivocado: cada uno había medido con una regla distinta.", "fin": 6.64, "palabras": [["Ríchardson", 0.07], ["sospechó", 0.82], ["que", 1.39], ["nadie", 1.53], ["se", 1.96], ["había", 2.12], ["equivocado", 2.46], ["cada", 3.64], ["uno", 3.96], ["había", 4.24], ["medido", 4.53], ["con", 5.06], ["una", 5.26], ["regla", 5.5], ["distinta", 5.88]]}, {"texto": "Para entender por qué, hicimos nuestro propio experimento: una sola fuente de datos, y distintas reglas.", "fin": 7.89, "palabras": [["Para", 0.1], ["entender", 0.28], ["por", 0.83], ["qué", 1.06], ["hicimos", 1.88], ["nuestro", 2.36], ["propio", 2.74], ["experimento", 3.11], ["una", 4.38], ["sola", 4.6], ["fuente", 4.93], ["de", 5.35], ["datos", 5.47], ["y", 6.38], ["distintas", 6.47], ["reglas", 7.22]]}, {"texto": "Con pasos de ochenta kilómetros, la frontera mide setecientos veintidós. Con pasos de veinte, ochocientos ochenta y cuatro. Con pasos de cinco, mil catorce.", "fin": 12.85, "palabras": [["Con", 0.08], ["pasos", 0.29], ["de", 0.74], ["ochenta", 0.85], ["kilómetros", 1.35], ["la", 2.57], ["frontera", 2.71], ["mide", 3.24], ["setecientos", 3.61], ["veintidós", 4.5], ["Con", 5.72], ["pasos", 5.94], ["de", 6.39], ["veinte", 6.5], ["ochocientos", 7.65], ["ochenta", 8.5], ["y", 8.94], ["cuatro", 9.01], ["Con", 10.01], ["pasos", 10.24], ["de", 10.67], ["cinco", 10.78], ["mil", 11.85], ["catorce", 12.11]]}, {"texto": "Las tres medidas son correctas. Lo que cambia es el tamaño del paso: cuanto más corto, más larga resulta la frontera.", "fin": 9.01, "palabras": [["Las", 0.08], ["tres", 0.35], ["medidas", 0.65], ["son", 1.21], ["correctas", 1.44], ["Lo", 2.71], ["que", 2.88], ["cambia", 3.03], ["es", 3.51], ["el", 3.68], ["tamaño", 3.82], ["del", 4.28], ["paso", 4.49], ["cuanto", 5.32], ["más", 5.71], ["corto", 5.99], ["más", 6.92], ["larga", 7.19], ["resulta", 7.58], ["la", 8.17], ["frontera", 8.29]]}, {"texto": "Ahora midamos otra frontera: la que separa a Estados Unidos y Canadá a lo largo del paralelo cuarenta y nueve.", "fin": 7.26, "palabras": [["Ahora", 0.08], ["midamos", 0.46], ["otra", 1.04], ["frontera", 1.32], ["la", 2.32], ["que", 2.43], ["separa", 2.57], ["a", 3.04], ["Estados", 3.1], ["Unidos", 3.62], ["y", 4.24], ["Canadá", 4.35], ["a", 4.88], ["lo", 4.93], ["largo", 5.08], ["del", 5.47], ["paralelo", 5.68], ["cuarenta", 6.26], ["y", 6.72], ["nueve", 6.78]]}, {"texto": "Con pasos de ochenta, de veinte o de cinco kilómetros, mide siempre lo mismo: dos mil veintidós. Esa línea se trazó sobre un paralelo, en un tratado. En todo el rango que medimos, achicar la regla no revela ningún detalle nuevo.", "fin": 17.72, "palabras": [["Con", 0.08], ["pasos", 0.29], ["de", 0.68], ["ochenta", 0.76], ["de", 1.81], ["veinte", 1.92], ["o", 2.43], ["de", 2.54], ["cinco", 2.67], ["kilómetros", 3.08], ["mide", 4.32], ["siempre", 4.62], ["lo", 5.08], ["mismo", 5.19], ["dos", 5.99], ["mil", 6.22], ["veintidós", 6.47], ["Esa", 7.72], ["línea", 8.01], ["se", 8.46], ["trazó", 8.65], ["sobre", 9.08], ["un", 9.43], ["paralelo", 9.6], ["en", 10.69], ["un", 10.89], ["tratado", 11.06], ["En", 12.17], ["todo", 12.39], ["el", 12.69], ["rango", 12.83], ["que", 13.22], ["medimos", 13.35], ["achicar", 14.44], ["la", 14.97], ["regla", 15.11], ["no", 15.53], ["revela", 15.74], ["ningún", 16.18], ["detalle", 16.71], ["nuevo", 17.21]]}, {"texto": "Si anotamos estas medidas en una escala especial, donde cada marca multiplica la anterior, los puntos caen en línea recta. Fue lo que encontró Ríchardson.", "fin": 11.43, "palabras": [["Si", 0.08], ["anotamos", 0.31], ["estas", 0.9], ["medidas", 1.29], ["en", 1.88], ["una", 2.01], ["escala", 2.19], ["especial", 2.61], ["donde", 3.83], ["cada", 4.12], ["marca", 4.42], ["multiplica", 4.79], ["la", 5.53], ["anterior", 5.65], ["los", 6.69], ["puntos", 6.9], ["caen", 7.4], ["en", 7.79], ["línea", 7.96], ["recta", 8.38], ["Fue", 9.39], ["lo", 9.64], ["que", 9.78], ["encontró", 9.93], ["Ríchardson", 10.54]]}, {"texto": "La recta horizontal es la de una línea que no cambia con la regla. La que baja es la de una línea que se sigue quebrando. Y de esa inclinación se obtiene un número.", "fin": 11.5, "palabras": [["La", 0.08], ["recta", 0.26], ["horizontal", 0.65], ["es", 1.46], ["la", 1.67], ["de", 1.79], ["una", 1.93], ["línea", 2.17], ["que", 2.65], ["no", 2.83], ["cambia", 3.04], ["con", 3.49], ["la", 3.68], ["regla", 3.81], ["La", 4.78], ["que", 4.94], ["baja", 5.1], ["es", 5.54], ["la", 5.79], ["de", 5.93], ["una", 6.07], ["línea", 6.31], ["que", 6.78], ["se", 6.94], ["sigue", 7.1], ["quebrando", 7.47], ["Y", 8.6], ["de", 8.71], ["esa", 8.93], ["inclinación", 9.19], ["se", 10.04], ["obtiene", 10.22], ["un", 10.76], ["número", 10.94]]}, {"texto": "Cada línea tiene su inclinación: casi horizontal para la costa de Sudáfrica, mucho más empinada para la costa oeste de Gran Bretaña.", "fin": 9.6, "palabras": [["Cada", 0.1], ["línea", 0.36], ["tiene", 0.82], ["su", 1.15], ["inclinación", 1.29], ["casi", 2.69], ["horizontal", 3.06], ["para", 3.72], ["la", 3.94], ["costa", 4.08], ["de", 4.47], ["Sudáfrica", 4.6], ["mucho", 5.86], ["más", 6.18], ["empinada", 6.46], ["para", 7.07], ["la", 7.32], ["costa", 7.46], ["oeste", 7.92], ["de", 8.43], ["Gran", 8.58], ["Bretaña", 8.9]]}, {"texto": "Ríchardson murió en mil novecientos cincuenta y tres, y su trabajo se publicó después, casi sin que nadie lo notara.", "fin": 8.14, "palabras": [["Ríchardson", 0.07], ["murió", 0.79], ["en", 1.22], ["mil", 1.35], ["novecientos", 1.58], ["cincuenta", 2.26], ["y", 2.72], ["tres", 2.81], ["y", 3.75], ["su", 3.82], ["trabajo", 3.99], ["se", 4.47], ["publicó", 4.64], ["después", 5.14], ["casi", 6.18], ["sin", 6.57], ["que", 6.85], ["nadie", 6.97], ["lo", 7.4], ["notara", 7.51]]}, {"texto": "Catorce años más tarde, Mandelbrót vio lo que escondía esa inclinación: de ella se obtiene la dimensión fractal de la línea.", "fin": 8.97, "palabras": [["Catorce", 0.1], ["años", 0.64], ["más", 1.01], ["tarde", 1.29], ["Mandelbrót", 2.15], ["vio", 2.78], ["lo", 3.04], ["que", 3.17], ["escondía", 3.28], ["esa", 3.97], ["inclinación", 4.22], ["de", 5.81], ["ella", 6.0], ["se", 6.32], ["obtiene", 6.5], ["la", 6.94], ["dimensión", 7.04], ["fractal", 7.68], ["de", 8.22], ["la", 8.33], ["línea", 8.44]]}, {"texto": "Para la frontera entre España y Portugal, Ríchardson obtuvo uno coma catorce. Con nuestros datos y nuestro método, obtenemos uno coma doce: un valor muy parecido, medido de otra forma.", "fin": 14.37, "palabras": [["Para", 0.1], ["la", 0.28], ["frontera", 0.4], ["entre", 0.92], ["España", 1.19], ["y", 1.71], ["Portugal", 1.78], ["Ríchardson", 3.11], ["obtuvo", 3.81], ["uno", 4.33], ["coma", 4.68], ["catorce", 5.01], ["Con", 6.18], ["nuestros", 6.35], ["datos", 6.81], ["y", 7.28], ["nuestro", 7.35], ["método", 7.74], ["obtenemos", 8.69], ["uno", 9.36], ["coma", 9.58], ["doce", 9.86], ["un", 10.97], ["valor", 11.12], ["muy", 11.49], ["parecido", 11.74], ["medido", 12.82], ["de", 13.32], ["otra", 13.49], ["forma", 13.81]]}, {"texto": "La del paralelo cuarenta y nueve se trazó en un tratado. La frontera entre España y Portugal, en cambio, sigue en buena parte el curso de cuatro ríos. Lo quebrado de esa línea no lo dibujó un tratado: lo dibujó el agua.", "fin": 16.26, "palabras": [["La", 0.08], ["del", 0.25], ["paralelo", 0.47], ["cuarenta", 1.01], ["y", 1.5], ["nueve", 1.57], ["se", 1.99], ["trazó", 2.21], ["en", 2.69], ["un", 2.86], ["tratado", 3.04], ["La", 4.18], ["frontera", 4.35], ["entre", 4.88], ["España", 5.15], ["y", 5.67], ["Portugal", 5.74], ["en", 6.83], ["cambio", 6.99], ["sigue", 7.94], ["en", 8.29], ["buena", 8.43], ["parte", 8.72], ["el", 9.14], ["curso", 9.31], ["de", 9.74], ["cuatro", 9.88], ["ríos", 10.29], ["Lo", 11.32], ["quebrado", 11.5], ["de", 12.01], ["esa", 12.22], ["línea", 12.49], ["no", 12.94], ["lo", 13.18], ["dibujó", 13.31], ["un", 13.81], ["tratado", 13.96], ["lo", 14.96], ["dibujó", 15.08], ["el", 15.64], ["agua", 15.79]]}, {"texto": "Pero llega un punto en que el mapa ya no tiene más detalle que ofrecernos, y la recta se aplana. Eso no dice que la frontera real se vuelva lisa: dice dónde termina nuestra información.", "fin": 13.14, "palabras": [["Pero", 0.1], ["llega", 0.31], ["un", 0.62], ["punto", 0.79], ["en", 1.22], ["que", 1.35], ["el", 1.46], ["mapa", 1.6], ["ya", 1.97], ["no", 2.18], ["tiene", 2.33], ["más", 2.65], ["detalle", 2.94], ["que", 3.47], ["ofrecernos", 3.6], ["y", 4.89], ["la", 4.97], ["recta", 5.15], ["se", 5.56], ["aplana", 5.72], ["Eso", 6.75], ["no", 7.06], ["dice", 7.24], ["que", 7.61], ["la", 7.74], ["frontera", 7.86], ["real", 8.42], ["se", 8.86], ["vuelva", 9.04], ["lisa", 9.42], ["dice", 10.65], ["dónde", 10.99], ["termina", 11.32], ["nuestra", 11.83], ["información", 12.24]]}, {"texto": "Y aunque pudiéramos acercarnos más, una frontera política no es una costa: está definida por acuerdos, coordenadas y accidentes geográficos. La regla sigue cambiando, pero también cambia aquello que estamos midiendo.", "fin": 16.19, "palabras": [["Y", 0.08], ["aunque", 0.21], ["pudiéramos", 0.51], ["acercarnos", 1.14], ["más", 1.86], ["una", 2.65], ["frontera", 2.85], ["política", 3.35], ["no", 4.0], ["es", 4.28], ["una", 4.43], ["costa", 4.64], ["está", 5.78], ["definida", 6.11], ["por", 6.74], ["acuerdos", 6.92], ["coordenadas", 7.92], ["y", 8.78], ["accidentes", 8.9], ["geográficos", 9.65], ["La", 11.04], ["regla", 11.24], ["sigue", 11.62], ["cambiando", 11.97], ["pero", 13.08], ["también", 13.33], ["cambia", 13.83], ["aquello", 14.26], ["que", 14.76], ["estamos", 14.92], ["midiendo", 15.49]]}, {"texto": "Por eso, cuando calculamos una dimensión a partir de datos reales, importa el rango de escalas en el que la relación se mantiene.", "fin": 8.85, "palabras": [["Por", 0.1], ["eso", 0.26], ["cuando", 1.03], ["calculamos", 1.33], ["una", 2.06], ["dimensión", 2.22], ["a", 2.81], ["partir", 2.88], ["de", 3.33], ["datos", 3.44], ["reales", 3.85], ["importa", 4.89], ["el", 5.46], ["rango", 5.61], ["de", 5.99], ["escalas", 6.11], ["en", 6.78], ["el", 6.96], ["que", 7.11], ["la", 7.24], ["relación", 7.36], ["se", 8.0], ["mantiene", 8.14]]}, {"texto": "Ríchardson buscaba medir las fronteras que separan a los países. Descubrió que una misma línea podía tener distintas longitudes, según cómo se midiera.", "fin": 11.21, "palabras": [["Ríchardson", 0.05], ["buscaba", 0.87], ["medir", 1.41], ["las", 1.84], ["fronteras", 2.02], ["que", 2.72], ["separan", 2.86], ["a", 3.44], ["los", 3.5], ["países", 3.72], ["Descubrió", 4.92], ["que", 5.54], ["una", 5.69], ["misma", 5.93], ["línea", 6.31], ["podía", 6.76], ["tener", 7.22], ["distintas", 7.61], ["longitudes", 8.31], ["según", 9.57], ["cómo", 10.1], ["se", 10.39], ["midiera", 10.56]]}, {"texto": "Medir también es decidir: elegir una regla es elegir una escala.", "fin": 5.06, "palabras": [["Medir", 0.08], ["también", 0.51], ["es", 0.97], ["decidir", 1.11], ["elegir", 2.43], ["una", 2.85], ["regla", 3.06], ["es", 3.6], ["elegir", 3.81], ["una", 4.25], ["escala", 4.43]]}, {"texto": "Pero medir una forma no es lo mismo que entender cómo llegó a existir. ¿Por qué se ramifica un río? ¿Por qué algunos minerales crecen como pequeños árboles? ¿Por qué ciertas redes de vasos se parecen a las que vemos desde el espacio?", "fin": 16.18, "palabras": [["Pero", 0.1], ["medir", 0.29], ["una", 0.62], ["forma", 0.82], ["no", 1.28], ["es", 1.54], ["lo", 1.71], ["mismo", 1.83], ["que", 2.28], ["entender", 2.43], ["cómo", 3.04], ["llegó", 3.33], ["a", 3.74], ["existir", 3.81], ["Por", 5.1], ["qué", 5.22], ["se", 5.39], ["ramifica", 5.56], ["un", 6.26], ["río", 6.46], ["Por", 7.47], ["qué", 7.58], ["algunos", 7.72], ["minerales", 8.24], ["crecen", 8.96], ["como", 9.44], ["pequeños", 9.72], ["árboles", 10.36], ["Por", 11.6], ["qué", 11.71], ["ciertas", 11.86], ["redes", 12.44], ["de", 12.82], ["vasos", 12.92], ["se", 13.42], ["parecen", 13.6], ["a", 14.15], ["las", 14.21], ["que", 14.42], ["vemos", 14.56], ["desde", 15.03], ["el", 15.35], ["espacio", 15.44]]}, {"texto": "Parecerse no significa tener el mismo origen. Para descubrirlo, hay que mirar cómo crecen.", "fin": 6.96, "palabras": [["Parecerse", 0.1], ["no", 0.74], ["significa", 0.92], ["tener", 1.65], ["el", 2.04], ["mismo", 2.21], ["origen", 2.62], ["Para", 3.72], ["descubrirlo", 3.92], ["hay", 5.25], ["que", 5.44], ["mirar", 5.6], ["cómo", 6.03], ["crecen", 6.31]]}]