[{"texto": "En mil seiscientos veintitrés, Galiléo escribió que el universo es un gran libro abierto ante nuestros ojos, y que está escrito en lengua matemática.", "fin": 9.89, "palabras": [["En", 0.08], ["mil", 0.24], ["seiscientos", 0.47], ["veintitrés", 1.14], ["Galiléo", 2.22], ["escribió", 2.76], ["que", 3.35], ["el", 3.5], ["universo", 3.62], ["es", 4.29], ["un", 4.46], ["gran", 4.61], ["libro", 4.9], ["abierto", 5.22], ["ante", 5.74], ["nuestros", 5.97], ["ojos", 6.43], ["y", 7.38], ["que", 7.49], ["está", 7.61], ["escrito", 7.89], ["en", 8.47], ["lengua", 8.62], ["matemática", 9.0]]}, {"texto": "Sus letras, decía, son triángulos, círculos y otras figuras geométricas. Sin ellas, uno da vueltas en vano por un oscuro laberinto.", "fin": 11.53, "palabras": [["Sus", 0.08], ["letras", 0.38], ["decía", 1.36], ["son", 2.44], ["triángulos", 2.74], ["círculos", 3.88], ["y", 4.65], ["otras", 4.81], ["figuras", 5.18], ["geométricas", 5.72], ["Sin", 7.12], ["ellas", 7.42], ["uno", 8.39], ["da", 8.61], ["vueltas", 8.74], ["en", 9.29], ["vano", 9.44], ["por", 9.82], ["un", 10.06], ["oscuro", 10.22], ["laberinto", 10.74]]}, {"texto": "En esta película, unas pocas reglas escritas con símbolos describieron fronteras, ríos, corazones, antenas y galaxias. ¿Por qué funciona describir el mundo con matemática? ¿Y dónde deja de funcionar?", "fin": 16.03, "palabras": [["En", 0.1], ["esta", 0.25], ["película", 0.51], ["unas", 1.58], ["pocas", 1.89], ["reglas", 2.28], ["escritas", 2.72], ["con", 3.33], ["símbolos", 3.54], ["describieron", 4.11], ["fronteras", 4.83], ["ríos", 6.18], ["corazones", 7.14], ["antenas", 8.31], ["y", 9.0], ["galaxias", 9.07], ["Por", 10.47], ["qué", 10.58], ["funciona", 10.74], ["describir", 11.38], ["el", 12.04], ["mundo", 12.21], ["con", 12.64], ["matemática", 12.83], ["Y", 14.26], ["dónde", 14.31], ["deja", 14.68], ["de", 15.04], ["funcionar", 15.18]]}, {"texto": "En mil novecientos sesenta, el físico Eugene Wígner escribió un ensayo sobre esta sorpresa. Dijo que la enorme utilidad de la matemática en las ciencias naturales roza lo misterioso, y que no tiene una explicación racional.", "fin": 15.68, "palabras": [["En", 0.1], ["mil", 0.25], ["novecientos", 0.47], ["sesenta", 1.11], ["el", 2.18], ["físico", 2.36], ["Eugene", 2.83], ["Wígner", 3.29], ["escribió", 3.81], ["un", 4.33], ["ensayo", 4.49], ["sobre", 5.07], ["esta", 5.49], ["sorpresa", 5.78], ["Dijo", 6.99], ["que", 7.38], ["la", 7.51], ["enorme", 7.62], ["utilidad", 8.06], ["de", 8.68], ["la", 8.79], ["matemática", 8.9], ["en", 9.72], ["las", 9.82], ["ciencias", 9.99], ["naturales", 10.46], ["roza", 11.22], ["lo", 11.64], ["misterioso", 11.76], ["y", 13.06], ["que", 13.17], ["no", 13.31], ["tiene", 13.5], ["una", 13.88], ["explicación", 14.1], ["racional", 14.96]]}, {"texto": "Y la llamó un regalo maravilloso, que no entendemos ni merecemos.", "fin": 4.69, "palabras": [["Y", 0.08], ["la", 0.18], ["llamó", 0.33], ["un", 0.68], ["regalo", 0.83], ["maravilloso", 1.31], ["que", 2.56], ["no", 2.69], ["entendemos", 2.9], ["ni", 3.69], ["merecemos", 3.81]]}, {"texto": "Pero en el mismo ensayo advirtió algo más. Las leyes de la naturaleza son de una precisión casi fantástica, y a la vez de un alcance estrictamente limitado.", "fin": 11.43, "palabras": [["Pero", 0.1], ["en", 0.32], ["el", 0.43], ["mismo", 0.58], ["ensayo", 0.93], ["advirtió", 1.57], ["algo", 2.26], ["más", 2.58], ["Las", 3.53], ["leyes", 3.81], ["de", 4.21], ["la", 4.31], ["naturaleza", 4.4], ["son", 5.19], ["de", 5.49], ["una", 5.6], ["precisión", 5.83], ["casi", 6.53], ["fantástica", 6.89], ["y", 8.29], ["a", 8.39], ["la", 8.46], ["vez", 8.57], ["de", 8.83], ["un", 8.94], ["alcance", 9.11], ["estrictamente", 9.72], ["limitado", 10.68]]}, {"texto": "Hay varias maneras de responder por qué funciona. Para algunos, la matemática descubre estructuras que existen sin nosotros. Para otros, es un lenguaje que inventamos. Y para otros, estudia relaciones, sin importar de qué están hechas las cosas.", "fin": 19.07, "palabras": [["Hay", 0.08], ["varias", 0.31], ["maneras", 0.72], ["de", 1.24], ["responder", 1.33], ["por", 2.07], ["qué", 2.32], ["funciona", 2.47], ["Para", 3.71], ["algunos", 3.92], ["la", 4.99], ["matemática", 5.11], ["descubre", 5.83], ["estructuras", 6.4], ["que", 7.22], ["existen", 7.36], ["sin", 8.01], ["nosotros", 8.22], ["Para", 9.49], ["otros", 9.75], ["es", 10.74], ["un", 10.93], ["lenguaje", 11.06], ["que", 11.65], ["inventamos", 11.79], ["Y", 13.15], ["para", 13.25], ["otros", 13.58], ["estudia", 14.49], ["relaciones", 15.0], ["sin", 16.26], ["importar", 16.53], ["de", 17.15], ["qué", 17.28], ["están", 17.42], ["hechas", 17.82], ["las", 18.19], ["cosas", 18.42]]}, {"texto": "El debate sigue abierto, y no vamos a cerrarlo aquí. Pero lo que vimos en esta película muestra dos caras de la misma moneda.", "fin": 8.93, "palabras": [["El", 0.08], ["debate", 0.25], ["sigue", 0.71], ["abierto", 1.06], ["y", 2.1], ["no", 2.19], ["vamos", 2.4], ["a", 2.85], ["cerrarlo", 2.92], ["aquí", 3.51], ["Pero", 4.39], ["lo", 4.6], ["que", 4.74], ["vimos", 4.88], ["en", 5.32], ["esta", 5.46], ["película", 5.75], ["muestra", 6.38], ["dos", 6.92], ["caras", 7.26], ["de", 7.68], ["la", 7.78], ["misma", 7.9], ["moneda", 8.32]]}, {"texto": "Nadie eligió la forma del conjunto de Mandelbrot. Aparece sola, cuando se sigue la regla hasta el final.", "fin": 7.76, "palabras": [["Nadie", 0.07], ["eligió", 0.58], ["la", 1.07], ["forma", 1.22], ["del", 1.64], ["conjunto", 1.86], ["de", 2.53], ["Mandelbrot", 2.65], ["Aparece", 3.94], ["sola", 4.47], ["cuando", 5.32], ["se", 5.64], ["sigue", 5.81], ["la", 6.17], ["regla", 6.32], ["hasta", 6.82], ["el", 7.1], ["final", 7.21]]}, {"texto": "En cambio, el largo de una frontera dependía de la regla con que la medíamos. Una parte de la descripción la encontramos, y otra parte la ponemos nosotros.", "fin": 11.33, "palabras": [["En", 0.08], ["cambio", 0.29], ["el", 1.28], ["largo", 1.46], ["de", 1.83], ["una", 1.97], ["frontera", 2.21], ["dependía", 2.76], ["de", 3.39], ["la", 3.51], ["regla", 3.67], ["con", 4.14], ["que", 4.39], ["la", 4.5], ["medíamos", 4.61], ["Una", 5.89], ["parte", 6.12], ["de", 6.53], ["la", 6.65], ["descripción", 6.75], ["la", 7.53], ["encontramos", 7.61], ["y", 9.0], ["otra", 9.12], ["parte", 9.42], ["la", 9.83], ["ponemos", 9.97], ["nosotros", 10.5]]}, {"texto": "Si ponemos cada ley de esta película sobre una sola escala, ninguna la cubre entera. La antena funciona entre menos de un centímetro y once. La frontera, entre cinco y ochenta kilómetros. Las galaxias se agrupan hasta unos cien megapársecs.", "fin": 18.68, "palabras": [["Si", 0.08], ["ponemos", 0.31], ["cada", 0.81], ["ley", 1.1], ["de", 1.4], ["esta", 1.6], ["película", 1.88], ["sobre", 2.49], ["una", 2.85], ["sola", 3.08], ["escala", 3.4], ["ninguna", 4.51], ["la", 4.99], ["cubre", 5.14], ["entera", 5.53], ["La", 6.56], ["antena", 6.72], ["funciona", 7.14], ["entre", 7.83], ["menos", 8.11], ["de", 8.56], ["un", 8.69], ["centímetro", 8.9], ["y", 9.76], ["once", 9.92], ["La", 10.88], ["frontera", 11.07], ["entre", 12.18], ["cinco", 12.54], ["y", 13.06], ["ochenta", 13.18], ["kilómetros", 13.72], ["Las", 15.08], ["galaxias", 15.32], ["se", 15.99], ["agrupan", 16.11], ["hasta", 16.67], ["unos", 17.01], ["cien", 17.38], ["megapársecs", 17.68]]}, {"texto": "Y el corazón, en el tiempo, guarda su estructura entre unos minutos y unas horas. Solo en la matemática el detalle sigue sin fin.", "fin": 9.96, "palabras": [["Y", 0.08], ["el", 0.21], ["corazón", 0.36], ["en", 1.36], ["el", 1.47], ["tiempo", 1.64], ["guarda", 2.65], ["su", 3.03], ["estructura", 3.18], ["entre", 3.9], ["unos", 4.21], ["minutos", 4.56], ["y", 5.25], ["unas", 5.39], ["horas", 5.75], ["Solo", 6.71], ["en", 7.12], ["la", 7.21], ["matemática", 7.31], ["el", 8.12], ["detalle", 8.25], ["sigue", 8.83], ["sin", 9.25], ["fin", 9.51]]}, {"texto": "Ninguna de las bandas marca un límite de la naturaleza. Cada una marca hasta dónde la evidencia respalda cada descripción. Más allá de sus bordes, cada ley se vuelve una pregunta.", "fin": 13.4, "palabras": [["Ninguna", 0.07], ["de", 0.6], ["las", 0.72], ["bandas", 0.93], ["marca", 1.44], ["un", 1.89], ["límite", 2.1], ["de", 2.6], ["la", 2.74], ["naturaleza", 2.85], ["Cada", 4.22], ["una", 4.51], ["marca", 4.75], ["hasta", 5.25], ["dónde", 5.57], ["la", 5.9], ["evidencia", 6.03], ["respalda", 6.68], ["cada", 7.35], ["descripción", 7.75], ["Más", 9.12], ["allá", 9.46], ["de", 9.75], ["sus", 9.88], ["bordes", 10.12], ["cada", 11.11], ["ley", 11.42], ["se", 11.74], ["vuelve", 11.93], ["una", 12.38], ["pregunta", 12.65]]}, {"texto": "Toda descripción tiene una frontera. ¿Qué significa, entonces, conocer desde ella?", "fin": 7.15, "palabras": [["Toda", 0.08], ["descripción", 0.36], ["tiene", 1.25], ["una", 1.62], ["frontera", 1.88], ["Qué", 3.11], ["significa", 3.17], ["entonces", 4.44], ["conocer", 5.72], ["desde", 6.29], ["ella", 6.69]]}]