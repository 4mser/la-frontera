[{"texto": "Hemos llegado hasta aquí siguiendo una regla, una regla capaz de producir formas que nunca terminamos de recorrer.", "fin": 7.62, "palabras": [["Hemos", 0.08], ["llegado", 0.4], ["hasta", 0.9], ["aquí", 1.17], ["siguiendo", 1.46], ["una", 2.03], ["regla", 2.26], ["una", 3.26], ["regla", 3.5], ["capaz", 3.86], ["de", 4.31], ["producir", 4.42], ["formas", 4.97], ["que", 5.51], ["nunca", 5.65], ["terminamos", 6.08], ["de", 6.85], ["recorrer", 6.94]]}, {"texto": "Y, sin embargo, todo este viaje ha ocurrido también en otro lugar: en la mirada de alguien.", "fin": 7.15, "palabras": [["Y", 0.08], ["sin", 0.69], ["embargo", 0.94], ["todo", 1.97], ["este", 2.28], ["viaje", 2.56], ["ha", 3.01], ["ocurrido", 3.1], ["también", 3.69], ["en", 4.18], ["otro", 4.35], ["lugar", 4.62], ["en", 5.64], ["la", 5.76], ["mirada", 5.88], ["de", 6.36], ["alguien", 6.56]]}, {"texto": "Empezamos con una operación matemática, y terminamos encontrándola en lugares que jamás habríamos imaginado.", "fin": 7.64, "palabras": [["Empezamos", 0.08], ["con", 0.78], ["una", 0.97], ["operación", 1.19], ["matemática", 1.78], ["y", 3.1], ["terminamos", 3.21], ["encontrándola", 3.92], ["en", 4.79], ["lugares", 4.89], ["que", 5.46], ["jamás", 5.6], ["habríamos", 6.15], ["imaginado", 6.82]]}, {"texto": "Descubrimos que una curva puede tener una longitud infinita y encerrar un área finita.", "fin": 5.89, "palabras": [["Descubrimos", 0.07], ["que", 0.83], ["una", 0.96], ["curva", 1.21], ["puede", 1.68], ["tener", 2.03], ["una", 2.36], ["longitud", 2.56], ["infinita", 3.17], ["y", 3.96], ["encerrar", 4.12], ["un", 4.69], ["área", 4.89], ["finita", 5.22]]}, {"texto": "Que una frontera puede cambiar con la escala desde la que la medimos.", "fin": 4.22, "palabras": [["Que", 0.08], ["una", 0.21], ["frontera", 0.46], ["puede", 1.07], ["cambiar", 1.39], ["con", 1.93], ["la", 2.12], ["escala", 2.21], ["desde", 2.74], ["la", 3.1], ["que", 3.22], ["la", 3.36], ["medimos", 3.47]]}, {"texto": "Que la complejidad puede surgir de reglas sencillas.", "fin": 3.57, "palabras": [["Que", 0.08], ["la", 0.19], ["complejidad", 0.32], ["puede", 1.17], ["surgir", 1.49], ["de", 2.04], ["reglas", 2.18], ["sencillas", 2.68]]}, {"texto": "Que incluso el caos tiene su propia estructura.", "fin": 3.17, "palabras": [["Que", 0.08], ["incluso", 0.19], ["el", 0.78], ["caos", 0.93], ["tiene", 1.43], ["su", 1.72], ["propia", 1.9], ["estructura", 2.33]]}, {"texto": "Que una forma puede ayudarnos a construir una antena, comprender un tejido o describir el ritmo de un corazón.", "fin": 7.62, "palabras": [["Que", 0.08], ["una", 0.21], ["forma", 0.46], ["puede", 0.92], ["ayudarnos", 1.22], ["a", 1.93], ["construir", 2.0], ["una", 2.67], ["antena", 2.86], ["comprender", 3.83], ["un", 4.4], ["tejido", 4.54], ["o", 5.19], ["describir", 5.32], ["el", 5.96], ["ritmo", 6.14], ["de", 6.58], ["un", 6.74], ["corazón", 6.93]]}, {"texto": "Y que incluso las estructuras más inmensas del universo tienen un alcance que podemos medir.", "fin": 6.11, "palabras": [["Y", 0.08], ["que", 0.19], ["incluso", 0.33], ["las", 0.89], ["estructuras", 1.11], ["más", 1.9], ["inmensas", 2.22], ["del", 2.81], ["universo", 2.97], ["tienen", 3.62], ["un", 4.06], ["alcance", 4.21], ["que", 4.83], ["podemos", 5.0], ["medir", 5.58]]}, {"texto": "Y hay algo que atraviesa todos estos descubrimientos.", "fin": 3.74, "palabras": [["Y", 0.08], ["hay", 0.22], ["algo", 0.44], ["que", 0.79], ["atraviesa", 0.93], ["todos", 1.62], ["estos", 2.18], ["descubrimientos", 2.57]]}, {"texto": "Cada vez que encontramos una regla, encontramos también el lugar donde podemos ponerla a prueba.", "fin": 6.54, "palabras": [["Cada", 0.08], ["vez", 0.36], ["que", 0.67], ["encontramos", 0.79], ["una", 1.57], ["regla", 1.78], ["encontramos", 2.71], ["también", 3.49], ["el", 3.92], ["lugar", 4.04], ["donde", 4.46], ["podemos", 4.76], ["ponerla", 5.33], ["a", 5.93], ["prueba", 6.0]]}, {"texto": "La geometría de una costa depende de la escala. La variabilidad de un corazón se estudia a través del tiempo. La red de galaxias tiene una estructura que, a escalas mayores, se vuelve homogénea.", "fin": 14.78, "palabras": [["La", 0.08], ["geometría", 0.25], ["de", 0.96], ["una", 1.11], ["costa", 1.38], ["depende", 1.82], ["de", 2.42], ["la", 2.56], ["escala", 2.65], ["La", 3.72], ["variabilidad", 3.9], ["de", 4.75], ["un", 4.89], ["corazón", 5.06], ["se", 5.69], ["estudia", 5.86], ["a", 6.54], ["través", 6.67], ["del", 7.12], ["tiempo", 7.33], ["La", 8.35], ["red", 8.54], ["de", 8.78], ["galaxias", 8.88], ["tiene", 9.61], ["una", 9.9], ["estructura", 10.1], ["que", 10.82], ["a", 11.64], ["escalas", 11.76], ["mayores", 12.33], ["se", 13.31], ["vuelve", 13.54], ["homogénea", 13.99]]}, {"texto": "Cada descripción ilumina una parte del mundo, y cada una nos obliga a preguntar hasta dónde podemos confiar en ella.", "fin": 7.93, "palabras": [["Cada", 0.08], ["descripción", 0.33], ["ilumina", 1.12], ["una", 1.69], ["parte", 1.94], ["del", 2.35], ["mundo", 2.56], ["y", 3.47], ["cada", 3.58], ["una", 3.92], ["nos", 4.15], ["obliga", 4.39], ["a", 4.85], ["preguntar", 4.92], ["hasta", 5.6], ["dónde", 5.9], ["podemos", 6.22], ["confiar", 6.78], ["en", 7.32], ["ella", 7.47]]}, {"texto": "La matemática, en cambio, puede llevar una regla mucho más lejos de lo que cualquier instrumento puede acompañarla.", "fin": 8.01, "palabras": [["La", 0.08], ["matemática", 0.25], ["en", 1.42], ["cambio", 1.62], ["puede", 2.6], ["llevar", 2.88], ["una", 3.25], ["regla", 3.46], ["mucho", 3.88], ["más", 4.28], ["lejos", 4.58], ["de", 5.04], ["lo", 5.14], ["que", 5.26], ["cualquier", 5.4], ["instrumento", 5.88], ["puede", 6.67], ["acompañarla", 7.04]]}, {"texto": "Ahí aparece una diferencia extraordinaria. Podemos imaginar estructuras que todavía no sabemos observar, y demostrar propiedades que ninguna medición ha alcanzado.", "fin": 11.92, "palabras": [["Ahí", 0.08], ["aparece", 0.39], ["una", 1.03], ["diferencia", 1.28], ["extraordinaria", 2.04], ["Podemos", 3.67], ["imaginar", 4.15], ["estructuras", 4.71], ["que", 5.5], ["todavía", 5.65], ["no", 6.21], ["sabemos", 6.43], ["observar", 6.97], ["y", 8.22], ["demostrar", 8.28], ["propiedades", 8.92], ["que", 9.71], ["ninguna", 9.83], ["medición", 10.33], ["ha", 10.99], ["alcanzado", 11.1]]}, {"texto": "Y podemos descubrir que una idea perfectamente definida contiene una complejidad que supera nuestra capacidad de recorrerla.", "fin": 8.06, "palabras": [["Y", 0.06], ["podemos", 0.18], ["descubrir", 0.68], ["que", 1.33], ["una", 1.5], ["idea", 1.74], ["perfectamente", 2.14], ["definida", 3.07], ["contiene", 3.71], ["una", 4.25], ["complejidad", 4.49], ["que", 5.33], ["supera", 5.47], ["nuestra", 5.96], ["capacidad", 6.38], ["de", 7.08], ["recorrerla", 7.19]]}, {"texto": "Quizá una de las cosas más sorprendentes de la realidad sea precisamente esa. Que podamos descubrir algunas de sus reglas, que esas reglas permitan predecir, construir y comprender, y que, incluso cuando funcionan, siempre quede algo por investigar.", "fin": 17.97, "palabras": [["Quizá", 0.08], ["una", 0.42], ["de", 0.64], ["las", 0.76], ["cosas", 0.97], ["más", 1.43], ["sorprendentes", 1.69], ["de", 2.54], ["la", 2.64], ["realidad", 2.76], ["sea", 3.4], ["precisamente", 3.75], ["esa", 4.78], ["Que", 5.65], ["podamos", 5.76], ["descubrir", 6.25], ["algunas", 6.83], ["de", 7.32], ["sus", 7.42], ["reglas", 7.64], ["que", 8.57], ["esas", 8.74], ["reglas", 9.07], ["permitan", 9.56], ["predecir", 10.08], ["construir", 11.07], ["y", 11.75], ["comprender", 11.82], ["y", 13.14], ["que", 13.22], ["incluso", 13.86], ["cuando", 14.43], ["funcionan", 14.74], ["siempre", 15.83], ["quede", 16.29], ["algo", 16.65], ["por", 17.0], ["investigar", 17.19]]}, {"texto": "Hubo un tiempo en que el cielo era apenas un conjunto de luces.", "fin": 4.22, "palabras": [["Hubo", 0.08], ["un", 0.33], ["tiempo", 0.51], ["en", 0.97], ["que", 1.11], ["el", 1.24], ["cielo", 1.38], ["era", 1.88], ["apenas", 2.11], ["un", 2.65], ["conjunto", 2.81], ["de", 3.44], ["luces", 3.57]]}, {"texto": "Hoy podemos reconstruir galaxias que existieron hace miles de millones de años, y medir la expansión del universo.", "fin": 7.81, "palabras": [["Hoy", 0.08], ["podemos", 0.29], ["reconstruir", 0.82], ["galaxias", 1.56], ["que", 2.29], ["existieron", 2.42], ["hace", 3.15], ["miles", 3.4], ["de", 3.81], ["millones", 3.9], ["de", 4.46], ["años", 4.58], ["y", 5.56], ["medir", 5.65], ["la", 6.07], ["expansión", 6.17], ["del", 6.92], ["universo", 7.08]]}, {"texto": "Podemos estudiar el ritmo de una célula, seguir la trayectoria de una partícula y calcular la forma de una frontera que contiene infinitos detalles.", "fin": 9.92, "palabras": [["Podemos", 0.1], ["estudiar", 0.57], ["el", 1.11], ["ritmo", 1.26], ["de", 1.68], ["una", 1.82], ["célula", 2.06], ["seguir", 3.06], ["la", 3.46], ["trayectoria", 3.57], ["de", 4.32], ["una", 4.46], ["partícula", 4.69], ["y", 5.46], ["calcular", 5.56], ["la", 6.18], ["forma", 6.32], ["de", 6.72], ["una", 6.86], ["frontera", 7.11], ["que", 7.69], ["contiene", 7.86], ["infinitos", 8.4], ["detalles", 9.14]]}, {"texto": "Todo eso ocurrió en un planeta pequeño, alrededor de una estrella común.", "fin": 5.33, "palabras": [["Todo", 0.1], ["eso", 0.42], ["ocurrió", 0.74], ["en", 1.29], ["un", 1.42], ["planeta", 1.57], ["pequeño", 2.07], ["alrededor", 3.11], ["de", 3.82], ["una", 3.96], ["estrella", 4.21], ["común", 4.76]]}, {"texto": "Y en algún momento de su historia, la materia empezó a organizarse de una manera capaz de hacer preguntas.", "fin": 7.17, "palabras": [["Y", 0.08], ["en", 0.21], ["algún", 0.35], ["momento", 0.67], ["de", 1.18], ["su", 1.31], ["historia", 1.44], ["la", 2.54], ["materia", 2.64], ["empezó", 3.14], ["a", 3.64], ["organizarse", 3.69], ["de", 4.54], ["una", 4.71], ["manera", 4.94], ["capaz", 5.39], ["de", 5.9], ["hacer", 6.0], ["preguntas", 6.35]]}, {"texto": "Los elementos que forman nuestros cuerpos tienen una historia mucho más antigua que nosotros, y muchos de ellos se forjaron en estrellas.", "fin": 8.87, "palabras": [["Los", 0.08], ["elementos", 0.32], ["que", 0.89], ["forman", 1.01], ["nuestros", 1.44], ["cuerpos", 1.88], ["tienen", 2.43], ["una", 2.78], ["historia", 2.94], ["mucho", 3.47], ["más", 3.88], ["antigua", 4.15], ["que", 4.67], ["nosotros", 4.81], ["y", 6.07], ["muchos", 6.17], ["de", 6.61], ["ellos", 6.82], ["se", 7.19], ["forjaron", 7.33], ["en", 7.96], ["estrellas", 8.07]]}, {"texto": "La materia que hoy forma nuestros ojos, nuestras manos y nuestro corazón pertenece a esa misma historia cósmica.", "fin": 7.99, "palabras": [["La", 0.08], ["materia", 0.25], ["que", 0.78], ["hoy", 0.99], ["forma", 1.18], ["nuestros", 1.58], ["ojos", 2.08], ["nuestras", 3.03], ["manos", 3.47], ["y", 3.99], ["nuestro", 4.07], ["corazón", 4.44], ["pertenece", 5.04], ["a", 5.78], ["esa", 5.94], ["misma", 6.22], ["historia", 6.65], ["cósmica", 7.22]]}, {"texto": "Y ahora, después de miles de millones de años de transformaciones, existe aquí algo capaz de contemplar las estrellas y preguntarse qué son.", "fin": 9.68, "palabras": [["Y", 0.08], ["ahora", 0.22], ["después", 1.12], ["de", 1.56], ["miles", 1.65], ["de", 2.01], ["millones", 2.11], ["de", 2.65], ["años", 2.79], ["de", 3.15], ["transformaciones", 3.26], ["existe", 4.86], ["aquí", 5.39], ["algo", 5.74], ["capaz", 6.04], ["de", 6.46], ["contemplar", 6.57], ["las", 7.25], ["estrellas", 7.46], ["y", 8.18], ["preguntarse", 8.28], ["qué", 9.08], ["son", 9.22]]}, {"texto": "El universo existía mucho antes de que pudiéramos mirarlo, y seguirá existiendo después.", "fin": 6.35, "palabras": [["El", 0.08], ["universo", 0.25], ["existía", 0.82], ["mucho", 1.43], ["antes", 1.89], ["de", 2.31], ["que", 2.42], ["pudiéramos", 2.57], ["mirarlo", 3.24], ["y", 4.21], ["seguirá", 4.29], ["existiendo", 4.82], ["después", 5.62]]}, {"texto": "Nuestra vida ocupa apenas un instante dentro de su historia. Pero durante ese instante podemos hacer algo extraordinario.", "fin": 8.6, "palabras": [["Nuestra", 0.07], ["vida", 0.49], ["ocupa", 0.81], ["apenas", 1.32], ["un", 1.86], ["instante", 2.0], ["dentro", 2.69], ["de", 3.14], ["su", 3.26], ["historia", 3.42], ["Pero", 4.56], ["durante", 4.78], ["ese", 5.29], ["instante", 5.54], ["podemos", 6.19], ["hacer", 6.75], ["algo", 7.1], ["extraordinario", 7.43]]}, {"texto": "Podemos mirar una costa y descubrir una geometría. Escuchar un corazón y encontrar una estructura en su ritmo.", "fin": 8.01, "palabras": [["Podemos", 0.1], ["mirar", 0.58], ["una", 0.93], ["costa", 1.15], ["y", 1.75], ["descubrir", 1.86], ["una", 2.5], ["geometría", 2.75], ["Escuchar", 4.06], ["un", 4.62], ["corazón", 4.75], ["y", 5.42], ["encontrar", 5.57], ["una", 6.22], ["estructura", 6.42], ["en", 7.17], ["su", 7.28], ["ritmo", 7.43]]}, {"texto": "Observar las galaxias y reconstruir una historia que comenzó mucho antes de que existiéramos.", "fin": 6.28, "palabras": [["Observar", 0.08], ["las", 0.68], ["galaxias", 0.86], ["y", 1.65], ["reconstruir", 1.78], ["una", 2.54], ["historia", 2.71], ["que", 3.31], ["comenzó", 3.47], ["mucho", 4.0], ["antes", 4.51], ["de", 4.94], ["que", 5.07], ["existiéramos", 5.22]]}, {"texto": "Podemos preguntarnos qué hay más allá de lo que conocemos, y seguir buscando.", "fin": 5.42, "palabras": [["Podemos", 0.1], ["preguntarnos", 0.57], ["qué", 1.46], ["hay", 1.61], ["más", 1.79], ["allá", 2.11], ["de", 2.43], ["lo", 2.57], ["que", 2.69], ["conocemos", 2.83], ["y", 4.12], ["seguir", 4.21], ["buscando", 4.65]]}, {"texto": "Y a veces, la respuesta empieza muy cerca, en las cosas más sencillas.", "fin": 5.57, "palabras": [["Y", 0.08], ["a", 0.21], ["veces", 0.29], ["la", 1.25], ["respuesta", 1.39], ["empieza", 1.96], ["muy", 2.44], ["cerca", 2.67], ["en", 3.6], ["las", 3.75], ["cosas", 3.96], ["más", 4.42], ["sencillas", 4.69]]}, {"texto": "En una flor que ordena sus semillas en espirales.", "fin": 3.4, "palabras": [["En", 0.1], ["una", 0.25], ["flor", 0.47], ["que", 0.88], ["ordena", 1.03], ["sus", 1.49], ["semillas", 1.71], ["en", 2.35], ["espirales", 2.47]]}, {"texto": "En un árbol que repite su forma en cada una de sus ramas.", "fin": 3.97, "palabras": [["En", 0.08], ["un", 0.25], ["árbol", 0.42], ["que", 0.83], ["repite", 0.97], ["su", 1.44], ["forma", 1.62], ["en", 2.11], ["cada", 2.29], ["una", 2.67], ["de", 2.96], ["sus", 3.1], ["ramas", 3.36]]}, {"texto": "En un rayo que encuentra su camino en una fracción de segundo.", "fin": 4.24, "palabras": [["En", 0.08], ["un", 0.25], ["rayo", 0.44], ["que", 0.92], ["encuentra", 1.07], ["su", 1.62], ["camino", 1.79], ["en", 2.39], ["una", 2.62], ["fracción", 2.85], ["de", 3.42], ["segundo", 3.53]]}, {"texto": "En la escarcha de una ventana, en las hojas de un helecho, en las nervaduras de una hoja.", "fin": 6.4, "palabras": [["En", 0.1], ["la", 0.25], ["escarcha", 0.33], ["de", 0.9], ["una", 1.06], ["ventana", 1.29], ["en", 2.32], ["las", 2.47], ["hojas", 2.71], ["de", 3.06], ["un", 3.18], ["helecho", 3.36], ["en", 4.33], ["las", 4.5], ["nervaduras", 4.69], ["de", 5.44], ["una", 5.58], ["hoja", 5.93]]}, {"texto": "Formas que se repiten a distintas escalas, cada una con más detalle del que alcanzamos a ver.", "fin": 6.47, "palabras": [["Formas", 0.08], ["que", 0.58], ["se", 0.71], ["repiten", 0.86], ["a", 1.42], ["distintas", 1.47], ["escalas", 2.15], ["cada", 3.26], ["una", 3.57], ["con", 3.83], ["más", 4.07], ["detalle", 4.35], ["del", 4.89], ["que", 5.1], ["alcanzamos", 5.22], ["a", 6.03], ["ver", 6.1]]}, {"texto": "Quizá eso sea lo más extraordinario de todo: que seamos parte de un universo inmenso, y que podamos contemplarlo hasta en su detalle más pequeño.", "fin": 9.93, "palabras": [["Quizá", 0.08], ["eso", 0.49], ["sea", 0.72], ["lo", 1.03], ["más", 1.17], ["extraordinario", 1.47], ["de", 2.47], ["todo", 2.62], ["que", 3.4], ["seamos", 3.53], ["parte", 4.03], ["de", 4.4], ["un", 4.54], ["universo", 4.71], ["inmenso", 5.24], ["y", 6.24], ["que", 6.33], ["podamos", 6.49], ["contemplarlo", 6.97], ["hasta", 7.82], ["en", 8.1], ["su", 8.21], ["detalle", 8.35], ["más", 8.9], ["pequeño", 9.28]]}]