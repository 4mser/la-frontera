[{"texto": "Hay algo profundamente extraño en estar vivos.", "fin": 3.3, "palabras": [["Hay", 0.06], ["algo", 0.11], ["profundamente", 0.17], ["extraño", 1.36], ["en", 2.03], ["estar", 2.15], ["vivos", 2.47]]}, {"texto": "Detente un segundo.", "fin": 1.29, "palabras": [["Detente", 0.06], ["un", 0.39], ["segundo", 0.64]]}, {"texto": "Estás aquí, consciente.", "fin": 1.96, "palabras": [["Estás", 0.06], ["aquí", 0.25], ["consciente", 1.31]]}, {"texto": "En un pequeño rincón del universo, sobre una roca que gira alrededor de una estrella, en medio de miles de millones de galaxias.", "fin": 8.23, "palabras": [["En", 0.06], ["un", 0.11], ["pequeño", 0.16], ["rincón", 0.41], ["del", 0.89], ["universo", 1.13], ["sobre", 1.95], ["una", 2.31], ["roca", 2.52], ["que", 2.8], ["gira", 3.08], ["alrededor", 3.29], ["de", 3.94], ["una", 4.08], ["estrella", 4.29], ["en", 5.19], ["medio", 5.74], ["de", 5.8], ["miles", 5.97], ["de", 6.41], ["millones", 6.58], ["de", 7.28], ["galaxias", 7.51]]}, {"texto": "Y puedes darte cuenta.", "fin": 1.75, "palabras": [["Y", 0.06], ["puedes", 0.11], ["darte", 0.48], ["cuenta", 1.19]]}, {"texto": "Puedes mirar al cielo y preguntarte qué es todo esto.", "fin": 3.84, "palabras": [["Puedes", 0.06], ["mirar", 0.19], ["al", 0.74], ["cielo", 0.96], ["y", 1.52], ["preguntarte", 1.64], ["qué", 2.22], ["es", 2.56], ["todo", 2.77], ["esto", 3.08]]}, {"texto": "Puedes escuchar una canción y sentir algo que ni siquiera sabes explicar.", "fin": 4.47, "palabras": [["Puedes", 0.06], ["escuchar", 0.11], ["una", 0.67], ["canción", 0.92], ["y", 1.53], ["sentir", 1.89], ["algo", 2.39], ["que", 2.72], ["ni", 2.93], ["siquiera", 3.06], ["sabes", 3.6], ["explicar", 3.94]]}, {"texto": "Durante siglos hemos buscado un propósito.", "fin": 2.94, "palabras": [["Durante", 0.06], ["siglos", 0.23], ["hemos", 0.83], ["buscado", 1.33], ["un", 2.03], ["propósito", 2.23]]}, {"texto": "Una razón.", "fin": 0.77, "palabras": [["Una", 0.06], ["razón", 0.11]]}, {"texto": "Una respuesta que justifique nuestra existencia.", "fin": 3.29, "palabras": [["Una", 0.06], ["respuesta", 0.11], ["que", 0.79], ["justifique", 1.1], ["nuestra", 2.19], ["existencia", 2.74]]}, {"texto": "Pero ¿y si no hubiera ninguna?", "fin": 2.26, "palabras": [["Pero", 0.08], ["¿y", 0.17], ["si", 0.46], ["no", 0.51], ["hubiera", 0.73], ["ninguna?", 1.23]]}, {"texto": "¿Y si el universo no estuviera hecho para nosotros?", "fin": 3.86, "palabras": [["¿Y", 0.06], ["si", 0.11], ["el", 0.16], ["universo", 0.28], ["no", 1.49], ["estuviera", 1.67], ["hecho", 2.5], ["para", 2.96], ["nosotros?", 3.33]]}, {"texto": "¿Y si no hubiera un significado escrito en alguna parte?", "fin": 3.33, "palabras": [["¿Y", 0.06], ["si", 0.11], ["no", 0.16], ["hubiera", 0.21], ["un", 0.5], ["significado", 0.65], ["escrito", 1.53], ["en", 2.04], ["alguna", 2.18], ["parte?", 2.61]]}, {"texto": "No creo que eso lo haga menos extraordinario.", "fin": 2.89, "palabras": [["No", 0.06], ["creo", 0.11], ["que", 0.16], ["eso", 0.25], ["lo", 0.54], ["haga", 0.65], ["menos", 0.97], ["extraordinario", 1.37]]}, {"texto": "Al contrario.", "fin": 0.9, "palabras": [["Al", 0.06], ["contrario", 0.11]]}, {"texto": "Piensa en todo lo que tuvo que ocurrir para que, durante un instante diminuto de la historia cósmica, la materia pudiera organizarse, respirar, sentir, amar y preguntarse por sí misma.", "fin": 14.37, "palabras": [["Piensa", 0.06], ["en", 0.11], ["todo", 0.22], ["lo", 0.57], ["que", 0.74], ["tuvo", 1.0], ["que", 1.35], ["ocurrir", 1.61], ["para", 2.38], ["que", 2.81], ["durante", 3.26], ["un", 3.53], ["instante", 3.67], ["diminuto", 4.25], ["de", 4.77], ["la", 4.99], ["historia", 5.09], ["cósmica", 5.41], ["la", 6.38], ["materia", 6.75], ["pudiera", 7.04], ["organizarse", 7.68], ["respirar", 9.12], ["sentir", 10.39], ["amar", 11.6], ["y", 12.58], ["preguntarse", 13.22], ["por", 13.86], ["sí", 14.08], ["misma", 14.23]]}, {"texto": "Somos parte de ese universo intentando comprenderse.", "fin": 3.12, "palabras": [["Somos", 0.06], ["parte", 0.11], ["de", 0.4], ["ese", 0.57], ["universo", 0.83], ["intentando", 1.56], ["comprenderse", 2.4]]}, {"texto": "Y cuanto más aprendemos sobre él, más increíble parece.", "fin": 4.76, "palabras": [["Y", 0.06], ["cuanto", 0.11], ["más", 0.31], ["aprendemos", 0.72], ["sobre", 1.75], ["él", 2.3], ["más", 2.56], ["increíble", 3.11], ["parece", 3.72]]}, {"texto": "Descubrir que una flor sigue reglas matemáticas no la hace menos hermosa.", "fin": 4.79, "palabras": [["Descubrir", 0.06], ["que", 0.46], ["una", 0.77], ["flor", 1.09], ["sigue", 1.53], ["reglas", 1.87], ["matemáticas", 2.29], ["no", 3.09], ["la", 3.23], ["hace", 3.43], ["menos", 3.83], ["hermosa", 4.33]]}, {"texto": "Entender las estrellas no apaga su luz.", "fin": 2.86, "palabras": [["Entender", 0.06], ["las", 0.33], ["estrellas", 0.62], ["no", 1.52], ["apaga", 1.88], ["su", 2.44], ["luz", 2.7]]}, {"texto": "Encontrar una explicación no destruye el misterio.", "fin": 3.22, "palabras": [["Encontrar", 0.06], ["una", 0.31], ["explicación", 0.57], ["no", 1.57], ["destruye", 1.93], ["el", 2.61], ["misterio", 2.78]]}, {"texto": "A veces, lo multiplica.", "fin": 2.0, "palabras": [["A", 0.06], ["veces", 0.11], ["lo", 0.59], ["multiplica", 0.64]]}, {"texto": "Quizás no estamos aquí para cumplir un propósito.", "fin": 3.2, "palabras": [["Quizás", 0.06], ["no", 0.17], ["estamos", 0.38], ["aquí", 1.14], ["para", 1.61], ["cumplir", 1.94], ["un", 2.51], ["propósito", 2.67]]}, {"texto": "Quizás simplemente estamos aquí.", "fin": 2.19, "palabras": [["Quizás", 0.08], ["simplemente", 0.13], ["estamos", 0.93], ["aquí", 1.51]]}, {"texto": "Y, sinceramente...", "fin": 2.28, "palabras": [["Y", 0.06], ["sinceramente", 1.08]]}, {"texto": "¿No te parece extraordinario?", "fin": 1.94, "palabras": [["¿No", 0.06], ["te", 0.11], ["parece", 0.16], ["extraordinario?", 0.43]]}]