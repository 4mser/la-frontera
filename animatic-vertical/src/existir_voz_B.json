[{"texto": "Hay algo profundamente extraño en estar vivos.", "fin": 2.83, "palabras": [["Hay", 0.06], ["algo", 0.11], ["profundamente", 0.16], ["extraño", 1.29], ["en", 1.93], ["estar", 2.12], ["vivos", 2.6]]}, {"texto": "Detente un segundo.", "fin": 1.43, "palabras": [["Detente", 0.06], ["un", 0.46], ["segundo", 0.73]]}, {"texto": "Estás aquí, consciente.", "fin": 1.97, "palabras": [["Estás", 0.06], ["aquí", 0.22], ["consciente", 1.16]]}, {"texto": "En un pequeño rincón del universo, sobre una roca que gira alrededor de una estrella, en medio de miles de millones de galaxias.", "fin": 7.53, "palabras": [["En", 0.06], ["un", 0.11], ["pequeño", 0.16], ["rincón", 0.35], ["del", 0.79], ["universo", 1.01], ["sobre", 1.96], ["una", 2.17], ["roca", 2.39], ["que", 2.69], ["gira", 2.91], ["alrededor", 3.2], ["de", 3.87], ["una", 4.02], ["estrella", 4.23], ["en", 4.63], ["medio", 5.16], ["de", 5.21], ["miles", 5.31], ["de", 5.69], ["millones", 5.84], ["de", 6.46], ["galaxias", 6.61]]}, {"texto": "Y puedes darte cuenta.", "fin": 2.04, "palabras": [["Y", 0.08], ["puedes", 0.43], ["darte", 1.07], ["cuenta", 1.6]]}, {"texto": "Puedes mirar al cielo y preguntarte qué es todo esto.", "fin": 3.48, "palabras": [["Puedes", 0.06], ["mirar", 0.19], ["al", 0.74], ["cielo", 0.96], ["y", 1.55], ["preguntarte", 1.61], ["qué", 1.99], ["es", 2.54], ["todo", 2.61], ["esto", 2.99]]}, {"texto": "Puedes escuchar una canción y sentir algo que ni siquiera sabes explicar.", "fin": 4.21, "palabras": [["Puedes", 0.06], ["escuchar", 0.11], ["una", 0.67], ["canción", 0.93], ["y", 1.55], ["sentir", 1.62], ["algo", 2.16], ["que", 2.53], ["ni", 2.69], ["siquiera", 2.82], ["sabes", 3.35], ["explicar", 3.69]]}, {"texto": "Durante siglos hemos buscado un propósito.", "fin": 2.59, "palabras": [["Durante", 0.06], ["siglos", 0.11], ["hemos", 0.49], ["buscado", 0.87], ["un", 1.41], ["propósito", 1.58]]}, {"texto": "Una razón.", "fin": 0.83, "palabras": [["Una", 0.06], ["razón", 0.11]]}, {"texto": "Una respuesta que justifique nuestra existencia.", "fin": 3.13, "palabras": [["Una", 0.06], ["respuesta", 0.11], ["que", 0.5], ["justifique", 0.72], ["nuestra", 1.47], ["existencia", 2.01]]}, {"texto": "Pero ¿y si no hubiera ninguna?", "fin": 2.53, "palabras": [["Pero", 0.07], ["¿y", 0.3], ["si", 0.59], ["no", 0.84], ["hubiera", 0.89], ["ninguna?", 1.47]]}, {"texto": "¿Y si el universo no estuviera hecho para nosotros?", "fin": 3.62, "palabras": [["¿Y", 0.06], ["si", 0.11], ["el", 0.16], ["universo", 0.21], ["no", 0.95], ["estuviera", 1.15], ["hecho", 2.07], ["para", 2.58], ["nosotros?", 2.99]]}, {"texto": "¿Y si no hubiera un significado escrito en ninguna parte?", "fin": 2.84, "palabras": [["¿Y", 0.06], ["si", 0.11], ["no", 0.22], ["hubiera", 0.32], ["un", 0.72], ["significado", 0.83], ["escrito", 1.53], ["en", 2.04], ["ninguna", 2.18], ["parte?", 2.68]]}, {"texto": "No creo que eso lo haga menos extraordinario.", "fin": 2.64, "palabras": [["No", 0.06], ["creo", 0.11], ["que", 0.16], ["eso", 0.34], ["lo", 0.61], ["haga", 0.79], ["menos", 1.15], ["extraordinario", 1.6]]}, {"texto": "Al contrario.", "fin": 0.87, "palabras": [["Al", 0.06], ["contrario", 0.11]]}, {"texto": "Piensa en todo lo que tuvo que ocurrir para que, durante un instante diminuto de la historia cósmica, la materia pudiera organizarse, respirar, sentir, amar y preguntarse por sí misma.", "fin": 14.16, "palabras": [["Piensa", 0.06], ["en", 0.11], ["todo", 0.18], ["lo", 0.51], ["que", 0.72], ["tuvo", 0.92], ["que", 1.31], ["ocurrir", 1.53], ["para", 3.11], ["que", 3.16], ["durante", 3.21], ["un", 3.26], ["instante", 3.31], ["diminuto", 3.89], ["de", 4.57], ["la", 4.76], ["historia", 4.95], ["cósmica", 5.72], ["la", 6.2], ["materia", 6.61], ["pudiera", 6.89], ["organizarse", 7.5], ["respirar", 8.62], ["sentir", 9.96], ["amar", 11.1], ["y", 12.31], ["preguntarse", 12.36], ["por", 13.18], ["sí", 13.46], ["misma", 13.61]]}, {"texto": "Somos parte de ese universo intentando comprenderse.", "fin": 3.39, "palabras": [["Somos", 0.06], ["parte", 0.11], ["de", 0.5], ["ese", 0.69], ["universo", 0.98], ["intentando", 1.8], ["comprenderse", 2.62]]}, {"texto": "Y cuanto más aprendemos sobre él, más increíble parece.", "fin": 4.74, "palabras": [["Y", 0.06], ["cuanto", 0.56], ["más", 0.99], ["aprendemos", 1.27], ["sobre", 2.22], ["él", 2.69], ["más", 2.95], ["increíble", 3.5], ["parece", 4.29]]}, {"texto": "Descubrir que una flor sigue reglas matemáticas no la hace menos hermosa.", "fin": 4.42, "palabras": [["Descubrir", 0.06], ["que", 0.21], ["una", 0.44], ["flor", 0.67], ["sigue", 0.99], ["reglas", 1.36], ["matemáticas", 1.82], ["no", 2.71], ["la", 2.92], ["hace", 3.09], ["menos", 3.48], ["hermosa", 3.96]]}, {"texto": "Entender las estrellas no apaga su luz.", "fin": 2.74, "palabras": [["Entender", 0.06], ["las", 0.32], ["estrellas", 0.62], ["no", 1.6], ["apaga", 1.76], ["su", 2.22], ["luz", 2.42]]}, {"texto": "Encontrar una explicación no destruye el misterio.", "fin": 2.83, "palabras": [["Encontrar", 0.06], ["una", 0.33], ["explicación", 0.56], ["no", 1.53], ["destruye", 1.66], ["el", 2.21], ["misterio", 2.38]]}, {"texto": "A veces, lo multiplica.", "fin": 1.71, "palabras": [["A", 0.06], ["veces", 0.11], ["lo", 0.53], ["multiplica", 0.99]]}, {"texto": "Quizás no estamos aquí para cumplir un propósito.", "fin": 3.53, "palabras": [["Quizás", 0.08], ["no", 0.63], ["estamos", 0.93], ["aquí", 1.41], ["para", 1.67], ["cumplir", 1.99], ["un", 2.58], ["propósito", 2.71]]}, {"texto": "Quizás simplemente estamos aquí.", "fin": 3.17, "palabras": [["Quizás", 0.59], ["simplemente", 1.1], ["estamos", 2.45], ["aquí", 2.88]]}, {"texto": "Y, sinceramente...", "fin": 1.67, "palabras": [["Y", 0.06], ["sinceramente", 0.42]]}, {"texto": "¿No te parece extraordinario?", "fin": 2.03, "palabras": [["¿No", 0.08], ["te", 0.19], ["parece", 0.48], ["extraordinario?", 0.78]]}]