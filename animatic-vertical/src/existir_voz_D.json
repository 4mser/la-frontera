[{"texto": "Hay algo profundamente extraño en estar vivos.", "fin": 2.9, "palabras": [["Hay", 0.06], ["algo", 0.11], ["profundamente", 0.17], ["extraño", 1.36], ["en", 2.0], ["estar", 2.18], ["vivos", 2.64]]}, {"texto": "Detente un segundo.", "fin": 1.21, "palabras": [["Detente", 0.06], ["un", 0.23], ["segundo", 0.43]]}, {"texto": "Estás aquí, consciente.", "fin": 2.12, "palabras": [["Estás", 0.06], ["aquí", 0.11], ["consciente", 1.32]]}, {"texto": "En un pequeño rincón del universo, sobre una roca que gira alrededor de una estrella, en medio de miles de millones de galaxias.", "fin": 7.95, "palabras": [["En", 0.06], ["un", 0.11], ["pequeño", 0.16], ["rincón", 0.3], ["del", 0.72], ["universo", 0.93], ["sobre", 1.68], ["una", 2.34], ["roca", 2.54], ["que", 2.8], ["gira", 3.06], ["alrededor", 3.29], ["de", 3.89], ["una", 4.02], ["estrella", 4.21], ["en", 5.07], ["medio", 5.43], ["de", 5.55], ["miles", 5.74], ["de", 6.22], ["millones", 6.41], ["de", 7.19], ["galaxias", 7.38]]}, {"texto": "Y puedes darte cuenta.", "fin": 1.45, "palabras": [["Y", 0.06], ["puedes", 0.11], ["darte", 0.19], ["cuenta", 0.6]]}, {"texto": "Puedes mirar el cielo y preguntarte qué es todo esto.", "fin": 3.18, "palabras": [["Puedes", 0.09], ["mirar", 0.35], ["el", 0.64], ["cielo", 0.71], ["y", 1.17], ["preguntarte", 1.26], ["qué", 1.64], ["es", 1.98], ["todo", 2.27], ["esto", 2.49]]}, {"texto": "Puedes escuchar una canción y sentir algo que ni siquiera sabes explicar.", "fin": 3.93, "palabras": [["Puedes", 0.06], ["escuchar", 0.11], ["una", 0.69], ["canción", 0.93], ["y", 1.53], ["sentir", 1.6], ["algo", 2.04], ["que", 2.35], ["ni", 2.5], ["siquiera", 2.6], ["sabes", 3.0], ["explicar", 3.25]]}, {"texto": "Durante siglos hemos buscado un propósito.", "fin": 2.54, "palabras": [["Durante", 0.06], ["siglos", 0.16], ["hemos", 0.7], ["buscado", 1.15], ["un", 1.78], ["propósito", 1.96]]}, {"texto": "Una razón.", "fin": 0.74, "palabras": [["Una", 0.06], ["razón", 0.11]]}, {"texto": "Una respuesta que justifique nuestra existencia.", "fin": 2.6, "palabras": [["Una", 0.06], ["respuesta", 0.11], ["que", 0.33], ["justifique", 0.61], ["nuestra", 1.19], ["existencia", 1.65]]}, {"texto": "Pero ¿y si no hubiera ninguna?", "fin": 1.8, "palabras": [["Pero", 0.08], ["¿y", 0.13], ["si", 0.35], ["no", 0.4], ["hubiera", 0.62], ["ninguna?", 0.98]]}, {"texto": "¿Y si el universo no estuviera hecho para nosotros?", "fin": 2.54, "palabras": [["¿Y", 0.06], ["si", 0.11], ["el", 0.16], ["universo", 0.21], ["no", 0.31], ["estuviera", 0.44], ["hecho", 1.1], ["para", 1.36], ["nosotros?", 1.64]]}, {"texto": "¿Y si no hubiera un significado escrito en alguna parte?", "fin": 2.96, "palabras": [["¿Y", 0.06], ["si", 0.11], ["no", 0.16], ["hubiera", 0.21], ["un", 0.51], ["significado", 0.66], ["escrito", 1.55], ["en", 1.94], ["alguna", 2.05], ["parte?", 2.38]]}, {"texto": "No creo que eso lo haga menos extraordinario.", "fin": 2.29, "palabras": [["No", 0.06], ["creo", 0.11], ["que", 0.16], ["eso", 0.21], ["lo", 0.4], ["haga", 0.55], ["menos", 0.83], ["extraordinario", 1.2]]}, {"texto": "Al contrario.", "fin": 0.67, "palabras": [["Al", 0.06], ["contrario", 0.11]]}, {"texto": "Piensa en todo lo que tuvo que ocurrir para que, durante un instante diminuto de la historia cósmica, la materia pudiera organizarse, respirar, sentir, amar y preguntarse por sí misma.", "fin": 12.85, "palabras": [["Piensa", 0.06], ["en", 0.12], ["todo", 0.41], ["lo", 0.46], ["que", 0.56], ["tuvo", 0.78], ["que", 1.07], ["ocurrir", 1.31], ["para", 1.89], ["que", 2.34], ["durante", 2.39], ["un", 2.66], ["instante", 2.82], ["diminuto", 3.45], ["de", 4.11], ["la", 4.26], ["historia", 4.47], ["cósmica", 5.01], ["la", 5.57], ["materia", 5.93], ["pudiera", 6.21], ["organizarse", 6.84], ["respirar", 8.07], ["sentir", 9.49], ["amar", 10.52], ["y", 11.01], ["preguntarse", 11.55], ["por", 11.99], ["sí", 12.22], ["misma", 12.39]]}, {"texto": "Somos parte de ese universo intentando comprenderse.", "fin": 2.93, "palabras": [["Somos", 0.06], ["parte", 0.11], ["de", 0.23], ["ese", 0.37], ["universo", 0.58], ["intentando", 1.14], ["comprenderse", 1.84]]}, {"texto": "Y cuanto más aprendemos sobre él, más increíble parece.", "fin": 3.77, "palabras": [["Y", 0.06], ["cuanto", 0.11], ["más", 0.16], ["aprendemos", 0.42], ["sobre", 1.14], ["él", 1.54], ["más", 2.04], ["increíble", 2.59], ["parece", 3.1]]}, {"texto": "Descubrir que una flor sigue reglas matemáticas no la hace menos hermosa.", "fin": 4.32, "palabras": [["Descubrir", 0.06], ["que", 0.44], ["una", 0.54], ["flor", 0.67], ["sigue", 0.98], ["reglas", 1.37], ["matemáticas", 1.83], ["no", 2.68], ["la", 2.83], ["hace", 2.98], ["menos", 3.29], ["hermosa", 3.68]]}, {"texto": "Entender las estrellas no apaga su luz.", "fin": 2.87, "palabras": [["Entender", 0.06], ["las", 0.44], ["estrellas", 0.78], ["no", 1.62], ["apaga", 1.68], ["su", 2.22], ["luz", 2.45]]}, {"texto": "Encontrar una explicación no destruye el misterio.", "fin": 2.41, "palabras": [["Encontrar", 0.06], ["una", 0.11], ["explicación", 0.26], ["no", 0.94], ["destruye", 1.06], ["el", 1.64], ["misterio", 1.69]]}, {"texto": "A veces, lo multiplica.", "fin": 1.55, "palabras": [["A", 0.06], ["veces", 0.11], ["lo", 0.25], ["multiplica", 0.55]]}, {"texto": "Quizás no estamos aquí para cumplir un propósito.", "fin": 2.71, "palabras": [["Quizás", 0.06], ["no", 0.11], ["estamos", 0.3], ["aquí", 0.98], ["para", 1.39], ["cumplir", 1.58], ["un", 1.91], ["propósito", 2.0]]}, {"texto": "Quizás simplemente estamos aquí.", "fin": 1.92, "palabras": [["Quizás", 0.06], ["simplemente", 0.11], ["estamos", 0.93], ["aquí", 1.51]]}, {"texto": "Y, sinceramente...", "fin": 1.46, "palabras": [["Y", 0.06], ["sinceramente", 0.11]]}, {"texto": "¿No te parece extraordinario?", "fin": 1.39, "palabras": [["¿No", 0.06], ["te", 0.11], ["parece", 0.16], ["extraordinario?", 0.25]]}]