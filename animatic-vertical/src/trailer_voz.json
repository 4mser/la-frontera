[{"texto": "Toma un número, multiplícalo por sí mismo, súmale una constante, y vuelve a empezar.", "fin": 6.76, "palabras": [["Toma", 0.08], ["un", 0.39], ["número", 0.56], ["multiplícalo", 1.49], ["por", 2.25], ["sí", 2.46], ["mismo", 2.58], ["súmale", 3.51], ["una", 3.99], ["constante", 4.22], ["y", 5.46], ["vuelve", 5.56], ["a", 5.99], ["empezar", 6.04]]}, {"texto": "Una regla que cabe en una línea dibuja una frontera que no termina.", "fin": 4.62, "palabras": [["Una", 0.08], ["regla", 0.35], ["que", 0.79], ["cabe", 0.96], ["en", 1.33], ["una", 1.46], ["línea", 1.65], ["dibuja", 2.11], ["una", 2.67], ["frontera", 2.92], ["que", 3.53], ["no", 3.69], ["termina", 3.92]]}, {"texto": "¿Por qué hay algo, y no más bien nada?", "fin": 2.9, "palabras": [["Por", 0.18], ["qué", 0.29], ["hay", 0.44], ["algo", 0.68], ["y", 1.58], ["no", 1.69], ["más", 1.89], ["bien", 2.17], ["nada", 2.42]]}, {"texto": "¿Cuánto mide, de verdad, la costa de un país?", "fin": 4.0, "palabras": [["Cuánto", 0.15], ["mide", 0.47], ["de", 1.32], ["verdad", 1.43], ["la", 2.44], ["costa", 2.6], ["de", 3.04], ["un", 3.21], ["país", 3.39]]}, {"texto": "¿Por qué un corazón sano no late como un reloj?", "fin": 3.31, "palabras": [["Por", 0.18], ["qué", 0.29], ["un", 0.44], ["corazón", 0.6], ["sano", 1.18], ["no", 1.62], ["late", 1.82], ["como", 2.22], ["un", 2.51], ["reloj", 2.69]]}, {"texto": "Saber la regla no es lo mismo que saber el resultado.", "fin": 3.67, "palabras": [["Saber", 0.08], ["la", 0.51], ["regla", 0.65], ["no", 1.11], ["es", 1.4], ["lo", 1.57], ["mismo", 1.69], ["que", 2.14], ["saber", 2.29], ["el", 2.68], ["resultado", 2.82]]}, {"texto": "Desde aquí, ya no hay nada que medir. Solo queda la regla, y la regla sigue.", "fin": 6.43, "palabras": [["Desde", 0.08], ["aquí", 0.44], ["ya", 1.36], ["no", 1.57], ["hay", 1.75], ["nada", 1.9], ["que", 2.28], ["medir", 2.42], ["Solo", 3.4], ["queda", 3.79], ["la", 4.11], ["regla", 4.26], ["y", 5.19], ["la", 5.29], ["regla", 5.47], ["sigue", 5.88]]}, {"texto": "Este es un viaje por las fronteras del mundo, del cuerpo, y de lo que creemos conocer.", "fin": 6.33, "palabras": [["Este", 0.08], ["es", 0.46], ["un", 0.64], ["viaje", 0.79], ["por", 1.24], ["las", 1.44], ["fronteras", 1.64], ["del", 2.24], ["mundo", 2.42], ["del", 3.33], ["cuerpo", 3.54], ["y", 4.53], ["de", 4.62], ["lo", 4.76], ["que", 4.9], ["creemos", 5.06], ["conocer", 5.67]]}, {"texto": "Hay formas que aparecen una y otra vez.", "fin": 2.79, "palabras": [["Hay", 0.08], ["formas", 0.26], ["que", 0.81], ["aparecen", 0.93], ["una", 1.57], ["y", 1.9], ["otra", 2.06], ["vez", 2.32]]}, {"texto": "En un río, en un rayo, en las ramas de un árbol, en el ritmo de un corazón.", "fin": 6.39, "palabras": [["En", 0.1], ["un", 0.25], ["río", 0.43], ["en", 1.26], ["un", 1.44], ["rayo", 1.62], ["en", 2.56], ["las", 2.72], ["ramas", 2.94], ["de", 3.35], ["un", 3.46], ["árbol", 3.65], ["en", 4.6], ["el", 4.71], ["ritmo", 4.88], ["de", 5.31], ["un", 5.46], ["corazón", 5.67]]}, {"texto": "Y todas parecen nacer de una idea muy simple.", "fin": 3.21, "palabras": [["Y", 0.08], ["todas", 0.21], ["parecen", 0.62], ["nacer", 1.08], ["de", 1.53], ["una", 1.67], ["idea", 1.93], ["muy", 2.32], ["simple", 2.6]]}, {"texto": "Una regla que cabe en una línea, y una frontera que no termina.", "fin": 4.75, "palabras": [["Una", 0.08], ["regla", 0.33], ["que", 0.78], ["cabe", 0.94], ["en", 1.33], ["una", 1.46], ["línea", 1.67], ["y", 2.72], ["una", 2.83], ["frontera", 3.07], ["que", 3.65], ["no", 3.82], ["termina", 4.04]]}, {"texto": "¿Qué significa conocer desde una frontera?", "fin": 3.01, "palabras": [["Qué", 0.17], ["significa", 0.24], ["conocer", 0.97], ["desde", 1.64], ["una", 2.03], ["frontera", 2.28]]}, {"texto": "Si te acercas lo suficiente, el mundo nunca se vuelve liso.", "fin": 4.62, "palabras": [["Si", 0.08], ["te", 0.33], ["acercas", 0.46], ["lo", 1.06], ["suficiente", 1.17], ["el", 2.53], ["mundo", 2.71], ["nunca", 3.07], ["se", 3.53], ["vuelve", 3.71], ["liso", 4.1]]}, {"texto": "Una costa, un rayo, las ramas de un árbol, tu sistema nervioso, los vasos de tus propios ojos.", "fin": 8.19, "palabras": [["Una", 0.08], ["costa", 0.33], ["un", 1.26], ["rayo", 1.46], ["las", 2.43], ["ramas", 2.67], ["de", 3.06], ["un", 3.17], ["árbol", 3.35], ["tu", 4.26], ["sistema", 4.38], ["nervioso", 4.92], ["los", 6.12], ["vasos", 6.35], ["de", 6.78], ["tus", 6.9], ["propios", 7.12], ["ojos", 7.61]]}, {"texto": "Todos repiten su forma, escala tras escala.", "fin": 3.65, "palabras": [["Todos", 0.08], ["repiten", 0.47], ["su", 1.03], ["forma", 1.18], ["escala", 2.17], ["tras", 2.71], ["escala", 3.0]]}, {"texto": "Y detrás de todo eso hay una regla tan simple que cabe en una línea.", "fin": 4.54, "palabras": [["Y", 0.08], ["detrás", 0.18], ["de", 0.64], ["todo", 0.78], ["eso", 1.17], ["hay", 1.54], ["una", 1.72], ["regla", 1.94], ["tan", 2.38], ["simple", 2.64], ["que", 3.1], ["cabe", 3.26], ["en", 3.65], ["una", 3.79], ["línea", 4.0]]}, {"texto": "Repítela, y aparece algo que no se termina nunca.", "fin": 3.97, "palabras": [["Repítela", 0.08], ["y", 1.32], ["aparece", 1.42], ["algo", 1.99], ["que", 2.36], ["no", 2.51], ["se", 2.74], ["termina", 2.92], ["nunca", 3.4]]}, {"texto": "Cincuenta y seis órdenes de magnitud más abajo, la misma forma, completa.", "fin": 6.08, "palabras": [["Cincuenta", 0.08], ["y", 0.67], ["seis", 0.75], ["órdenes", 1.14], ["de", 1.62], ["magnitud", 1.72], ["más", 2.4], ["abajo", 2.74], ["la", 3.86], ["misma", 3.99], ["forma", 4.39], ["completa", 5.32]]}, {"texto": "Una sola línea de matemática, y un borde con detalle a toda escala.", "fin": 5.14, "palabras": [["Una", 0.08], ["sola", 0.31], ["línea", 0.64], ["de", 1.04], ["matemática", 1.17], ["y", 2.53], ["un", 2.64], ["borde", 2.81], ["con", 3.17], ["detalle", 3.36], ["a", 3.97], ["toda", 4.11], ["escala", 4.5]]}, {"texto": "Un viaje hasta el borde de lo que podemos conocer.", "fin": 3.29, "palabras": [["Un", 0.08], ["viaje", 0.28], ["hasta", 0.78], ["el", 1.1], ["borde", 1.22], ["de", 1.62], ["lo", 1.78], ["que", 1.9], ["podemos", 2.06], ["conocer", 2.6]]}, {"texto": "¿Hasta dónde llega una forma?", "fin": 2.24, "palabras": [["Hasta", 0.15], ["dónde", 0.42], ["llega", 0.78], ["una", 1.24], ["forma", 1.51]]}]