[{"texto": "Toma un número.", "fin": 1.18, "palabras": [["Toma", 0.1], ["un", 0.43], ["número", 0.62]]}, {"texto": "Multiplícalo por sí mismo.", "fin": 1.97, "palabras": [["Multiplícalo", 0.07], ["por", 1.0], ["sí", 1.24], ["mismo", 1.39]]}, {"texto": "Súmale una constante.", "fin": 1.78, "palabras": [["Súmale", 0.1], ["una", 0.67], ["constante", 0.92]]}, {"texto": "Y con el resultado, vuelve a empezar.", "fin": 3.07, "palabras": [["Y", 0.08], ["con", 0.19], ["el", 0.4], ["resultado", 0.54], ["vuelve", 1.85], ["a", 2.26], ["empezar", 2.35]]}, {"texto": "Eso es todo. Una sola regla, repetida una y otra vez.", "fin": 5.15, "palabras": [["Eso", 0.1], ["es", 0.51], ["todo", 0.72], ["Una", 1.64], ["sola", 1.88], ["regla", 2.22], ["repetida", 3.28], ["una", 3.94], ["y", 4.28], ["otra", 4.42], ["vez", 4.68]]}, {"texto": "A una forma así se le llama fractal.", "fin": 2.81, "palabras": [["A", 0.1], ["una", 0.21], ["forma", 0.47], ["así", 0.99], ["se", 1.4], ["le", 1.6], ["llama", 1.71], ["fractal", 2.1]]}, {"texto": "¿Pero qué es exactamente un fractal?", "fin": 2.56, "palabras": [["Pero", 0.15], ["qué", 0.32], ["es", 0.53], ["exactamente", 0.74], ["un", 1.72], ["fractal", 1.88]]}, {"texto": "Acerquémonos al borde de un círculo.", "fin": 2.78, "palabras": [["Acerquémonos", 0.1], ["al", 1.06], ["borde", 1.25], ["de", 1.65], ["un", 1.85], ["círculo", 2.07]]}, {"texto": "Mientras más te acercas, más recto se ve.", "fin": 3.32, "palabras": [["Mientras", 0.07], ["más", 0.58], ["te", 0.86], ["acercas", 0.97], ["más", 2.06], ["recto", 2.42], ["se", 2.83], ["ve", 3.01]]}, {"texto": "Al final, es solo una línea.", "fin": 2.61, "palabras": [["Al", 0.1], ["final", 0.26], ["es", 1.32], ["solo", 1.46], ["una", 1.81], ["línea", 2.06]]}, {"texto": "Ahora, acerquémonos al borde de un fractal.", "fin": 3.67, "palabras": [["Ahora", 0.1], ["acerquémonos", 1.1], ["al", 2.01], ["borde", 2.18], ["de", 2.57], ["un", 2.75], ["fractal", 2.94]]}, {"texto": "Nunca se vuelve liso. Siempre aparece más detalle.", "fin": 4.17, "palabras": [["Nunca", 0.06], ["se", 0.53], ["vuelve", 0.71], ["liso", 1.1], ["Siempre", 2.06], ["aparece", 2.58], ["más", 3.15], ["detalle", 3.49]]}, {"texto": "Esa es la primera idea: un fractal tiene detalle a todas las escalas.", "fin": 5.36, "palabras": [["Esa", 0.08], ["es", 0.44], ["la", 0.61], ["primera", 0.75], ["idea", 1.21], ["un", 2.29], ["fractal", 2.44], ["tiene", 3.0], ["detalle", 3.29], ["a", 3.86], ["todas", 3.97], ["las", 4.44], ["escalas", 4.64]]}, {"texto": "Casi siempre nace de repetir una regla sencilla.", "fin": 3.44, "palabras": [["Casi", 0.08], ["siempre", 0.43], ["nace", 0.89], ["de", 1.29], ["repetir", 1.42], ["una", 2.0], ["regla", 2.25], ["sencilla", 2.64]]}, {"texto": "Toma una línea. Ahora, divide esa línea en tres.", "fin": 4.61, "palabras": [["Toma", 0.1], ["una", 0.43], ["línea", 0.71], ["Ahora", 1.72], ["divide", 2.71], ["esa", 3.19], ["línea", 3.47], ["en", 3.94], ["tres", 4.1]]}, {"texto": "Reemplaza el tramo del medio por dos lados de un triángulo.", "fin": 4.1, "palabras": [["Reemplaza", 0.07], ["el", 0.82], ["tramo", 0.96], ["del", 1.31], ["medio", 1.51], ["por", 1.92], ["dos", 2.18], ["lados", 2.49], ["de", 2.99], ["un", 3.12], ["triángulo", 3.35]]}, {"texto": "Ahora haz lo mismo con cada tramo nuevo. Y otra vez. Y otra.", "fin": 5.33, "palabras": [["Ahora", 0.1], ["haz", 0.53], ["lo", 0.69], ["mismo", 0.82], ["con", 1.26], ["cada", 1.53], ["tramo", 1.9], ["nuevo", 2.28], ["Y", 3.25], ["otra", 3.4], ["vez", 3.74], ["Y", 4.62], ["otra", 4.82]]}, {"texto": "Mira una de sus partes: es una copia exacta del todo, en pequeño.", "fin": 5.35, "palabras": [["Mira", 0.08], ["una", 0.43], ["de", 0.68], ["sus", 0.81], ["partes", 1.06], ["es", 2.17], ["una", 2.33], ["copia", 2.56], ["exacta", 2.94], ["del", 3.47], ["todo", 3.71], ["en", 4.47], ["pequeño", 4.67]]}, {"texto": "A eso se le llama autosemejanza.", "fin": 2.53, "palabras": [["A", 0.1], ["eso", 0.26], ["se", 0.57], ["le", 0.75], ["llama", 0.86], ["autosemejanza", 1.31]]}, {"texto": "Pasa lo mismo con un triángulo al que se le quita el centro, una y otra vez.", "fin": 5.29, "palabras": [["Pasa", 0.1], ["lo", 0.36], ["mismo", 0.49], ["con", 0.89], ["un", 1.1], ["triángulo", 1.25], ["al", 1.92], ["que", 2.08], ["se", 2.21], ["le", 2.36], ["quita", 2.49], ["el", 2.82], ["centro", 2.94], ["una", 4.1], ["y", 4.42], ["otra", 4.57], ["vez", 4.83]]}, {"texto": "O con un helecho que nace de solo cuatro reglas.", "fin": 3.31, "palabras": [["O", 0.08], ["con", 0.19], ["un", 0.4], ["helecho", 0.56], ["que", 1.06], ["nace", 1.21], ["de", 1.61], ["solo", 1.75], ["cuatro", 2.17], ["reglas", 2.61]]}, {"texto": "En la naturaleza, el parecido no es exacto, sino aproximado: cada rama de un helecho real se parece al helecho completo.", "fin": 9.22, "palabras": [["En", 0.08], ["la", 0.24], ["naturaleza", 0.35], ["el", 1.53], ["parecido", 1.69], ["no", 2.26], ["es", 2.5], ["exacto", 2.65], ["sino", 3.71], ["aproximado", 4.0], ["cada", 5.35], ["rama", 5.67], ["de", 6.01], ["un", 6.18], ["helecho", 6.36], ["real", 6.81], ["se", 7.24], ["parece", 7.43], ["al", 7.92], ["helecho", 8.06], ["completo", 8.49]]}, {"texto": "Cada paso alarga el borde del copo en un tercio.", "fin": 3.44, "palabras": [["Cada", 0.08], ["paso", 0.38], ["alarga", 0.82], ["el", 1.31], ["borde", 1.44], ["del", 1.79], ["copo", 2.01], ["en", 2.5], ["un", 2.67], ["tercio", 2.83]]}, {"texto": "Después de infinitos pasos, su borde mide infinito… pero encierra un área finita.", "fin": 6.28, "palabras": [["Después", 0.07], ["de", 0.58], ["infinitos", 0.67], ["pasos", 1.35], ["su", 2.24], ["borde", 2.46], ["mide", 2.81], ["infinito", 3.11], ["pero", 4.25], ["encierra", 4.49], ["un", 5.07], ["área", 5.28], ["finita", 5.61]]}, {"texto": "Es la misma paradoja de la costa.", "fin": 2.46, "palabras": [["Es", 0.08], ["la", 0.31], ["misma", 0.46], ["paradoja", 0.92], ["de", 1.58], ["la", 1.72], ["costa", 1.85]]}, {"texto": "Por eso los fractales necesitan una medida nueva: su dimensión.", "fin": 5.06, "palabras": [["Por", 0.1], ["eso", 0.26], ["los", 0.51], ["fractales", 0.69], ["necesitan", 1.44], ["una", 2.19], ["medida", 2.42], ["nueva", 2.89], ["su", 4.01], ["dimensión", 4.19]]}, {"texto": "Agranda una línea tres veces: la nueva línea está hecha de tres copias de la original.", "fin": 5.9, "palabras": [["Agranda", 0.1], ["una", 0.58], ["línea", 0.79], ["tres", 1.21], ["veces", 1.54], ["la", 2.43], ["nueva", 2.56], ["línea", 2.86], ["está", 3.32], ["hecha", 3.69], ["de", 3.97], ["tres", 4.14], ["copias", 4.49], ["de", 4.96], ["la", 5.06], ["original", 5.18]]}, {"texto": "Tres es tres elevado a uno. Ese uno es su dimensión.", "fin": 4.57, "palabras": [["Tres", 0.1], ["es", 0.44], ["tres", 0.68], ["elevado", 1.03], ["a", 1.65], ["uno", 1.75], ["Ese", 2.67], ["uno", 2.99], ["es", 3.39], ["su", 3.6], ["dimensión", 3.74]]}, {"texto": "Agranda un cuadrado tres veces: el nuevo está hecho de nueve copias. Nueve es tres elevado a dos: dimensión dos.", "fin": 9.43, "palabras": [["Agranda", 0.08], ["un", 0.58], ["cuadrado", 0.74], ["tres", 1.29], ["veces", 1.64], ["el", 2.76], ["nuevo", 2.94], ["está", 3.31], ["hecho", 3.69], ["de", 4.03], ["nueve", 4.17], ["copias", 4.56], ["Nueve", 5.68], ["es", 6.14], ["tres", 6.35], ["elevado", 6.69], ["a", 7.24], ["dos", 7.29], ["dimensión", 8.26], ["dos", 8.96]]}, {"texto": "Un cubo agrandado tres veces se arma con veintisiete copias. Veintisiete es tres elevado a tres: dimensión tres.", "fin": 9.17, "palabras": [["Un", 0.07], ["cubo", 0.28], ["agrandado", 0.61], ["tres", 1.26], ["veces", 1.62], ["se", 2.07], ["arma", 2.28], ["con", 2.62], ["veintisiete", 2.85], ["copias", 3.62], ["Veintisiete", 4.74], ["es", 5.6], ["tres", 5.86], ["elevado", 6.22], ["a", 6.79], ["tres", 6.88], ["dimensión", 7.92], ["tres", 8.64]]}, {"texto": "La dimensión es el número al que hay que elevar el aumento para obtener la cantidad de copias.", "fin": 5.79, "palabras": [["La", 0.08], ["dimensión", 0.24], ["es", 0.86], ["el", 1.04], ["número", 1.21], ["al", 1.65], ["que", 1.81], ["hay", 1.97], ["que", 2.18], ["elevar", 2.36], ["el", 2.76], ["aumento", 2.89], ["para", 3.46], ["obtener", 3.71], ["la", 4.24], ["cantidad", 4.36], ["de", 4.97], ["copias", 5.1]]}, {"texto": "Ahora agranda la curva de Koch, también tres veces: la nueva está hecha de solo cuatro copias.", "fin": 6.85, "palabras": [["Ahora", 0.08], ["agranda", 0.46], ["la", 0.89], ["curva", 1.01], ["de", 1.39], ["Koch", 1.53], ["también", 2.39], ["tres", 2.86], ["veces", 3.17], ["la", 4.06], ["nueva", 4.19], ["está", 4.54], ["hecha", 4.9], ["de", 5.18], ["solo", 5.33], ["cuatro", 5.74], ["copias", 6.17]]}, {"texto": "Cuatro es tres elevado a… uno coma veintiséis.", "fin": 4.12, "palabras": [["Cuatro", 0.1], ["es", 0.51], ["tres", 0.74], ["elevado", 1.04], ["a", 1.64], ["uno", 2.56], ["coma", 2.85], ["veintiséis", 3.18]]}, {"texto": "Su dimensión no es un número entero.", "fin": 2.65, "palabras": [["Su", 0.08], ["dimensión", 0.29], ["no", 1.01], ["es", 1.29], ["un", 1.5], ["número", 1.65], ["entero", 2.06]]}, {"texto": "Más que una línea. Menos que un plano.", "fin": 3.29, "palabras": [["Más", 0.07], ["que", 0.46], ["una", 0.62], ["línea", 0.89], ["Menos", 1.88], ["que", 2.38], ["un", 2.54], ["plano", 2.74]]}, {"texto": "Un fractal vive entre las dimensiones.", "fin": 2.78, "palabras": [["Un", 0.08], ["fractal", 0.26], ["vive", 0.82], ["entre", 1.24], ["las", 1.61], ["dimensiones", 1.81]]}, {"texto": "¿Y por qué el conejo tiene esta forma?", "fin": 2.57, "palabras": [["Y", 0.17], ["por", 0.19], ["qué", 0.46], ["el", 0.62], ["conejo", 0.76], ["tiene", 1.33], ["esta", 1.74], ["forma", 2.03]]}, {"texto": "Elige cualquier punto de este plano, aplícale la regla una y otra vez, y mira cuánto se aleja del centro.", "fin": 7.68, "palabras": [["Elige", 0.08], ["cualquier", 0.51], ["punto", 1.04], ["de", 1.44], ["este", 1.64], ["plano", 1.92], ["aplícale", 2.78], ["la", 3.39], ["regla", 3.54], ["una", 3.97], ["y", 4.28], ["otra", 4.42], ["vez", 4.68], ["y", 5.53], ["mira", 5.62], ["cuánto", 5.94], ["se", 6.32], ["aleja", 6.49], ["del", 6.88], ["centro", 7.08]]}, {"texto": "Este punto nunca se aleja: por muchas veces que repitas la regla, se queda cerca. Lo pintamos de azul.", "fin": 8.29, "palabras": [["Este", 0.08], ["punto", 0.42], ["nunca", 0.82], ["se", 1.22], ["aleja", 1.38], ["por", 2.43], ["muchas", 2.64], ["veces", 3.08], ["que", 3.5], ["repitas", 3.61], ["la", 4.18], ["regla", 4.32], ["se", 5.15], ["queda", 5.35], ["cerca", 5.69], ["Lo", 6.75], ["pintamos", 6.93], ["de", 7.62], ["azul", 7.72]]}, {"texto": "Este otro, en cambio, se aleja cada vez más, y nunca vuelve. Escapa al infinito. Lo pintamos de un color cálido.", "fin": 10.24, "palabras": [["Este", 0.08], ["otro", 0.47], ["en", 1.26], ["cambio", 1.49], ["se", 2.42], ["aleja", 2.6], ["cada", 2.99], ["vez", 3.33], ["más", 3.6], ["y", 4.46], ["nunca", 4.56], ["vuelve", 4.97], ["Escapa", 5.97], ["al", 6.58], ["infinito", 6.74], ["Lo", 7.97], ["pintamos", 8.15], ["de", 8.82], ["un", 8.96], ["color", 9.17], ["cálido", 9.6]]}, {"texto": "Ahora haz lo mismo con cada punto del plano. Los que se quedan, en azul; los que escapan, en colores cálidos.", "fin": 8.92, "palabras": [["Ahora", 0.1], ["haz", 0.53], ["lo", 0.67], ["mismo", 0.79], ["con", 1.24], ["cada", 1.5], ["punto", 1.83], ["del", 2.26], ["plano", 2.47], ["Los", 3.43], ["que", 3.69], ["se", 3.82], ["quedan", 3.99], ["en", 4.82], ["azul", 4.94], ["los", 6.11], ["que", 6.33], ["escapan", 6.44], ["en", 7.46], ["colores", 7.61], ["cálidos", 8.17]]}, {"texto": "Y así, punto por punto, aparece el fractal completo: el conejo de Duadí.", "fin": 6.19, "palabras": [["Y", 0.08], ["así", 0.22], ["punto", 1.11], ["por", 1.49], ["punto", 1.71], ["aparece", 2.58], ["el", 3.15], ["fractal", 3.26], ["completo", 3.79], ["el", 4.83], ["conejo", 5.04], ["de", 5.57], ["Duadí", 5.69]]}, {"texto": "Su borde dorado separa los puntos que se quedan de los que escapan.", "fin": 4.32, "palabras": [["Su", 0.08], ["borde", 0.32], ["dorado", 0.68], ["separa", 1.17], ["los", 1.61], ["puntos", 1.86], ["que", 2.39], ["se", 2.53], ["quedan", 2.71], ["de", 3.15], ["los", 3.26], ["que", 3.47], ["escapan", 3.6]]}, {"texto": "Y ese borde, la frontera entre los dos destinos, es el fractal.", "fin": 5.19, "palabras": [["Y", 0.08], ["ese", 0.25], ["borde", 0.53], ["la", 1.51], ["frontera", 1.62], ["entre", 2.22], ["los", 2.51], ["dos", 2.75], ["destinos", 3.0], ["es", 4.12], ["el", 4.35], ["fractal", 4.49]]}]