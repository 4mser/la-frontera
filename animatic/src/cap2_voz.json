[{"texto": "En el capítulo anterior, cada parte era una copia exacta del todo.", "fin": 5.03, "palabras": [["En", 0.08], ["el", 0.22], ["capítulo", 0.36], ["anterior", 0.92], ["cada", 2.0], ["parte", 2.29], ["era", 2.81], ["una", 3.03], ["copia", 3.28], ["exacta", 3.72], ["del", 4.29], ["todo", 4.54]]}, {"texto": "Pero no todos los fractales funcionan así.", "fin": 2.99, "palabras": [["Pero", 0.1], ["no", 0.32], ["todos", 0.51], ["los", 0.99], ["fractales", 1.17], ["funcionan", 1.88], ["así", 2.54]]}, {"texto": "El conjunto de Mandelbrót tiene patrones que regresan: pequeñas copias de sí mismo.", "fin": 6.03, "palabras": [["El", 0.08], ["conjunto", 0.25], ["de", 0.81], ["Mandelbrót", 0.93], ["tiene", 1.71], ["patrones", 2.04], ["que", 2.65], ["regresan", 2.76], ["pequeñas", 4.03], ["copias", 4.67], ["de", 5.18], ["sí", 5.29], ["mismo", 5.47]]}, {"texto": "Pero al acercarnos aparecen también estructuras que no son réplicas de lo que ya vimos.", "fin": 5.56, "palabras": [["Pero", 0.1], ["al", 0.31], ["acercarnos", 0.43], ["aparecen", 1.22], ["también", 1.88], ["estructuras", 2.29], ["que", 3.1], ["no", 3.24], ["son", 3.44], ["réplicas", 3.72], ["de", 4.36], ["lo", 4.46], ["que", 4.58], ["ya", 4.71], ["vimos", 4.92]]}, {"texto": "La complejidad no siempre consiste en repetir una forma. A veces consiste en descubrir qué permanece cuando la forma cambia.", "fin": 8.85, "palabras": [["La", 0.08], ["complejidad", 0.25], ["no", 1.12], ["siempre", 1.35], ["consiste", 1.81], ["en", 2.51], ["repetir", 2.67], ["una", 3.19], ["forma", 3.42], ["A", 4.44], ["veces", 4.56], ["consiste", 4.99], ["en", 5.65], ["descubrir", 5.76], ["qué", 6.39], ["permanece", 6.54], ["cuando", 7.29], ["la", 7.67], ["forma", 7.79], ["cambia", 8.21]]}, {"texto": "Mil billones de aumentos más abajo aparece otra copia del conjunto. Pero el paisaje que la rodea no se parece a nada de lo anterior.", "fin": 9.28, "palabras": [["Mil", 0.07], ["billones", 0.35], ["de", 0.86], ["aumentos", 0.94], ["más", 1.58], ["abajo", 1.88], ["aparece", 2.4], ["otra", 3.03], ["copia", 3.38], ["del", 3.81], ["conjunto", 4.01], ["Pero", 5.24], ["el", 5.43], ["paisaje", 5.54], ["que", 6.17], ["la", 6.32], ["rodea", 6.46], ["no", 6.96], ["se", 7.19], ["parece", 7.38], ["a", 7.89], ["nada", 7.96], ["de", 8.35], ["lo", 8.49], ["anterior", 8.6]]}, {"texto": "La naturaleza tampoco hace copias exactas. Lo que se mantiene al acercarse a una nube es su rugosidad: la forma cambia.", "fin": 9.25, "palabras": [["La", 0.08], ["naturaleza", 0.25], ["tampoco", 0.99], ["hace", 1.65], ["copias", 1.94], ["exactas", 2.47], ["Lo", 3.76], ["que", 3.94], ["se", 4.07], ["mantiene", 4.21], ["al", 4.74], ["acercarse", 4.86], ["a", 5.65], ["una", 5.78], ["nube", 6.01], ["es", 6.46], ["su", 6.61], ["rugosidad", 6.75], ["la", 8.06], ["forma", 8.19], ["cambia", 8.61]]}, {"texto": "El conejo nació de una sola constante. Cada constante define una dinámica, y esa dinámica dibuja un conjunto de Yüliaá.", "fin": 9.49, "palabras": [["El", 0.08], ["conejo", 0.26], ["nació", 0.74], ["de", 1.22], ["una", 1.39], ["sola", 1.68], ["constante", 2.08], ["Cada", 3.39], ["constante", 3.65], ["define", 4.32], ["una", 4.81], ["dinámica", 5.03], ["y", 6.31], ["esa", 6.44], ["dinámica", 6.68], ["dibuja", 7.28], ["un", 7.83], ["conjunto", 8.0], ["de", 8.65], ["Yüliaá", 8.78]]}, {"texto": "Basta con mover la constante un poco para que el mundo entero cambie de forma.", "fin": 4.83, "palabras": [["Basta", 0.07], ["con", 0.49], ["mover", 0.67], ["la", 1.03], ["constante", 1.15], ["un", 1.82], ["poco", 1.99], ["para", 2.39], ["que", 2.65], ["el", 2.79], ["mundo", 2.92], ["entero", 3.25], ["cambie", 3.72], ["de", 4.15], ["forma", 4.26]]}, {"texto": "Algunos de esos conjuntos permanecen de una sola pieza. Otros se fragmentan hasta convertirse en polvo.", "fin": 7.64, "palabras": [["Algunos", 0.08], ["de", 0.61], ["esos", 0.79], ["conjuntos", 1.11], ["permanecen", 1.9], ["de", 2.68], ["una", 2.82], ["sola", 3.1], ["pieza", 3.47], ["Otros", 4.49], ["se", 4.89], ["fragmentan", 5.01], ["hasta", 5.79], ["convertirse", 6.08], ["en", 6.93], ["polvo", 7.08]]}, {"texto": "De un lado queda algo: un mundo entero, de una sola pieza. Del otro queda casi nada: un polvo de puntos sueltos.", "fin": 9.56, "palabras": [["De", 0.07], ["un", 0.25], ["lado", 0.44], ["queda", 0.79], ["algo", 1.19], ["un", 2.19], ["mundo", 2.35], ["entero", 2.68], ["de", 3.61], ["una", 3.75], ["sola", 4.03], ["pieza", 4.42], ["Del", 5.42], ["otro", 5.67], ["queda", 5.94], ["casi", 6.28], ["nada", 6.67], ["un", 7.69], ["polvo", 7.89], ["de", 8.25], ["puntos", 8.4], ["sueltos", 8.86]]}, {"texto": "¿Cómo saber de qué lado cae cada constante, sin tener que dibujar su mundo completo?", "fin": 6.04, "palabras": [["Cómo", 0.14], ["saber", 0.33], ["de", 0.79], ["qué", 0.92], ["lado", 1.07], ["cae", 1.44], ["cada", 1.78], ["constante", 2.1], ["sin", 3.42], ["tener", 3.65], ["que", 4.03], ["dibujar", 4.15], ["su", 4.74], ["mundo", 4.9], ["completo", 5.29]]}, {"texto": "Hace un siglo, Pier Fatú y Gastón Yüliaá encontraron la respuesta: basta con seguir un solo punto, el cero.", "fin": 8.5, "palabras": [["Hace", 0.1], ["un", 0.4], ["siglo", 0.56], ["Pier", 1.4], ["Fatú", 1.62], ["y", 2.04], ["Gastón", 2.11], ["Yüliaá", 2.65], ["encontraron", 3.22], ["la", 3.94], ["respuesta", 4.06], ["basta", 5.56], ["con", 5.93], ["seguir", 6.14], ["un", 6.51], ["solo", 6.65], ["punto", 6.97], ["el", 7.83], ["cero", 8.01]]}, {"texto": "Si la órbita del cero se queda cerca, el mundo es de una sola pieza. Si se escapa, el mundo se rompe en polvo.", "fin": 9.0, "palabras": [["Si", 0.08], ["la", 0.32], ["órbita", 0.51], ["del", 0.94], ["cero", 1.18], ["se", 1.53], ["queda", 1.72], ["cerca", 2.03], ["el", 3.0], ["mundo", 3.19], ["es", 3.64], ["de", 3.82], ["una", 3.94], ["sola", 4.24], ["pieza", 4.61], ["Si", 5.65], ["se", 5.88], ["escapa", 6.04], ["el", 7.08], ["mundo", 7.29], ["se", 7.64], ["rompe", 7.82], ["en", 8.29], ["polvo", 8.44]]}, {"texto": "Ahora pintemos cada constante del plano según el destino de su cero.", "fin": 4.74, "palabras": [["Ahora", 0.08], ["pintemos", 0.46], ["cada", 1.12], ["constante", 1.42], ["del", 2.11], ["plano", 2.33], ["según", 2.79], ["el", 3.25], ["destino", 3.39], ["de", 3.94], ["su", 4.07], ["cero", 4.22]]}, {"texto": "Ya lo viste al comienzo de la película: es el conjunto de Mandelbrót.", "fin": 4.94, "palabras": [["Ya", 0.08], ["lo", 0.31], ["viste", 0.44], ["al", 0.82], ["comienzo", 0.94], ["de", 1.53], ["la", 1.64], ["película", 1.76], ["es", 3.01], ["el", 3.22], ["conjunto", 3.36], ["de", 4.0], ["Mandelbrót", 4.12]]}, {"texto": "Cada punto de esta figura es una constante, y cada constante es un mundo.", "fin": 5.56, "palabras": [["Cada", 0.08], ["punto", 0.36], ["de", 0.76], ["esta", 0.96], ["figura", 1.24], ["es", 1.78], ["una", 1.94], ["constante", 2.15], ["y", 3.44], ["cada", 3.56], ["constante", 3.86], ["es", 4.69], ["un", 4.89], ["mundo", 5.03]]}, {"texto": "En el cuerpo principal, los mundos son círculos deformados, siempre de una sola pieza.", "fin": 6.61, "palabras": [["En", 0.08], ["el", 0.24], ["cuerpo", 0.4], ["principal", 0.79], ["los", 1.99], ["mundos", 2.18], ["son", 2.58], ["círculos", 2.82], ["deformados", 3.42], ["siempre", 4.64], ["de", 5.19], ["una", 5.36], ["sola", 5.65], ["pieza", 6.03]]}, {"texto": "En este bulbo, todos los mundos tienen la forma de la basílica.", "fin": 4.65, "palabras": [["En", 0.1], ["este", 0.25], ["bulbo", 0.54], ["todos", 1.54], ["los", 1.93], ["mundos", 2.15], ["tienen", 2.68], ["la", 3.03], ["forma", 3.15], ["de", 3.58], ["la", 3.72], ["basílica", 3.83]]}, {"texto": "En este otro aparece el conejo, con tres orejas que se tocan en un punto. Mira la antena del bulbo: también tiene tres brazos.", "fin": 9.86, "palabras": [["En", 0.08], ["este", 0.25], ["otro", 0.61], ["aparece", 1.03], ["el", 1.57], ["conejo", 1.69], ["con", 2.74], ["tres", 2.99], ["orejas", 3.28], ["que", 3.81], ["se", 3.94], ["tocan", 4.12], ["en", 4.56], ["un", 4.71], ["punto", 4.89], ["Mira", 5.88], ["la", 6.22], ["antena", 6.38], ["del", 6.81], ["bulbo", 7.01], ["también", 8.0], ["tiene", 8.53], ["tres", 8.86], ["brazos", 9.18]]}, {"texto": "Y en este, cinco brazos. El mapa nos dice cuántos brazos tendrá cada mundo.", "fin": 6.39, "palabras": [["Y", 0.1], ["en", 0.22], ["este", 0.39], ["cinco", 1.33], ["brazos", 1.81], ["El", 2.94], ["mapa", 3.11], ["nos", 3.43], ["dice", 3.67], ["cuántos", 4.0], ["brazos", 4.49], ["tendrá", 5.06], ["cada", 5.49], ["mundo", 5.83]]}, {"texto": "Fuera del mapa, en cambio, cada mundo se rompe en polvo.", "fin": 4.68, "palabras": [["Fuera", 0.1], ["del", 0.44], ["mapa", 0.67], ["en", 1.49], ["cambio", 1.71], ["cada", 2.68], ["mundo", 2.96], ["se", 3.33], ["rompe", 3.51], ["en", 3.97], ["polvo", 4.12]]}, {"texto": "Y en la frontera ocurre algo más profundo. Acerquémonos al mapa y a su mundo en el mismo punto.", "fin": 7.22, "palabras": [["Y", 0.1], ["en", 0.21], ["la", 0.33], ["frontera", 0.46], ["ocurre", 1.07], ["algo", 1.64], ["más", 1.99], ["profundo", 2.33], ["Acerquémonos", 3.49], ["al", 4.33], ["mapa", 4.49], ["y", 4.99], ["a", 5.17], ["su", 5.25], ["mundo", 5.43], ["en", 5.94], ["el", 6.08], ["mismo", 6.24], ["punto", 6.64]]}, {"texto": "Es la misma forma. La matemática Tan Lei lo demostró en mil novecientos noventa: en esos puntos del borde, el mapa se parece al mundo que describe.", "fin": 10.85, "palabras": [["Es", 0.1], ["la", 0.33], ["misma", 0.51], ["forma", 0.96], ["La", 1.97], ["matemática", 2.14], ["Tan", 2.88], ["Lei", 3.12], ["lo", 3.36], ["demostró", 3.47], ["en", 4.07], ["mil", 4.19], ["novecientos", 4.43], ["noventa", 5.11], ["en", 6.32], ["esos", 6.49], ["puntos", 6.83], ["del", 7.25], ["borde", 7.42], ["el", 8.29], ["mapa", 8.46], ["se", 8.78], ["parece", 8.97], ["al", 9.43], ["mundo", 9.58], ["que", 9.99], ["describe", 10.12]]}, {"texto": "Por eso decimos que es el mapa de todos esos mundos.", "fin": 3.69, "palabras": [["Por", 0.1], ["eso", 0.25], ["decimos", 0.5], ["que", 1.12], ["es", 1.31], ["el", 1.49], ["mapa", 1.64], ["de", 2.0], ["todos", 2.19], ["esos", 2.69], ["mundos", 3.06]]}, {"texto": "Dentro, cada mundo es algo: una sola pieza. Fuera, cada mundo es casi nada: un polvo.", "fin": 8.42, "palabras": [["Dentro", 0.08], ["cada", 1.11], ["mundo", 1.39], ["es", 1.82], ["algo", 2.01], ["una", 2.93], ["sola", 3.18], ["pieza", 3.56], ["Fuera", 4.58], ["cada", 5.53], ["mundo", 5.81], ["es", 6.21], ["casi", 6.38], ["nada", 6.74], ["un", 7.67], ["polvo", 7.86]]}, {"texto": "Y la frontera es la línea exacta donde el algo se rompe en nada.", "fin": 4.29, "palabras": [["Y", 0.08], ["la", 0.17], ["frontera", 0.32], ["es", 0.94], ["la", 1.1], ["línea", 1.22], ["exacta", 1.61], ["donde", 2.21], ["el", 2.54], ["algo", 2.68], ["se", 3.01], ["rompe", 3.19], ["en", 3.67], ["nada", 3.81]]}, {"texto": "Ahí, entre la nada y el algo, vive toda la complejidad que acabamos de ver.", "fin": 5.88, "palabras": [["Ahí", 0.08], ["entre", 0.86], ["la", 1.21], ["nada", 1.33], ["y", 1.72], ["el", 1.85], ["algo", 2.0], ["vive", 2.94], ["toda", 3.26], ["la", 3.61], ["complejidad", 3.74], ["que", 4.6], ["acabamos", 4.74], ["de", 5.39], ["ver", 5.49]]}, {"texto": "Acerquémonos a un solo punto de esa frontera, y no nos detengamos.", "fin": 5.06, "palabras": [["Acerquémonos", 0.08], ["a", 0.96], ["un", 1.04], ["solo", 1.22], ["punto", 1.57], ["de", 2.0], ["esa", 2.21], ["frontera", 2.47], ["y", 3.6], ["no", 3.69], ["nos", 3.92], ["detengamos", 4.12]]}, {"texto": "Cada vuelta de la espiral se parece a la anterior, pero nunca es la misma. Podemos seguir acercándonos para siempre, y nunca llegaremos al fondo.", "fin": 10.61, "palabras": [["Cada", 0.08], ["vuelta", 0.35], ["de", 0.78], ["la", 0.92], ["espiral", 1.0], ["se", 1.6], ["parece", 1.78], ["a", 2.24], ["la", 2.29], ["anterior", 2.42], ["pero", 3.51], ["nunca", 3.75], ["es", 4.28], ["la", 4.44], ["misma", 4.57], ["Podemos", 5.58], ["seguir", 6.04], ["acercándonos", 6.42], ["para", 7.32], ["siempre", 7.54], ["y", 8.67], ["nunca", 8.76], ["llegaremos", 9.18], ["al", 9.9], ["fondo", 10.03]]}, {"texto": "Es un límite: nos acercamos cada vez más a un punto que jamás alcanzamos.", "fin": 5.71, "palabras": [["Es", 0.08], ["un", 0.31], ["límite", 0.46], ["nos", 1.58], ["acercamos", 1.78], ["cada", 2.44], ["vez", 2.74], ["más", 3.04], ["a", 3.39], ["un", 3.47], ["punto", 3.67], ["que", 4.11], ["jamás", 4.25], ["alcanzamos", 4.72]]}, {"texto": "Ese punto no tiene largo, ni área, ni forma. Es lo más parecido a la nada que puede existir. Y aun así, es algo: pertenece al conjunto.", "fin": 12.01, "palabras": [["Ese", 0.1], ["punto", 0.38], ["no", 0.79], ["tiene", 1.0], ["largo", 1.32], ["ni", 2.38], ["área", 2.56], ["ni", 3.5], ["forma", 3.62], ["Es", 4.64], ["lo", 4.85], ["más", 4.97], ["parecido", 5.25], ["a", 5.92], ["la", 5.97], ["nada", 6.1], ["que", 6.5], ["puede", 6.68], ["existir", 7.01], ["Y", 8.24], ["aun", 8.36], ["así", 8.6], ["es", 9.44], ["algo", 9.65], ["pertenece", 10.44], ["al", 11.12], ["conjunto", 11.25]]}, {"texto": "En mil setecientos catorce, Láibnitz escribió la pregunta más difícil de todas: ¿por qué hay algo, y no más bien nada?", "fin": 8.56, "palabras": [["En", 0.1], ["mil", 0.25], ["setecientos", 0.49], ["catorce", 1.19], ["Láibnitz", 2.28], ["escribió", 2.88], ["la", 3.43], ["pregunta", 3.56], ["más", 4.11], ["difícil", 4.43], ["de", 4.97], ["todas", 5.11], ["por", 6.1], ["qué", 6.32], ["hay", 6.46], ["algo", 6.67], ["y", 7.4], ["no", 7.5], ["más", 7.67], ["bien", 7.9], ["nada", 8.14]]}, {"texto": "Nadie sabe responderla. Pero el mismo Láibnitz, en mil seiscientos noventa y siete, diseñó una medalla para su sistema binario: con solo el uno y el cero, quería mostrar cómo todo puede salir de la nada.", "fin": 14.58, "palabras": [["Nadie", 0.07], ["sabe", 0.56], ["responderla", 0.94], ["Pero", 2.38], ["el", 2.56], ["mismo", 2.67], ["Láibnitz", 3.01], ["en", 3.99], ["mil", 4.15], ["seiscientos", 4.4], ["noventa", 5.03], ["y", 5.42], ["siete", 5.49], ["diseñó", 6.46], ["una", 6.9], ["medalla", 7.11], ["para", 7.62], ["su", 7.86], ["sistema", 8.01], ["binario", 8.53], ["con", 9.56], ["solo", 9.78], ["el", 10.11], ["uno", 10.25], ["y", 10.5], ["el", 10.61], ["cero", 10.75], ["quería", 11.56], ["mostrar", 11.9], ["cómo", 12.43], ["todo", 12.74], ["puede", 13.15], ["salir", 13.47], ["de", 13.92], ["la", 14.01], ["nada", 14.12]]}, {"texto": "Volvamos entonces al cero, al vacío, y apliquemos la regla una sola vez.", "fin": 6.19, "palabras": [["Volvamos", 0.07], ["entonces", 0.71], ["al", 1.36], ["cero", 1.51], ["al", 2.38], ["vacío", 2.56], ["y", 3.65], ["apliquemos", 3.76], ["la", 4.49], ["regla", 4.62], ["una", 5.08], ["sola", 5.36], ["vez", 5.71]]}, {"texto": "Con un paso aparece un círculo. Con diez pasos aparece una forma. Con infinitos pasos aparece una frontera infinita.", "fin": 9.54, "palabras": [["Con", 0.08], ["un", 0.26], ["paso", 0.43], ["aparece", 0.93], ["un", 1.58], ["círculo", 1.78], ["Con", 2.9], ["diez", 3.11], ["pasos", 3.43], ["aparece", 4.0], ["una", 4.61], ["forma", 4.86], ["Con", 5.89], ["infinitos", 6.07], ["pasos", 6.74], ["aparece", 7.31], ["una", 7.92], ["frontera", 8.19], ["infinita", 8.74]]}, {"texto": "Y cerca de cualquier punto de esa frontera, por pequeño que sea el trozo, el conjunto entero vuelve a aparecer.", "fin": 7.92, "palabras": [["Y", 0.08], ["cerca", 0.18], ["de", 0.58], ["cualquier", 0.72], ["punto", 1.25], ["de", 1.67], ["esa", 1.86], ["frontera", 2.11], ["por", 3.19], ["pequeño", 3.39], ["que", 3.9], ["sea", 4.04], ["el", 4.33], ["trozo", 4.47], ["el", 5.36], ["conjunto", 5.54], ["entero", 6.11], ["vuelve", 6.6], ["a", 7.06], ["aparecer", 7.17]]}, {"texto": "Lo que parecía casi nada contiene otra vez el todo, y así sin fin.", "fin": 5.1, "palabras": [["Lo", 0.08], ["que", 0.25], ["parecía", 0.39], ["casi", 0.92], ["nada", 1.33], ["contiene", 1.69], ["otra", 2.26], ["vez", 2.57], ["el", 2.85], ["todo", 3.01], ["y", 3.94], ["así", 4.07], ["sin", 4.4], ["fin", 4.67]]}, {"texto": "Quizá esa sea la respuesta del fractal a la pregunta de Láibnitz: en la frontera entre la nada y el algo, el vacío nunca está del todo vacío.", "fin": 9.74, "palabras": [["Quizá", 0.08], ["esa", 0.49], ["sea", 0.74], ["la", 1.04], ["respuesta", 1.18], ["del", 1.81], ["fractal", 2.0], ["a", 2.54], ["la", 2.6], ["pregunta", 2.72], ["de", 3.26], ["Láibnitz", 3.4], ["en", 4.71], ["la", 4.83], ["frontera", 4.93], ["entre", 5.44], ["la", 5.71], ["nada", 5.83], ["y", 6.22], ["el", 6.35], ["algo", 6.47], ["el", 7.24], ["vacío", 7.4], ["nunca", 7.83], ["está", 8.25], ["del", 8.54], ["todo", 8.79], ["vacío", 9.11]]}, {"texto": "Toma una línea de largo uno. Quítale el tercio del medio. Y vuelve a hacerlo con cada pedazo que queda, una y otra vez.", "fin": 9.36, "palabras": [["Toma", 0.1], ["una", 0.4], ["línea", 0.67], ["de", 1.12], ["largo", 1.28], ["uno", 1.71], ["Quítale", 2.61], ["el", 3.12], ["tercio", 3.33], ["del", 3.79], ["medio", 4.0], ["Y", 4.96], ["vuelve", 5.06], ["a", 5.44], ["hacerlo", 5.53], ["con", 6.03], ["cada", 6.26], ["pedazo", 6.56], ["que", 7.06], ["queda", 7.21], ["una", 8.22], ["y", 8.5], ["otra", 8.64], ["vez", 8.9]]}, {"texto": "En cada paso, el largo total se reduce: dos tercios, cuatro novenos, ocho veintisieteavos. En el límite, el largo es cero.", "fin": 10.94, "palabras": [["En", 0.08], ["cada", 0.28], ["paso", 0.57], ["el", 1.43], ["largo", 1.61], ["total", 1.94], ["se", 2.4], ["reduce", 2.57], ["dos", 3.54], ["tercios", 3.82], ["cuatro", 4.89], ["novenos", 5.26], ["ocho", 6.33], ["veintisieteavos", 6.64], ["En", 8.26], ["el", 8.42], ["límite", 8.57], ["el", 9.65], ["largo", 9.83], ["es", 10.29], ["cero", 10.44]]}, {"texto": "Pero aun así, el conjunto no desaparece.", "fin": 3.46, "palabras": [["Pero", 0.1], ["aun", 0.36], ["así", 0.58], ["el", 1.44], ["conjunto", 1.6], ["no", 2.26], ["desaparece", 2.53]]}, {"texto": "Quedan infinitos puntos. Tantos como en la línea completa.", "fin": 4.51, "palabras": [["Quedan", 0.1], ["infinitos", 0.43], ["puntos", 1.15], ["Tantos", 2.28], ["como", 2.72], ["en", 3.08], ["la", 3.19], ["línea", 3.31], ["completa", 3.74]]}, {"texto": "Un conjunto de largo cero puede tener tantos puntos como una línea entera.", "fin": 5.08, "palabras": [["Un", 0.08], ["conjunto", 0.25], ["de", 0.86], ["largo", 0.99], ["cero", 1.33], ["puede", 1.75], ["tener", 2.1], ["tantos", 2.49], ["puntos", 2.97], ["como", 3.5], ["una", 3.78], ["línea", 4.03], ["entera", 4.49]]}, {"texto": "El polvo de los mundos rotos tiene esta misma estructura, aunque su forma sea otra. Casi nada, y a la vez, infinito.", "fin": 9.64, "palabras": [["El", 0.08], ["polvo", 0.26], ["de", 0.62], ["los", 0.75], ["mundos", 0.96], ["rotos", 1.36], ["tiene", 1.88], ["esta", 2.22], ["misma", 2.51], ["estructura", 2.92], ["aunque", 4.12], ["su", 4.43], ["forma", 4.6], ["sea", 5.03], ["otra", 5.46], ["Casi", 6.39], ["nada", 6.72], ["y", 7.62], ["a", 7.75], ["la", 7.83], ["vez", 7.96], ["infinito", 8.83]]}, {"texto": "Fuera del conjunto, toda órbita termina escapando.", "fin": 4.12, "palabras": [["Fuera", 0.1], ["del", 0.44], ["conjunto", 0.65], ["toda", 1.9], ["órbita", 2.28], ["termina", 2.79], ["escapando", 3.32]]}, {"texto": "Pero cerca de la frontera, ese escape tarda cada vez más: cien vueltas, después mil, después diez mil.", "fin": 8.31, "palabras": [["Pero", 0.1], ["cerca", 0.29], ["de", 0.67], ["la", 0.78], ["frontera", 0.89], ["ese", 1.92], ["escape", 2.18], ["tarda", 2.67], ["cada", 3.07], ["vez", 3.44], ["más", 3.72], ["cien", 4.64], ["vueltas", 5.01], ["después", 5.96], ["mil", 6.4], ["después", 7.11], ["diez", 7.64], ["mil", 7.9]]}, {"texto": "Y en la frontera misma, el punto ya pertenece al conjunto: nunca escapa.", "fin": 5.64, "palabras": [["Y", 0.08], ["en", 0.22], ["la", 0.35], ["frontera", 0.47], ["misma", 0.97], ["el", 1.86], ["punto", 2.06], ["ya", 2.42], ["pertenece", 2.64], ["al", 3.32], ["conjunto", 3.44], ["nunca", 4.56], ["escapa", 4.97]]}, {"texto": "La matemática sigue funcionando en ese borde. Lo que deja de bastar es nuestra intuición.", "fin": 6.43, "palabras": [["La", 0.08], ["matemática", 0.24], ["sigue", 0.97], ["funcionando", 1.35], ["en", 2.25], ["ese", 2.44], ["borde", 2.72], ["Lo", 3.68], ["que", 3.86], ["deja", 4.0], ["de", 4.32], ["bastar", 4.44], ["es", 5.0], ["nuestra", 5.21], ["intuición", 5.6]]}, {"texto": "La frontera del conjunto de Mandelbrót tiene dimensión de Jáusdorf dos. La misma dimensión que el plano.", "fin": 7.58, "palabras": [["La", 0.08], ["frontera", 0.25], ["del", 0.75], ["conjunto", 0.94], ["de", 1.56], ["Mandelbrót", 1.68], ["tiene", 2.47], ["dimensión", 2.82], ["de", 3.49], ["Jáusdorf", 3.61], ["dos", 4.4], ["La", 5.38], ["misma", 5.57], ["dimensión", 5.96], ["que", 6.74], ["el", 6.89], ["plano", 7.04]]}, {"texto": "Pero dimensión y área son cosas distintas. Una frontera puede tener dimensión dos y, aun así, área cero.", "fin": 8.93, "palabras": [["Pero", 0.1], ["dimensión", 0.29], ["y", 1.01], ["área", 1.19], ["son", 1.54], ["cosas", 1.86], ["distintas", 2.29], ["Una", 3.58], ["frontera", 3.81], ["puede", 4.4], ["tener", 4.74], ["dimensión", 5.1], ["dos", 5.75], ["y", 6.15], ["aun", 6.81], ["así", 7.08], ["área", 8.04], ["cero", 8.42]]}, {"texto": "El conjunto tiene área, porque contiene regiones interiores. Pero su frontera…", "fin": 6.28, "palabras": [["El", 0.08], ["conjunto", 0.25], ["tiene", 0.89], ["área", 1.28], ["porque", 2.15], ["contiene", 2.49], ["regiones", 3.04], ["interiores", 3.71], ["Pero", 5.06], ["su", 5.31], ["frontera", 5.51]]}, {"texto": "¿Tiene área? Todavía no sabemos demostrar si es positiva o nula.", "fin": 5.19, "palabras": [["Tiene", 0.15], ["área", 0.44], ["Todavía", 1.4], ["no", 1.93], ["sabemos", 2.1], ["demostrar", 2.65], ["si", 3.33], ["es", 3.58], ["positiva", 3.78], ["o", 4.57], ["nula", 4.67]]}, {"texto": "Una figura perfectamente definida. Una propiedad demostrada. Y una pregunta que sigue abierta.", "fin": 7.65, "palabras": [["Una", 0.08], ["figura", 0.33], ["perfectamente", 0.85], ["definida", 1.89], ["Una", 3.12], ["propiedad", 3.39], ["demostrada", 4.07], ["Y", 5.39], ["una", 5.53], ["pregunta", 5.78], ["que", 6.38], ["sigue", 6.56], ["abierta", 6.96]]}, {"texto": "Largo cero, e infinitos puntos.", "fin": 2.96, "palabras": [["Largo", 0.08], ["cero", 0.49], ["e", 1.4], ["infinitos", 1.51], ["puntos", 2.28]]}, {"texto": "Una frontera con la dimensión de un plano, cuya área todavía no sabemos determinar.", "fin": 6.01, "palabras": [["Una", 0.08], ["frontera", 0.32], ["con", 0.9], ["la", 1.1], ["dimensión", 1.18], ["de", 1.83], ["un", 1.94], ["plano", 2.12], ["cuya", 3.06], ["área", 3.44], ["todavía", 3.75], ["no", 4.35], ["sabemos", 4.58], ["determinar", 5.18]]}, {"texto": "Entre la nada y el algo… cabe el infinito.", "fin": 3.43, "palabras": [["Entre", 0.1], ["la", 0.44], ["nada", 0.57], ["y", 0.97], ["el", 1.11], ["algo", 1.26], ["cabe", 2.17], ["el", 2.53], ["infinito", 2.65]]}]