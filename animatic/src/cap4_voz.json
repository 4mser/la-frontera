[{"texto": "Al final del capítulo anterior quedaron tres formas: un mineral que crece como un pequeño árbol, los vasos que alimentan el ojo y los ríos de una montaña vistos desde el espacio.", "fin": 11.9, "palabras": [["Al", 0.08], ["final", 0.24], ["del", 0.6], ["capítulo", 0.76], ["anterior", 1.32], ["quedaron", 1.88], ["tres", 2.36], ["formas", 2.64], ["un", 3.79], ["mineral", 3.9], ["que", 4.4], ["crece", 4.54], ["como", 4.93], ["un", 5.19], ["pequeño", 5.35], ["árbol", 5.86], ["los", 6.81], ["vasos", 7.0], ["que", 7.4], ["alimentan", 7.51], ["el", 8.08], ["ojo", 8.24], ["y", 8.61], ["los", 8.69], ["ríos", 8.94], ["de", 9.36], ["una", 9.47], ["montaña", 9.69], ["vistos", 10.25], ["desde", 10.81], ["el", 11.11], ["espacio", 11.21]]}, {"texto": "Se parecen tanto que es fácil pensar que las produce una misma ley. Para saberlo, hay que verlas crecer.", "fin": 7.71, "palabras": [["Se", 0.08], ["parecen", 0.31], ["tanto", 0.83], ["que", 1.19], ["es", 1.38], ["fácil", 1.53], ["pensar", 1.96], ["que", 2.49], ["las", 2.62], ["produce", 2.83], ["una", 3.39], ["misma", 3.64], ["ley", 4.04], ["Para", 4.89], ["saberlo", 5.1], ["hay", 6.24], ["que", 6.43], ["verlas", 6.6], ["crecer", 7.08]]}, {"texto": "En mil novecientos ochenta y uno, dos físicos, Tómas Uíten y Léonard Sánder, propusieron un juego muy simple.", "fin": 8.37, "palabras": [["En", 0.1], ["mil", 0.25], ["novecientos", 0.47], ["ochenta", 1.12], ["y", 1.53], ["uno", 1.64], ["dos", 2.35], ["físicos", 2.58], ["Tómas", 3.69], ["Uíten", 4.08], ["y", 4.6], ["Léonard", 4.69], ["Sánder", 5.22], ["propusieron", 6.19], ["un", 6.9], ["juego", 7.06], ["muy", 7.47], ["simple", 7.78]]}, {"texto": "En el centro hay una partícula fija. Desde lejos llega otra, que vaga al azar, sin rumbo, hasta que toca a la primera y se queda pegada.", "fin": 10.54, "palabras": [["En", 0.1], ["el", 0.25], ["centro", 0.4], ["hay", 0.97], ["una", 1.22], ["partícula", 1.44], ["fija", 2.12], ["Desde", 3.11], ["lejos", 3.44], ["llega", 3.88], ["otra", 4.25], ["que", 5.06], ["vaga", 5.19], ["al", 5.51], ["azar", 5.62], ["sin", 6.49], ["rumbo", 6.79], ["hasta", 7.69], ["que", 8.01], ["toca", 8.18], ["a", 8.54], ["la", 8.58], ["primera", 8.72], ["y", 9.28], ["se", 9.36], ["queda", 9.56], ["pegada", 9.9]]}, {"texto": "Luego llega otra, y después otra más. Cada una camina a ciegas y se detiene en cuanto roza el grupo.", "fin": 7.85, "palabras": [["Luego", 0.08], ["llega", 0.49], ["otra", 0.92], ["y", 1.76], ["después", 1.85], ["otra", 2.43], ["más", 2.71], ["Cada", 3.61], ["una", 3.92], ["camina", 4.14], ["a", 4.61], ["ciegas", 4.67], ["y", 5.36], ["se", 5.47], ["detiene", 5.64], ["en", 6.18], ["cuanto", 6.35], ["roza", 6.75], ["el", 7.18], ["grupo", 7.31]]}, {"texto": "Con miles de partículas aparece una forma que nadie dibujó: ramas que se abren y se vuelven a abrir.", "fin": 7.28, "palabras": [["Con", 0.08], ["miles", 0.25], ["de", 0.6], ["partículas", 0.71], ["aparece", 1.53], ["una", 2.07], ["forma", 2.29], ["que", 2.71], ["nadie", 2.88], ["dibujó", 3.29], ["ramas", 4.65], ["que", 5.11], ["se", 5.24], ["abren", 5.46], ["y", 5.92], ["se", 6.01], ["vuelven", 6.19], ["a", 6.65], ["abrir", 6.76]]}, {"texto": "La razón es sencilla. Una partícula que vaga desde lejos tropieza antes con las puntas que con los huecos. Las puntas crecen, y los huecos quedan protegidos detrás de ellas.", "fin": 12.78, "palabras": [["La", 0.08], ["razón", 0.26], ["es", 0.75], ["sencilla", 0.89], ["Una", 2.08], ["partícula", 2.31], ["que", 2.99], ["vaga", 3.14], ["desde", 3.46], ["lejos", 3.79], ["tropieza", 4.28], ["antes", 4.96], ["con", 5.38], ["las", 5.56], ["puntas", 5.76], ["que", 6.26], ["con", 6.4], ["los", 6.6], ["huecos", 6.79], ["Las", 7.83], ["puntas", 8.11], ["crecen", 8.56], ["y", 9.62], ["los", 9.68], ["huecos", 9.93], ["quedan", 10.38], ["protegidos", 10.74], ["detrás", 11.53], ["de", 12.0], ["ellas", 12.19]]}, {"texto": "Modelos basados en la difusión se han usado para explicar las dendritas de manganeso que aparecen en las grietas de algunas rocas: el mineral disuelto avanza por el agua y precipita sobre lo que ya creció.", "fin": 12.96, "palabras": [["Modelos", 0.07], ["basados", 0.56], ["en", 1.14], ["la", 1.22], ["difusión", 1.31], ["se", 1.97], ["han", 2.14], ["usado", 2.26], ["para", 2.74], ["explicar", 2.94], ["las", 3.56], ["dendritas", 3.75], ["de", 4.33], ["manganeso", 4.43], ["que", 5.12], ["aparecen", 5.26], ["en", 5.86], ["las", 5.97], ["grietas", 6.15], ["de", 6.69], ["algunas", 6.79], ["rocas", 7.28], ["el", 8.44], ["mineral", 8.6], ["disuelto", 9.03], ["avanza", 9.6], ["por", 10.06], ["el", 10.25], ["agua", 10.39], ["y", 10.74], ["precipita", 10.81], ["sobre", 11.53], ["lo", 11.88], ["que", 12.0], ["ya", 12.12], ["creció", 12.35]]}, {"texto": "Un río crece de otra manera. Imaginemos un terreno con pequeñas irregularidades, y una lluvia que cae pareja sobre todo él.", "fin": 9.42, "palabras": [["Un", 0.08], ["río", 0.29], ["crece", 0.65], ["de", 1.12], ["otra", 1.32], ["manera", 1.65], ["Imaginemos", 2.68], ["un", 3.43], ["terreno", 3.57], ["con", 4.07], ["pequeñas", 4.29], ["irregularidades", 4.89], ["y", 6.49], ["una", 6.6], ["lluvia", 6.82], ["que", 7.26], ["cae", 7.43], ["pareja", 7.76], ["sobre", 8.28], ["todo", 8.67], ["él", 9.07]]}, {"texto": "El agua baja por la pendiente y se junta en las partes más bajas. Donde se junta más agua, la corriente es más fuerte y excava más.", "fin": 9.76, "palabras": [["El", 0.08], ["agua", 0.26], ["baja", 0.54], ["por", 0.9], ["la", 1.1], ["pendiente", 1.22], ["y", 1.99], ["se", 2.11], ["junta", 2.28], ["en", 2.74], ["las", 2.83], ["partes", 3.04], ["más", 3.54], ["bajas", 3.86], ["Donde", 4.92], ["se", 5.25], ["junta", 5.39], ["más", 5.78], ["agua", 6.06], ["la", 6.94], ["corriente", 7.06], ["es", 7.67], ["más", 7.83], ["fuerte", 8.1], ["y", 8.65], ["excava", 8.82], ["más", 9.28]]}, {"texto": "Ese surco más hondo atrae todavía más agua. Así, poco a poco, el terreno se organiza en una red de cauces que drena cada rincón.", "fin": 10.18, "palabras": [["Ese", 0.08], ["surco", 0.36], ["más", 0.79], ["hondo", 1.14], ["atrae", 1.42], ["todavía", 1.9], ["más", 2.5], ["agua", 2.86], ["Así", 3.78], ["poco", 4.62], ["a", 4.93], ["poco", 5.0], ["el", 5.86], ["terreno", 6.06], ["se", 6.5], ["organiza", 6.67], ["en", 7.29], ["una", 7.4], ["red", 7.64], ["de", 7.89], ["cauces", 8.01], ["que", 8.58], ["drena", 8.72], ["cada", 9.11], ["rincón", 9.49]]}, {"texto": "Aquí nadie llega desde afuera. La forma la decide el propio relieve, que se va gastando por donde corre el agua.", "fin": 8.15, "palabras": [["Aquí", 0.1], ["nadie", 0.43], ["llega", 0.88], ["desde", 1.29], ["afuera", 1.64], ["La", 2.67], ["forma", 2.83], ["la", 3.22], ["decide", 3.35], ["el", 3.88], ["propio", 4.03], ["relieve", 4.44], ["que", 5.49], ["se", 5.61], ["va", 5.76], ["gastando", 5.9], ["por", 6.57], ["donde", 6.81], ["corre", 7.11], ["el", 7.54], ["agua", 7.68]]}, {"texto": "Al estudiar redes de drenaje reales, se encontró que su estructura se parece mucho a la de redes que gastan la menor energía posible para llevar el agua hasta el mar.", "fin": 10.25, "palabras": [["Al", 0.08], ["estudiar", 0.24], ["redes", 0.75], ["de", 1.17], ["drenaje", 1.26], ["reales", 1.78], ["se", 2.72], ["encontró", 2.9], ["que", 3.43], ["su", 3.57], ["estructura", 3.71], ["se", 4.38], ["parece", 4.54], ["mucho", 4.94], ["a", 5.39], ["la", 5.43], ["de", 5.54], ["redes", 5.68], ["que", 6.17], ["gastan", 6.31], ["la", 6.76], ["menor", 6.86], ["energía", 7.22], ["posible", 7.76], ["para", 8.36], ["llevar", 8.61], ["el", 8.99], ["agua", 9.15], ["hasta", 9.51], ["el", 9.78], ["mar.", 9.89]]}, {"texto": "Los vasos de un tejido responden a otra necesidad. Cada célula necesita oxígeno, y ninguna puede estar demasiado lejos de un vaso.", "fin": 9.96, "palabras": [["Los", 0.08], ["vasos", 0.33], ["de", 0.75], ["un", 0.86], ["tejido", 1.01], ["responden", 1.56], ["a", 2.32], ["otra", 2.49], ["necesidad", 2.82], ["Cada", 4.11], ["célula", 4.38], ["necesita", 4.89], ["oxígeno", 5.56], ["y", 6.64], ["ninguna", 6.74], ["puede", 7.25], ["estar", 7.56], ["demasiado", 7.94], ["lejos", 8.61], ["de", 9.12], ["un", 9.25], ["vaso", 9.44]]}, {"texto": "Cuando una zona recibe poco oxígeno, sus células liberan señales químicas, y los vasos cercanos brotan y crecen hacia ellas.", "fin": 9.14, "palabras": [["Cuando", 0.1], ["una", 0.4], ["zona", 0.64], ["recibe", 0.99], ["poco", 1.47], ["oxígeno", 1.83], ["sus", 2.97], ["células", 3.18], ["liberan", 3.72], ["señales", 4.17], ["químicas", 4.71], ["y", 5.82], ["los", 5.9], ["vasos", 6.14], ["cercanos", 6.5], ["brotan", 7.11], ["y", 7.64], ["crecen", 7.76], ["hacia", 8.22], ["ellas", 8.58]]}, {"texto": "En la simulación, cada punto es un lugar que todavía necesita ser alcanzado. El árbol crece hacia los puntos cercanos, y cada punto se apaga cuando una rama llega hasta él.", "fin": 12.64, "palabras": [["En", 0.08], ["la", 0.24], ["simulación", 0.33], ["cada", 1.64], ["punto", 1.93], ["es", 2.39], ["un", 2.54], ["lugar", 2.67], ["que", 3.1], ["todavía", 3.26], ["necesita", 3.79], ["ser", 4.5], ["alcanzado", 4.76], ["El", 6.04], ["árbol", 6.22], ["crece", 6.58], ["hacia", 7.01], ["los", 7.26], ["puntos", 7.49], ["cercanos", 7.88], ["y", 9.03], ["cada", 9.12], ["punto", 9.43], ["se", 9.83], ["apaga", 10.0], ["cuando", 10.46], ["una", 10.85], ["rama", 11.12], ["llega", 11.5], ["hasta", 11.93], ["él", 12.31]]}, {"texto": "El resultado es un árbol que llena el espacio sin cruzarse consigo mismo, y que se detiene cuando ya no queda nada por alcanzar.", "fin": 8.4, "palabras": [["El", 0.08], ["resultado", 0.24], ["es", 0.9], ["un", 1.06], ["árbol", 1.21], ["que", 1.6], ["llena", 1.72], ["el", 2.07], ["espacio", 2.17], ["sin", 2.72], ["cruzarse", 2.94], ["consigo", 3.57], ["mismo", 4.1], ["y", 5.08], ["que", 5.18], ["se", 5.32], ["detiene", 5.46], ["cuando", 5.99], ["ya", 6.35], ["no", 6.56], ["queda", 6.72], ["nada", 7.04], ["por", 7.44], ["alcanzar", 7.65]]}, {"texto": "Tres formas ramificadas y tres mecanismos distintos: partículas que se pegan, agua que excava y tejidos que piden oxígeno.", "fin": 8.82, "palabras": [["Tres", 0.1], ["formas", 0.36], ["ramificadas", 0.81], ["y", 1.69], ["tres", 1.82], ["mecanismos", 2.14], ["distintos", 2.82], ["partículas", 3.97], ["que", 4.68], ["se", 4.79], ["pegan", 4.96], ["agua", 5.89], ["que", 6.15], ["excava", 6.29], ["y", 6.79], ["tejidos", 6.89], ["que", 7.49], ["piden", 7.65], ["oxígeno", 8.07]]}, {"texto": "Si medimos su dimensión contando cuántas cajas hacen falta para cubrirlas a distintas escalas, obtenemos tres números diferentes.", "fin": 9.08, "palabras": [["Si", 0.08], ["medimos", 0.29], ["su", 0.74], ["dimensión", 0.85], ["contando", 1.51], ["cuántas", 2.06], ["cajas", 2.54], ["hacen", 3.08], ["falta", 3.42], ["para", 3.85], ["cubrirlas", 4.1], ["a", 4.76], ["distintas", 4.82], ["escalas", 5.5], ["obtenemos", 6.65], ["tres", 7.33], ["números", 7.69], ["diferentes", 8.21]]}, {"texto": "Y aunque dos de esos números coincidieran, eso no nos diría nada sobre la causa. Una dimensión describe cómo una forma ocupa el espacio; su origen hay que buscarlo en otra parte.", "fin": 12.97, "palabras": [["Y", 0.08], ["aunque", 0.21], ["dos", 0.54], ["de", 0.82], ["esos", 1.0], ["números", 1.35], ["coincidieran", 1.82], ["eso", 3.29], ["no", 3.54], ["nos", 3.72], ["diría", 3.94], ["nada", 4.36], ["sobre", 4.79], ["la", 5.14], ["causa", 5.26], ["Una", 6.31], ["dimensión", 6.51], ["describe", 7.1], ["cómo", 7.69], ["una", 7.97], ["forma", 8.21], ["ocupa", 8.64], ["el", 9.07], ["espacio", 9.17], ["su", 10.39], ["origen", 10.56], ["hay", 11.03], ["que", 11.19], ["buscarlo", 11.32], ["en", 12.0], ["otra", 12.15], ["parte", 12.43]]}, {"texto": "Las formas que vimos al comienzo de esta historia tienen, cada una, su propia manera de crecer: el hielo que se forma desde el aire húmedo, el agua que desgasta la montaña, las plantas que siguen su propio programa.", "fin": 14.67, "palabras": [["Las", 0.08], ["formas", 0.32], ["que", 0.72], ["vimos", 0.85], ["al", 1.24], ["comienzo", 1.36], ["de", 1.9], ["esta", 2.08], ["historia", 2.31], ["tienen", 2.82], ["cada", 3.71], ["una", 4.03], ["su", 4.74], ["propia", 4.9], ["manera", 5.31], ["de", 5.71], ["crecer", 5.83], ["el", 7.06], ["hielo", 7.19], ["que", 7.49], ["se", 7.61], ["forma", 7.75], ["desde", 8.15], ["el", 8.47], ["aire", 8.6], ["húmedo", 8.9], ["el", 9.78], ["agua", 9.96], ["que", 10.25], ["desgasta", 10.39], ["la", 10.99], ["montaña", 11.08], ["las", 12.15], ["plantas", 12.36], ["que", 12.85], ["siguen", 12.97], ["su", 13.42], ["propio", 13.57], ["programa", 14.0]]}, {"texto": "La misma apariencia puede tener causas muy distintas. Para entender una forma, además de medirla, hay que saber qué la hizo crecer.", "fin": 9.69, "palabras": [["La", 0.08], ["misma", 0.25], ["apariencia", 0.61], ["puede", 1.33], ["tener", 1.67], ["causas", 2.03], ["muy", 2.61], ["distintas", 2.88], ["Para", 4.22], ["entender", 4.42], ["una", 4.93], ["forma", 5.12], ["además", 6.04], ["de", 6.54], ["medirla", 6.64], ["hay", 7.72], ["que", 7.9], ["saber", 8.04], ["qué", 8.47], ["la", 8.61], ["hizo", 8.76], ["crecer", 9.08]]}, {"texto": "Pero hay formas que no se ven en el espacio. Se despliegan en el tiempo, latido a latido.", "fin": 6.94, "palabras": [["Pero", 0.1], ["hay", 0.33], ["formas", 0.49], ["que", 1.06], ["no", 1.19], ["se", 1.42], ["ven", 1.6], ["en", 1.86], ["el", 2.0], ["espacio", 2.14], ["Se", 3.31], ["despliegan", 3.5], ["en", 4.24], ["el", 4.38], ["tiempo", 4.56], ["latido", 5.65], ["a", 6.24], ["latido", 6.29]]}]