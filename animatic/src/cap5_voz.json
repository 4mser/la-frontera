[{"texto": "¿Debería un corazón sano latir como un reloj, siempre al mismo tiempo? Casi todos diríamos que sí.", "fin": 7.68, "palabras": [["Debería", 0.15], ["un", 0.6], ["corazón", 0.74], ["sano", 1.36], ["latir", 1.72], ["como", 2.19], ["un", 2.47], ["reloj", 2.65], ["siempre", 3.74], ["al", 4.22], ["mismo", 4.35], ["tiempo", 4.71], ["Casi", 5.72], ["todos", 6.08], ["diríamos", 6.54], ["que", 7.17], ["sí", 7.29]]}, {"texto": "Hasta ahora, los fractales de esta historia fueron formas en el espacio: costas, fronteras, ramas. Pero también puede haber estructura dentro de estructura en el tiempo.", "fin": 12.87, "palabras": [["Hasta", 0.1], ["ahora", 0.47], ["los", 1.39], ["fractales", 1.56], ["de", 2.18], ["esta", 2.35], ["historia", 2.57], ["fueron", 3.12], ["formas", 3.5], ["en", 4.0], ["el", 4.11], ["espacio", 4.24], ["costas", 5.47], ["fronteras", 6.47], ["ramas", 7.67], ["Pero", 8.78], ["también", 8.99], ["puede", 9.47], ["haber", 9.76], ["estructura", 10.01], ["dentro", 10.69], ["de", 11.11], ["estructura", 11.22], ["en", 12.0], ["el", 12.12], ["tiempo", 12.29]]}, {"texto": "Al comienzo de esta historia escuchamos un corazón. Era el registro real de una persona sana, guardado en una base de datos pública de investigación.", "fin": 10.76, "palabras": [["Al", 0.08], ["comienzo", 0.25], ["de", 0.81], ["esta", 1.0], ["historia", 1.25], ["escuchamos", 1.9], ["un", 2.71], ["corazón", 2.86], ["Era", 4.0], ["el", 4.24], ["registro", 4.36], ["real", 4.96], ["de", 5.39], ["una", 5.51], ["persona", 5.75], ["sana", 6.25], ["guardado", 7.26], ["en", 7.82], ["una", 7.94], ["base", 8.15], ["de", 8.5], ["datos", 8.64], ["pública", 9.11], ["de", 9.6], ["investigación", 9.72]]}, {"texto": "Si en vez de escucharlo anotamos cuánto dura cada intervalo entre un latido y el siguiente, aparece una línea que nunca está quieta.", "fin": 8.68, "palabras": [["Si", 0.08], ["en", 0.32], ["vez", 0.46], ["de", 0.68], ["escucharlo", 0.76], ["anotamos", 1.47], ["cuánto", 2.11], ["dura", 2.47], ["cada", 2.75], ["intervalo", 3.03], ["entre", 3.68], ["un", 3.97], ["latido", 4.1], ["y", 4.58], ["el", 4.68], ["siguiente", 4.81], ["aparece", 5.99], ["una", 6.53], ["línea", 6.74], ["que", 7.18], ["nunca", 7.35], ["está", 7.78], ["quieta", 8.08]]}, {"texto": "Un metrónomo marcaría siempre el mismo tiempo. Un corazón sano acelera y frena sin parar, incluso cuando estamos en reposo.", "fin": 9.54, "palabras": [["Un", 0.08], ["metrónomo", 0.24], ["marcaría", 0.89], ["siempre", 1.56], ["el", 2.12], ["mismo", 2.28], ["tiempo", 2.68], ["Un", 3.71], ["corazón", 3.89], ["sano", 4.51], ["acelera", 4.86], ["y", 5.49], ["frena", 5.58], ["sin", 5.99], ["parar", 6.22], ["incluso", 7.25], ["cuando", 7.83], ["estamos", 8.15], ["en", 8.74], ["reposo", 8.86]]}, {"texto": "Este es un día casi completo de esa persona: más de cien mil latidos.", "fin": 5.19, "palabras": [["Este", 0.08], ["es", 0.43], ["un", 0.6], ["día", 0.74], ["casi", 1.0], ["completo", 1.38], ["de", 1.97], ["esa", 2.17], ["persona", 2.43], ["más", 3.58], ["de", 3.85], ["cien", 3.96], ["mil", 4.24], ["latidos", 4.46]]}, {"texto": "Hay horas en que el ritmo baja y horas en que sube, como en cualquier día con momentos de actividad y de descanso.", "fin": 7.22, "palabras": [["Hay", 0.08], ["horas", 0.32], ["en", 0.67], ["que", 0.82], ["el", 0.94], ["ritmo", 1.1], ["baja", 1.49], ["y", 1.88], ["horas", 2.03], ["en", 2.38], ["que", 2.51], ["sube", 2.64], ["como", 3.6], ["en", 3.85], ["cualquier", 3.96], ["día", 4.43], ["con", 4.71], ["momentos", 4.9], ["de", 5.46], ["actividad", 5.54], ["y", 6.24], ["de", 6.32], ["descanso", 6.43]]}, {"texto": "Acerquémonos a esta línea como nos acercamos a la curva de Koch, la que nunca se acaba.", "fin": 6.22, "palabras": [["Acerquémonos", 0.08], ["a", 0.97], ["esta", 1.11], ["línea", 1.39], ["como", 1.85], ["nos", 2.12], ["acercamos", 2.33], ["a", 3.1], ["la", 3.17], ["curva", 3.29], ["de", 3.67], ["Koch", 3.81], ["la", 4.78], ["que", 4.92], ["nunca", 5.07], ["se", 5.49], ["acaba", 5.65]]}, {"texto": "De un día a una hora, de una hora a unos minutos: en cada escala aparecen subidas dentro de subidas, igual de quebradas. Es una estructura fractal, pero en el tiempo.", "fin": 12.79, "palabras": [["De", 0.08], ["un", 0.26], ["día", 0.49], ["a", 0.83], ["una", 0.92], ["hora", 1.25], ["de", 1.96], ["una", 2.07], ["hora", 2.39], ["a", 2.68], ["unos", 2.76], ["minutos", 3.12], ["en", 4.17], ["cada", 4.35], ["escala", 4.6], ["aparecen", 5.11], ["subidas", 5.68], ["dentro", 6.25], ["de", 6.57], ["subidas", 6.69], ["igual", 7.71], ["de", 8.11], ["quebradas", 8.21], ["Es", 9.39], ["una", 9.61], ["estructura", 9.81], ["fractal", 10.49], ["pero", 11.62], ["en", 11.9], ["el", 12.01], ["tiempo", 12.18]]}, {"texto": "Hasta que llegamos a unos pocos latidos, y ahí se acaba. La curva matemática sigue sin fin; el corazón, como toda forma real, guarda esa estructura solo dentro de un rango de escalas.", "fin": 14.29, "palabras": [["Hasta", 0.08], ["que", 0.38], ["llegamos", 0.51], ["a", 1.11], ["unos", 1.21], ["pocos", 1.57], ["latidos", 1.96], ["y", 3.11], ["ahí", 3.25], ["se", 3.56], ["acaba", 3.74], ["La", 4.74], ["curva", 4.9], ["matemática", 5.25], ["sigue", 6.01], ["sin", 6.36], ["fin", 6.62], ["el", 7.61], ["corazón", 7.74], ["como", 8.65], ["toda", 8.92], ["forma", 9.24], ["real", 9.61], ["guarda", 10.54], ["esa", 10.97], ["estructura", 11.19], ["solo", 11.83], ["dentro", 12.25], ["de", 12.65], ["un", 12.79], ["rango", 13.01], ["de", 13.42], ["escalas", 13.54]]}, {"texto": "Para medir esa estructura, en mil novecientos noventa y cinco un equipo de Boston usó un método llamado análisis de fluctuaciones sin tendencia.", "fin": 9.17, "palabras": [["Para", 0.1], ["medir", 0.28], ["esa", 0.64], ["estructura", 0.86], ["en", 2.0], ["mil", 2.15], ["novecientos", 2.36], ["noventa", 2.99], ["y", 3.36], ["cinco", 3.43], ["un", 3.86], ["equipo", 4.01], ["de", 4.44], ["Boston", 4.56], ["usó", 5.08], ["un", 5.36], ["método", 5.51], ["llamado", 5.96], ["análisis", 6.49], ["de", 7.17], ["fluctuaciones", 7.26], ["sin", 8.17], ["tendencia", 8.39]]}, {"texto": "La idea es sencilla. Se corta la serie en ventanas del mismo tamaño, en cada una se quita la tendencia y se mide cuánto se aparta la línea de ella.", "fin": 10.5, "palabras": [["La", 0.08], ["idea", 0.26], ["es", 0.75], ["sencilla", 0.92], ["Se", 2.1], ["corta", 2.31], ["la", 2.67], ["serie", 2.81], ["en", 3.24], ["ventanas", 3.35], ["del", 3.93], ["mismo", 4.11], ["tamaño", 4.46], ["en", 5.49], ["cada", 5.68], ["una", 5.97], ["se", 6.19], ["quita", 6.36], ["la", 6.69], ["tendencia", 6.82], ["y", 7.58], ["se", 7.68], ["mide", 7.85], ["cuánto", 8.22], ["se", 8.58], ["aparta", 8.74], ["la", 9.24], ["línea", 9.38], ["de", 9.83], ["ella", 10.07]]}, {"texto": "Luego se repite con ventanas cada vez más grandes. Si los puntos caen sobre una recta en escala logarítmica, su inclinación es un número que llamamos alfa.", "fin": 11.29, "palabras": [["Luego", 0.08], ["se", 0.46], ["repite", 0.62], ["con", 1.12], ["ventanas", 1.33], ["cada", 2.01], ["vez", 2.36], ["más", 2.68], ["grandes", 2.97], ["Si", 4.11], ["los", 4.32], ["puntos", 4.56], ["caen", 4.97], ["sobre", 5.39], ["una", 5.71], ["recta", 5.94], ["en", 6.4], ["escala", 6.5], ["logarítmica", 6.96], ["su", 8.31], ["inclinación", 8.46], ["es", 9.25], ["un", 9.43], ["número", 9.57], ["que", 9.99], ["llamamos", 10.12], ["alfa", 10.76]]}, {"texto": "Es la misma herramienta que usó Ríchardson con las fronteras: medir a muchas escalas y mirar la inclinación.", "fin": 7.08, "palabras": [["Es", 0.08], ["la", 0.28], ["misma", 0.4], ["herramienta", 0.81], ["que", 1.43], ["usó", 1.6], ["Ríchardson", 1.9], ["con", 2.62], ["las", 2.79], ["fronteras", 2.94], ["medir", 4.07], ["a", 4.42], ["muchas", 4.47], ["escalas", 4.89], ["y", 5.58], ["mirar", 5.68], ["la", 6.08], ["inclinación", 6.18]]}, {"texto": "Para este corazón, en ventanas de cuatro a dieciséis latidos, alfa vale uno coma tres. En ventanas de dieciséis a sesenta y cuatro, uno coma cero cinco.", "fin": 12.33, "palabras": [["Para", 0.1], ["este", 0.35], ["corazón", 0.61], ["en", 1.68], ["ventanas", 1.79], ["de", 2.35], ["cuatro", 2.46], ["a", 2.94], ["dieciséis", 3.0], ["latidos", 3.72], ["alfa", 4.89], ["vale", 5.26], ["uno", 5.64], ["coma", 5.96], ["tres", 6.26], ["En", 7.24], ["ventanas", 7.4], ["de", 7.99], ["dieciséis", 8.08], ["a", 8.96], ["sesenta", 9.06], ["y", 9.51], ["cuatro", 9.6], ["uno", 10.65], ["coma", 10.93], ["cero", 11.32], ["cinco", 11.71]]}, {"texto": "Un ritmo completamente al azar daría un medio. Uno que solo deriva lentamente daría uno y medio. Este corazón queda cerca de uno, entre ambos extremos.", "fin": 11.92, "palabras": [["Un", 0.08], ["ritmo", 0.26], ["completamente", 0.67], ["al", 1.62], ["azar", 1.76], ["daría", 2.18], ["un", 2.62], ["medio", 2.79], ["Uno", 3.76], ["que", 4.01], ["solo", 4.15], ["deriva", 4.5], ["lentamente", 4.9], ["daría", 5.69], ["uno", 6.18], ["y", 6.54], ["medio", 6.62], ["Este", 7.62], ["corazón", 7.94], ["queda", 8.54], ["cerca", 8.88], ["de", 9.32], ["uno", 9.49], ["entre", 10.26], ["ambos", 10.67], ["extremos", 11.08]]}, {"texto": "Ahora otra persona, de otra base de datos: alguien con insuficiencia cardíaca congestiva.", "fin": 7.04, "palabras": [["Ahora", 0.08], ["otra", 0.54], ["persona", 0.82], ["de", 1.82], ["otra", 1.96], ["base", 2.28], ["de", 2.62], ["datos", 2.75], ["alguien", 3.93], ["con", 4.36], ["insuficiencia", 4.54], ["cardíaca", 5.46], ["congestiva", 6.14]]}, {"texto": "Su línea también varía, pero de otra manera. En las ventanas cortas, su alfa baja a uno coma cero siete. En las largas, sube a uno coma veintiséis.", "fin": 12.56, "palabras": [["Su", 0.08], ["línea", 0.31], ["también", 0.74], ["varía", 1.21], ["pero", 2.22], ["de", 2.49], ["otra", 2.65], ["manera", 2.99], ["En", 4.01], ["las", 4.15], ["ventanas", 4.35], ["cortas", 4.88], ["su", 5.86], ["alfa", 6.12], ["baja", 6.44], ["a", 6.85], ["uno", 6.96], ["coma", 7.26], ["cero", 7.62], ["siete", 8.0], ["En", 9.04], ["las", 9.19], ["largas", 9.4], ["sube", 10.39], ["a", 10.85], ["uno", 10.97], ["coma", 11.28], ["veintiséis", 11.61]]}, {"texto": "Dos personas no prueban nada. Por eso hicimos lo mismo con todos los registros de esas dos bases de datos: cincuenta y cuatro personas sanas y veintinueve con insuficiencia.", "fin": 12.15, "palabras": [["Dos", 0.06], ["personas", 0.4], ["no", 1.1], ["prueban", 1.33], ["nada", 1.82], ["Por", 2.75], ["eso", 2.9], ["hicimos", 3.14], ["lo", 3.64], ["mismo", 3.75], ["con", 4.17], ["todos", 4.43], ["los", 4.85], ["registros", 5.03], ["de", 5.68], ["esas", 5.88], ["dos", 6.31], ["bases", 6.6], ["de", 7.01], ["datos", 7.11], ["cincuenta", 8.06], ["y", 8.61], ["cuatro", 8.68], ["personas", 9.06], ["sanas", 9.58], ["y", 10.1], ["veintinueve", 10.19], ["con", 10.89], ["insuficiencia", 11.08]]}, {"texto": "Como grupo, los corazones sanos tienen un alfa corto más alto y un alfa largo más bajo. La diferencia es clara, y se mantiene al comparar personas de edades parecidas.", "fin": 12.56, "palabras": [["Como", 0.08], ["grupo", 0.33], ["los", 1.29], ["corazones", 1.47], ["sanos", 2.06], ["tienen", 2.53], ["un", 2.86], ["alfa", 3.01], ["corto", 3.33], ["más", 3.75], ["alto", 4.08], ["y", 4.58], ["un", 4.74], ["alfa", 4.92], ["largo", 5.24], ["más", 5.67], ["bajo", 6.0], ["La", 6.93], ["diferencia", 7.08], ["es", 7.85], ["clara", 8.0], ["y", 8.92], ["se", 8.99], ["mantiene", 9.15], ["al", 9.68], ["comparar", 9.81], ["personas", 10.38], ["de", 11.06], ["edades", 11.18], ["parecidas", 11.69]]}, {"texto": "Pero las nubes se tocan. Varias personas con insuficiencia quedan dentro del rango de las sanas. Esta medida describe diferencias entre grupos, y no sirve para diagnosticar a nadie.", "fin": 13.25, "palabras": [["Pero", 0.1], ["las", 0.32], ["nubes", 0.57], ["se", 0.97], ["tocan", 1.12], ["Varias", 2.14], ["personas", 2.6], ["con", 3.25], ["insuficiencia", 3.42], ["quedan", 4.39], ["dentro", 4.89], ["del", 5.25], ["rango", 5.47], ["de", 5.9], ["las", 6.03], ["sanas", 6.19], ["Esta", 7.24], ["medida", 7.56], ["describe", 8.03], ["diferencias", 8.61], ["entre", 9.4], ["grupos", 9.68], ["y", 10.75], ["no", 10.85], ["sirve", 11.04], ["para", 11.49], ["diagnosticar", 11.74], ["a", 12.61], ["nadie", 12.67]]}, {"texto": "Tampoco controlamos todo. No sabemos qué medicamentos tomaba cada persona, y cada base de datos eligió a sus pacientes con sus propios criterios.", "fin": 10.62, "palabras": [["Tampoco", 0.08], ["controlamos", 0.64], ["todo", 1.51], ["No", 2.42], ["sabemos", 2.62], ["qué", 3.18], ["medicamentos", 3.29], ["tomaba", 4.15], ["cada", 4.58], ["persona", 4.9], ["y", 6.07], ["cada", 6.18], ["base", 6.47], ["de", 6.79], ["datos", 6.92], ["eligió", 7.46], ["a", 7.9], ["sus", 7.96], ["pacientes", 8.19], ["con", 8.89], ["sus", 9.08], ["propios", 9.31], ["criterios", 9.76]]}, {"texto": "Otros estudios, con otras herramientas, encontraron algo parecido: en la insuficiencia, el ritmo pierde parte de su variedad a distintas escalas.", "fin": 10.93, "palabras": [["Otros", 0.08], ["estudios", 0.49], ["con", 1.54], ["otras", 1.75], ["herramientas", 2.1], ["encontraron", 3.28], ["algo", 4.03], ["parecido", 4.33], ["en", 5.42], ["la", 5.58], ["insuficiencia", 5.67], ["el", 7.06], ["ritmo", 7.25], ["pierde", 7.65], ["parte", 8.08], ["de", 8.51], ["su", 8.64], ["variedad", 8.81], ["a", 9.39], ["distintas", 9.44], ["escalas", 10.19]]}, {"texto": "Un corazón sano no es un metrónomo. Su ritmo parece vivir en algún lugar entre la rigidez y el desorden.", "fin": 7.86, "palabras": [["Un", 0.08], ["corazón", 0.28], ["sano", 0.88], ["no", 1.35], ["es", 1.65], ["un", 1.85], ["metrónomo", 1.97], ["Su", 3.21], ["ritmo", 3.43], ["parece", 3.88], ["vivir", 4.33], ["en", 4.74], ["algún", 4.88], ["lugar", 5.24], ["entre", 5.62], ["la", 5.9], ["rigidez", 6.04], ["y", 6.79], ["el", 6.94], ["desorden", 7.08]]}, {"texto": "Y eso importa. Ya en los años ochenta, un estudio con cientos de personas que habían sufrido un infarto encontró que quienes tenían un ritmo menos variable corrían, como grupo, un riesgo mayor.", "fin": 13.57, "palabras": [["Y", 0.1], ["eso", 0.25], ["importa", 0.56], ["Ya", 1.69], ["en", 1.97], ["los", 2.07], ["años", 2.28], ["ochenta", 2.6], ["un", 3.6], ["estudio", 3.72], ["con", 4.22], ["cientos", 4.43], ["de", 4.88], ["personas", 4.99], ["que", 5.64], ["habían", 5.76], ["sufrido", 6.11], ["un", 6.6], ["infarto", 6.75], ["encontró", 7.28], ["que", 7.85], ["quienes", 8.03], ["tenían", 8.39], ["un", 8.82], ["ritmo", 8.99], ["menos", 9.4], ["variable", 9.82], ["corrían", 10.31], ["como", 11.31], ["grupo", 11.56], ["un", 12.36], ["riesgo", 12.56], ["mayor", 13.01]]}, {"texto": "Un corazón que late demasiado parejo puede ser una señal de alarma. Su variedad a muchas escalas parece ser parte de su capacidad de adaptarse, y entender por qué sigue siendo una pregunta abierta.", "fin": 13.58, "palabras": [["Un", 0.08], ["corazón", 0.26], ["que", 0.85], ["late", 0.99], ["demasiado", 1.32], ["parejo", 1.97], ["puede", 2.5], ["ser", 2.88], ["una", 3.14], ["señal", 3.35], ["de", 3.86], ["alarma", 3.97], ["Su", 5.01], ["variedad", 5.24], ["a", 5.75], ["muchas", 5.81], ["escalas", 6.22], ["parece", 6.86], ["ser", 7.26], ["parte", 7.53], ["de", 7.92], ["su", 8.04], ["capacidad", 8.19], ["de", 8.89], ["adaptarse", 8.97], ["y", 10.29], ["entender", 10.39], ["por", 10.97], ["qué", 11.18], ["sigue", 11.31], ["siendo", 11.68], ["una", 12.14], ["pregunta", 12.39], ["abierta", 12.94]]}, {"texto": "Estructura dentro de estructura, a muchas escalas: la idea que encontramos en las costas y en los ríos aparece también en el ritmo de un corazón.", "fin": 9.86, "palabras": [["Estructura", 0.08], ["dentro", 0.76], ["de", 1.15], ["estructura", 1.25], ["a", 2.33], ["muchas", 2.44], ["escalas", 2.89], ["la", 3.94], ["idea", 4.1], ["que", 4.46], ["encontramos", 4.58], ["en", 5.32], ["las", 5.4], ["costas", 5.6], ["y", 6.18], ["en", 6.28], ["los", 6.39], ["ríos", 6.58], ["aparece", 7.06], ["también", 7.65], ["en", 8.1], ["el", 8.22], ["ritmo", 8.39], ["de", 8.83], ["un", 8.99], ["corazón", 9.18]]}, {"texto": "Un corazón obedece a muchas leyes a la vez. Veamos qué ocurre con algo mucho más simple: una sola regla, repetida una y otra vez.", "fin": 10.21, "palabras": [["Un", 0.08], ["corazón", 0.25], ["obedece", 0.83], ["a", 1.46], ["muchas", 1.56], ["leyes", 2.07], ["a", 2.57], ["la", 2.64], ["vez", 2.75], ["Veamos", 3.64], ["qué", 4.11], ["ocurre", 4.22], ["con", 4.67], ["algo", 4.89], ["mucho", 5.18], ["más", 5.57], ["simple", 5.79], ["una", 6.93], ["sola", 7.12], ["regla", 7.44], ["repetida", 8.32], ["una", 8.97], ["y", 9.33], ["otra", 9.49], ["vez", 9.75]]}, {"texto": "Esta regla se usó para describir cómo cambia una población de un año al siguiente. El número r mide cuán rápido se reproduce.", "fin": 9.1, "palabras": [["Esta", 0.08], ["regla", 0.42], ["se", 0.85], ["usó", 1.03], ["para", 1.36], ["describir", 1.58], ["cómo", 2.28], ["cambia", 2.57], ["una", 3.0], ["población", 3.25], ["de", 3.96], ["un", 4.1], ["año", 4.32], ["al", 4.64], ["siguiente", 4.76], ["El", 5.92], ["número", 6.11], ["r", 6.54], ["mide", 6.81], ["cuán", 7.21], ["rápido", 7.56], ["se", 8.08], ["reproduce", 8.26]]}, {"texto": "Con r pequeño, la población se asienta en un solo valor: un ritmo perfectamente parejo, como el del metrónomo.", "fin": 8.57, "palabras": [["Con", 0.08], ["r", 0.26], ["pequeño", 0.5], ["la", 1.5], ["población", 1.61], ["se", 2.28], ["asienta", 2.4], ["en", 2.96], ["un", 3.08], ["solo", 3.25], ["valor", 3.58], ["un", 4.74], ["ritmo", 4.89], ["perfectamente", 5.32], ["parejo", 6.25], ["como", 7.21], ["el", 7.51], ["del", 7.64], ["metrónomo", 7.82]]}, {"texto": "Al subir r, ese valor se divide en dos, luego en cuatro, luego en ocho: ciclos que se repiten, cada vez más largos.", "fin": 9.6, "palabras": [["Al", 0.08], ["subir", 0.25], ["r", 0.62], ["ese", 1.38], ["valor", 1.62], ["se", 2.01], ["divide", 2.15], ["en", 2.57], ["dos", 2.71], ["luego", 3.51], ["en", 3.86], ["cuatro", 4.0], ["luego", 4.89], ["en", 5.19], ["ocho", 5.32], ["ciclos", 6.32], ["que", 6.82], ["se", 6.93], ["repiten", 7.07], ["cada", 8.03], ["vez", 8.33], ["más", 8.64], ["largos", 8.93]]}, {"texto": "Y de pronto aparece el caos: valores que nunca se repiten, aunque en la regla no hay nada de azar.", "fin": 6.82, "palabras": [["Y", 0.08], ["de", 0.17], ["pronto", 0.32], ["aparece", 0.76], ["el", 1.28], ["caos", 1.4], ["valores", 2.33], ["que", 2.83], ["nunca", 2.94], ["se", 3.31], ["repiten", 3.46], ["aunque", 4.51], ["en", 4.79], ["la", 4.89], ["regla", 5.01], ["no", 5.43], ["hay", 5.68], ["nada", 5.83], ["de", 6.19], ["azar", 6.33]]}, {"texto": "Si nos acercamos, dentro del caos aparecen copias más pequeñas del mismo diagrama. Otra vez, estructura dentro de estructura.", "fin": 10.06, "palabras": [["Si", 0.08], ["nos", 0.31], ["acercamos", 0.53], ["dentro", 1.78], ["del", 2.14], ["caos", 2.35], ["aparecen", 2.82], ["copias", 3.44], ["más", 3.99], ["pequeñas", 4.32], ["del", 4.93], ["mismo", 5.14], ["diagrama", 5.54], ["Otra", 6.69], ["vez", 7.01], ["estructura", 7.89], ["dentro", 8.64], ["de", 9.08], ["estructura", 9.21]]}, {"texto": "Entre el orden del metrónomo y el desorden total, una sola ecuación lo contiene todo. En el próximo capítulo veremos cómo.", "fin": 9.32, "palabras": [["Entre", 0.08], ["el", 0.43], ["orden", 0.57], ["del", 0.92], ["metrónomo", 1.1], ["y", 1.82], ["el", 1.97], ["desorden", 2.11], ["total", 2.69], ["una", 3.83], ["sola", 4.04], ["ecuación", 4.39], ["lo", 5.04], ["contiene", 5.18], ["todo", 5.78], ["En", 6.72], ["el", 6.88], ["próximo", 7.04], ["capítulo", 7.58], ["veremos", 8.26], ["cómo", 8.83]]}]