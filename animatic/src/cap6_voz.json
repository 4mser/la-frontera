[{"texto": "¿Cómo puede algo obedecer leyes exactas y aun así ser impredecible?", "fin": 4.87, "palabras": [["Cómo", 0.14], ["puede", 0.35], ["algo", 0.74], ["obedecer", 1.08], ["leyes", 1.69], ["exactas", 2.12], ["y", 2.94], ["aun", 3.11], ["así", 3.38], ["ser", 3.69], ["impredecible", 3.93]]}, {"texto": "Ríchardson soñaba con calcular el tiempo atmosférico resolviendo sus ecuaciones. Si se conocen las leyes y el estado de hoy, pensaba, el de mañana debería poder calcularse.", "fin": 12.85, "palabras": [["Ríchardson", 0.07], ["soñaba", 0.83], ["con", 1.35], ["calcular", 1.56], ["el", 2.11], ["tiempo", 2.28], ["atmosférico", 2.65], ["resolviendo", 3.53], ["sus", 4.33], ["ecuaciones", 4.57], ["Si", 5.92], ["se", 6.12], ["conocen", 6.28], ["las", 6.78], ["leyes", 6.99], ["y", 7.53], ["el", 7.64], ["estado", 7.75], ["de", 8.21], ["hoy", 8.38], ["pensaba", 9.19], ["el", 10.29], ["de", 10.46], ["mañana", 10.56], ["debería", 11.04], ["poder", 11.58], ["calcularse", 11.99]]}, {"texto": "Cuarenta años después, otro meteorólogo descubrió por qué ese sueño tiene un límite.", "fin": 6.14, "palabras": [["Cuarenta", 0.1], ["años", 0.65], ["después", 0.99], ["otro", 2.12], ["meteorólogo", 2.4], ["descubrió", 3.17], ["por", 3.81], ["qué", 4.04], ["ese", 4.24], ["sueño", 4.47], ["tiene", 4.97], ["un", 5.36], ["límite", 5.54]]}, {"texto": "Édward Lórenz simulaba un modelo del tiempo atmosférico en su primera computadora. Un día quiso repetir un cálculo, y lo reinició desde la mitad, copiando una línea de números de una impresión.", "fin": 13.79, "palabras": [["Édward", 0.07], ["Lórenz", 0.47], ["simulaba", 1.03], ["un", 1.75], ["modelo", 1.9], ["del", 2.36], ["tiempo", 2.6], ["atmosférico", 2.97], ["en", 3.89], ["su", 4.08], ["primera", 4.24], ["computadora", 4.69], ["Un", 6.07], ["día", 6.25], ["quiso", 6.49], ["repetir", 6.9], ["un", 7.4], ["cálculo", 7.54], ["y", 8.58], ["lo", 8.67], ["reinició", 8.82], ["desde", 9.43], ["la", 9.72], ["mitad", 9.83], ["copiando", 10.76], ["una", 11.32], ["línea", 11.54], ["de", 11.96], ["números", 12.1], ["de", 12.65], ["una", 12.78], ["impresión", 13.01]]}, {"texto": "Fue por un café y volvió una hora después. Lo que no sabía era que la impresión mostraba solo tres decimales: los números que copió estaban redondeados.", "fin": 10.78, "palabras": [["Fue", 0.1], ["por", 0.35], ["un", 0.53], ["café", 0.67], ["y", 1.14], ["volvió", 1.25], ["una", 1.74], ["hora", 2.06], ["después", 2.28], ["Lo", 3.46], ["que", 3.64], ["no", 3.76], ["sabía", 3.92], ["era", 4.47], ["que", 4.69], ["la", 4.83], ["impresión", 4.92], ["mostraba", 5.51], ["solo", 6.1], ["tres", 6.47], ["decimales", 6.81], ["los", 8.03], ["números", 8.22], ["que", 8.67], ["copió", 8.79], ["estaban", 9.25], ["redondeados", 9.79]]}, {"texto": "Al principio, los nuevos valores repetían los anteriores. Pero la diferencia se duplicaba cada pocos días simulados, y en el segundo mes los dos pronósticos ya no se parecían en nada.", "fin": 13.58, "palabras": [["Al", 0.08], ["principio", 0.26], ["los", 1.56], ["nuevos", 1.75], ["valores", 2.14], ["repetían", 2.72], ["los", 3.42], ["anteriores", 3.62], ["Pero", 4.96], ["la", 5.17], ["diferencia", 5.28], ["se", 5.99], ["duplicaba", 6.14], ["cada", 6.79], ["pocos", 7.14], ["días", 7.61], ["simulados", 7.92], ["y", 9.19], ["en", 9.31], ["el", 9.42], ["segundo", 9.54], ["mes", 10.01], ["los", 10.38], ["dos", 10.61], ["pronósticos", 10.85], ["ya", 11.72], ["no", 11.94], ["se", 12.11], ["parecían", 12.28], ["en", 12.96], ["nada", 13.11]]}, {"texto": "En mil novecientos sesenta y tres publicó un sistema de solo tres ecuaciones con ese mismo comportamiento: soluciones que nunca se repiten, y estados casi iguales que terminan siendo muy distintos.", "fin": 13.26, "palabras": [["En", 0.08], ["mil", 0.24], ["novecientos", 0.44], ["sesenta", 1.07], ["y", 1.49], ["tres", 1.57], ["publicó", 1.96], ["un", 2.43], ["sistema", 2.57], ["de", 3.1], ["solo", 3.24], ["tres", 3.58], ["ecuaciones", 3.9], ["con", 4.58], ["ese", 4.79], ["mismo", 5.06], ["comportamiento", 5.47], ["soluciones", 7.15], ["que", 7.86], ["nunca", 7.97], ["se", 8.32], ["repiten", 8.46], ["y", 9.54], ["estados", 9.61], ["casi", 10.11], ["iguales", 10.46], ["que", 10.99], ["terminan", 11.12], ["siendo", 11.67], ["muy", 12.1], ["distintos", 12.39]]}, {"texto": "Lo mismo ocurre con la regla del capítulo anterior. Dos poblaciones que empiezan con una diferencia de una millonésima siguen iguales cuando la regla está en orden.", "fin": 11.0, "palabras": [["Lo", 0.07], ["mismo", 0.25], ["ocurre", 0.67], ["con", 1.15], ["la", 1.35], ["regla", 1.49], ["del", 1.88], ["capítulo", 2.1], ["anterior", 2.74], ["Dos", 3.88], ["poblaciones", 4.18], ["que", 4.96], ["empiezan", 5.07], ["con", 5.67], ["una", 5.86], ["diferencia", 6.04], ["de", 6.74], ["una", 6.88], ["millonésima", 7.11], ["siguen", 7.9], ["iguales", 8.32], ["cuando", 8.97], ["la", 9.31], ["regla", 9.44], ["está", 9.93], ["en", 10.33], ["orden", 10.49]]}, {"texto": "En la zona del caos, en cambio, se separan antes de treinta años. No hay azar en ninguna parte. La regla es exacta, pero cualquier error en el punto de partida, por pequeño que sea, termina creciendo.", "fin": 15.92, "palabras": [["En", 0.08], ["la", 0.25], ["zona", 0.38], ["del", 0.69], ["caos", 0.92], ["en", 1.79], ["cambio", 2.0], ["se", 2.94], ["separan", 3.1], ["antes", 3.67], ["de", 4.08], ["treinta", 4.22], ["años", 4.79], ["No", 5.83], ["hay", 6.1], ["azar", 6.29], ["en", 6.68], ["ninguna", 6.79], ["parte", 7.31], ["La", 8.29], ["regla", 8.49], ["es", 8.92], ["exacta", 9.07], ["pero", 10.1], ["cualquier", 10.33], ["error", 10.79], ["en", 11.15], ["el", 11.28], ["punto", 11.44], ["de", 11.79], ["partida", 11.9], ["por", 12.93], ["pequeño", 13.12], ["que", 13.62], ["sea", 13.76], ["termina", 14.58], ["creciendo", 15.11]]}, {"texto": "Pero esta regla esconde algo más. Si se cambian las variables de la manera correcta, la ecuación de las poblaciones se convierte exactamente en z al cuadrado más c.", "fin": 11.74, "palabras": [["Pero", 0.1], ["esta", 0.35], ["regla", 0.65], ["esconde", 1.12], ["algo", 1.74], ["más", 2.04], ["Si", 2.96], ["se", 3.17], ["cambian", 3.33], ["las", 3.76], ["variables", 3.94], ["de", 4.56], ["la", 4.65], ["manera", 4.76], ["correcta", 5.14], ["la", 6.33], ["ecuación", 6.43], ["de", 6.97], ["las", 7.07], ["poblaciones", 7.26], ["se", 8.03], ["convierte", 8.15], ["exactamente", 8.75], ["en", 9.69], ["z", 9.85], ["al", 10.32], ["cuadrado", 10.49], ["más", 11.06], ["c.", 11.4]]}, {"texto": "El diagrama de las poblaciones es la misma regla del conjunto de Mandelbrot, recorrida sobre una sola línea. Cada duplicación ocurre justo donde la línea cruza a un nuevo bulbo del conjunto.", "fin": 13.53, "palabras": [["El", 0.08], ["diagrama", 0.26], ["de", 0.76], ["las", 0.89], ["poblaciones", 1.1], ["es", 1.99], ["la", 2.18], ["misma", 2.31], ["regla", 2.74], ["del", 3.14], ["conjunto", 3.36], ["de", 3.97], ["Mandelbrot", 4.1], ["recorrida", 5.39], ["sobre", 6.06], ["una", 6.43], ["sola", 6.71], ["línea", 7.08], ["Cada", 8.08], ["duplicación", 8.35], ["ocurre", 9.15], ["justo", 9.56], ["donde", 10.07], ["la", 10.38], ["línea", 10.5], ["cruza", 10.92], ["a", 11.5], ["un", 11.62], ["nuevo", 11.82], ["bulbo", 12.17], ["del", 12.56], ["conjunto", 12.76]]}, {"texto": "Y la copia en miniatura que encontramos dentro del caos está exactamente debajo de una copia del Mandelbrot. Una regla en el tiempo y una forma en el plano son la misma cosa vista de dos maneras.", "fin": 13.06, "palabras": [["Y", 0.08], ["la", 0.17], ["copia", 0.32], ["en", 0.72], ["miniatura", 0.81], ["que", 1.44], ["encontramos", 1.58], ["dentro", 2.29], ["del", 2.6], ["caos", 2.81], ["está", 3.36], ["exactamente", 3.68], ["debajo", 4.56], ["de", 5.08], ["una", 5.22], ["copia", 5.49], ["del", 5.92], ["Mandelbrot", 6.11], ["Una", 7.32], ["regla", 7.57], ["en", 7.97], ["el", 8.07], ["tiempo", 8.24], ["y", 8.83], ["una", 8.97], ["forma", 9.19], ["en", 9.58], ["el", 9.68], ["plano", 9.83], ["son", 10.26], ["la", 10.51], ["misma", 10.62], ["cosa", 11.04], ["vista", 11.42], ["de", 11.86], ["dos", 12.01], ["maneras", 12.35]]}, {"texto": "En mil novecientos setenta y ocho, Míchel Fáigenbaum midió cuánto se acercan las duplicaciones entre sí. Cada tramo es unas cuatro coma seis siete veces más corto que el anterior.", "fin": 12.47, "palabras": [["En", 0.08], ["mil", 0.25], ["novecientos", 0.47], ["setenta", 1.1], ["y", 1.53], ["ocho", 1.64], ["Míchel", 2.62], ["Fáigenbaum", 3.03], ["midió", 3.78], ["cuánto", 4.22], ["se", 4.58], ["acercan", 4.74], ["las", 5.28], ["duplicaciones", 5.47], ["entre", 6.43], ["sí", 6.74], ["Cada", 7.54], ["tramo", 7.83], ["es", 8.26], ["unas", 8.43], ["cuatro", 8.74], ["coma", 9.12], ["seis", 9.46], ["siete", 9.86], ["veces", 10.21], ["más", 10.72], ["corto", 11.04], ["que", 11.5], ["el", 11.67], ["anterior", 11.79]]}, {"texto": "Y descubrió que ese mismo número aparece en muchas otras reglas distintas, siempre que tengan una sola joroba, como esta.", "fin": 8.51, "palabras": [["Y", 0.08], ["descubrió", 0.18], ["que", 0.82], ["ese", 1.03], ["mismo", 1.26], ["número", 1.65], ["aparece", 2.1], ["en", 2.64], ["muchas", 2.75], ["otras", 3.24], ["reglas", 3.62], ["distintas", 4.04], ["siempre", 5.26], ["que", 5.75], ["tengan", 5.92], ["una", 6.32], ["sola", 6.53], ["joroba", 6.86], ["como", 7.72], ["esta", 8.04]]}, {"texto": "Años después, un equipo de físicos calentó mercurio en una pequeña caja y vio aparecer las mismas duplicaciones. Midieron cuatro coma cuatro, muy cerca del número de la matemática.", "fin": 13.24, "palabras": [["Años", 0.08], ["después", 0.44], ["un", 1.49], ["equipo", 1.6], ["de", 2.0], ["físicos", 2.12], ["calentó", 2.74], ["mercurio", 3.21], ["en", 3.85], ["una", 3.97], ["pequeña", 4.18], ["caja", 4.67], ["y", 5.26], ["vio", 5.39], ["aparecer", 5.64], ["las", 6.26], ["mismas", 6.51], ["duplicaciones", 6.99], ["Midieron", 8.5], ["cuatro", 9.06], ["coma", 9.47], ["cuatro", 9.78], ["muy", 10.76], ["cerca", 10.99], ["del", 11.43], ["número", 11.68], ["de", 12.08], ["la", 12.21], ["matemática", 12.32]]}, {"texto": "Saber la regla no es saber el resultado. Cuatro mil puntos que empiezan casi juntos terminan, en pocos segundos, en lugares que nadie podría anticipar.", "fin": 11.1, "palabras": [["Saber", 0.08], ["la", 0.51], ["regla", 0.65], ["no", 1.11], ["es", 1.42], ["saber", 1.54], ["el", 1.92], ["resultado", 2.06], ["Cuatro", 3.35], ["mil", 3.65], ["puntos", 3.89], ["que", 4.39], ["empiezan", 4.49], ["casi", 5.04], ["juntos", 5.4], ["terminan", 5.86], ["en", 6.96], ["pocos", 7.12], ["segundos", 7.5], ["en", 8.56], ["lugares", 8.69], ["que", 9.19], ["nadie", 9.32], ["podría", 9.76], ["anticipar", 10.29]]}, {"texto": "Pero mira lo que hacen juntos. Ninguno se repite, y aun así todos dibujan la misma forma. El caos tiene geometría: un orden que no se deja predecir, pero sí se deja ver.", "fin": 13.92, "palabras": [["Pero", 0.1], ["mira", 0.32], ["lo", 0.65], ["que", 0.83], ["hacen", 1.01], ["juntos", 1.38], ["Ninguno", 2.51], ["se", 3.03], ["repite", 3.18], ["y", 4.32], ["aun", 4.44], ["así", 4.69], ["todos", 5.0], ["dibujan", 5.47], ["la", 6.06], ["misma", 6.18], ["forma", 6.6], ["El", 7.61], ["caos", 7.81], ["tiene", 8.24], ["geometría", 8.54], ["un", 10.03], ["orden", 10.19], ["que", 10.58], ["no", 10.72], ["se", 10.94], ["deja", 11.12], ["predecir", 11.47], ["pero", 12.58], ["sí", 12.83], ["se", 13.03], ["deja", 13.19], ["ver", 13.53]]}, {"texto": "Lórenz, las poblaciones y el conjunto de Mandelbrot cuentan lo mismo: una regla exacta puede producir sorpresas, y esas sorpresas tienen forma.", "fin": 10.58, "palabras": [["Lórenz", 0.08], ["las", 1.07], ["poblaciones", 1.28], ["y", 2.12], ["el", 2.19], ["conjunto", 2.31], ["de", 2.86], ["Mandelbrot", 2.97], ["cuentan", 3.61], ["lo", 4.06], ["mismo", 4.15], ["una", 5.21], ["regla", 5.44], ["exacta", 5.79], ["puede", 6.38], ["producir", 6.69], ["sorpresas", 7.26], ["y", 8.47], ["esas", 8.62], ["sorpresas", 8.92], ["tienen", 9.67], ["forma", 10.03]]}, {"texto": "Y aun sin poder predecirlo todo, ¿podemos usar esta geometría para algo?", "fin": 5.44, "palabras": [["Y", 0.08], ["aun", 0.22], ["sin", 0.5], ["poder", 0.72], ["predecirlo", 1.12], ["todo", 1.83], ["podemos", 2.79], ["usar", 3.31], ["esta", 3.65], ["geometría", 3.94], ["para", 4.69], ["algo", 4.99]]}]