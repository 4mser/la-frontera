[{"texto": "Al comienzo de este viaje, una red de neuronas se abrió y se convirtió en la red del cosmos. Se parecían tanto que costaba distinguirlas.", "fin": 10.04, "palabras": [["Al", 0.08], ["comienzo", 0.25], ["de", 0.79], ["este", 0.99], ["viaje", 1.26], ["una", 2.36], ["red", 2.58], ["de", 2.85], ["neuronas", 2.96], ["se", 3.54], ["abrió", 3.65], ["y", 4.11], ["se", 4.21], ["convirtió", 4.38], ["en", 5.06], ["la", 5.18], ["red", 5.32], ["del", 5.6], ["cosmos", 5.79], ["Se", 6.92], ["parecían", 7.15], ["tanto", 7.85], ["que", 8.24], ["costaba", 8.39], ["distinguirlas", 8.93]]}, {"texto": "Pero parecerse no es lo mismo que ser igual. ¿Cuánto se parecen de verdad? ¿Y la estructura del cosmos sigue la misma ley a todas las escalas?", "fin": 10.06, "palabras": [["Pero", 0.1], ["parecerse", 0.29], ["no", 1.0], ["es", 1.26], ["lo", 1.43], ["mismo", 1.57], ["que", 2.03], ["ser", 2.17], ["igual", 2.42], ["Cuánto", 3.46], ["se", 3.79], ["parecen", 3.99], ["de", 4.54], ["verdad", 4.64], ["Y", 5.78], ["la", 5.81], ["estructura", 5.94], ["del", 6.57], ["cosmos", 6.79], ["sigue", 7.31], ["la", 7.64], ["misma", 7.76], ["ley", 8.19], ["a", 8.53], ["todas", 8.62], ["las", 9.1], ["escalas", 9.29]]}, {"texto": "En dos mil veinte, un astrofísico y un neurocirujano italianos decidieron medirlo. Tomaron cortes muy finos de un cerebro humano y los compararon con una simulación del universo.", "fin": 12.87, "palabras": [["En", 0.08], ["dos", 0.25], ["mil", 0.46], ["veinte", 0.68], ["un", 1.72], ["astrofísico", 1.86], ["y", 2.81], ["un", 2.96], ["neurocirujano", 3.12], ["italianos", 4.06], ["decidieron", 4.88], ["medirlo", 5.57], ["Tomaron", 6.68], ["cortes", 7.14], ["muy", 7.64], ["finos", 7.88], ["de", 8.39], ["un", 8.51], ["cerebro", 8.71], ["humano", 9.18], ["y", 9.75], ["los", 9.88], ["compararon", 10.08], ["con", 10.75], ["una", 10.96], ["simulación", 11.18], ["del", 11.97], ["universo", 12.15]]}, {"texto": "El cerebro tiene unos ochenta y seis mil millones de neuronas. En el universo observable hay unos dos billones y medio de galaxias. Y entre un tejido y otro hay un salto de veintisiete órdenes de magnitud.", "fin": 14.58, "palabras": [["El", 0.08], ["cerebro", 0.25], ["tiene", 0.78], ["unos", 1.14], ["ochenta", 1.5], ["y", 1.94], ["seis", 2.01], ["mil", 2.33], ["millones", 2.6], ["de", 3.19], ["neuronas", 3.29], ["En", 4.56], ["el", 4.71], ["universo", 4.85], ["observable", 5.43], ["hay", 6.19], ["unos", 6.44], ["dos", 6.78], ["billones", 7.04], ["y", 7.75], ["medio", 7.86], ["de", 8.25], ["galaxias", 8.35], ["Y", 9.64], ["entre", 9.76], ["un", 10.08], ["tejido", 10.24], ["y", 10.88], ["otro", 11.06], ["hay", 11.4], ["un", 11.6], ["salto", 11.75], ["de", 12.21], ["veintisiete", 12.33], ["órdenes", 13.15], ["de", 13.74], ["magnitud", 13.83]]}, {"texto": "Primero compararon cómo se reparte la materia en cada escala. Entre una centésima de milímetro y un milímetro y medio, el cerebelo se parece a la red cósmica entre uno y cien megapársecs, y un megapársec son más de tres millones de años luz.", "fin": 16.64, "palabras": [["Primero", 0.1], ["compararon", 0.51], ["cómo", 1.25], ["se", 1.51], ["reparte", 1.67], ["la", 2.22], ["materia", 2.35], ["en", 3.03], ["cada", 3.28], ["escala", 3.61], ["Entre", 4.68], ["una", 5.0], ["centésima", 5.19], ["de", 5.85], ["milímetro", 5.96], ["y", 6.64], ["un", 6.76], ["milímetro", 6.89], ["y", 7.44], ["medio", 7.51], ["el", 8.38], ["cerebelo", 8.54], ["se", 9.07], ["parece", 9.24], ["a", 9.68], ["la", 9.72], ["red", 9.86], ["cósmica", 10.12], ["entre", 10.75], ["uno", 11.08], ["y", 11.39], ["cien", 11.47], ["megapársecs", 11.75], ["y", 13.12], ["un", 13.24], ["megapársec", 13.36], ["son", 14.07], ["más", 14.32], ["de", 14.6], ["tres", 14.74], ["millones", 15.07], ["de", 15.62], ["años", 15.76], ["luz", 16.17]]}, {"texto": "Fuera de ese tramo, las curvas se separan. Y los autores advierten algo más: ninguna de las dos sigue una ley simple, como la de un fractal. Siguen leyes que se quiebran.", "fin": 13.32, "palabras": [["Fuera", 0.1], ["de", 0.47], ["ese", 0.69], ["tramo", 0.97], ["las", 1.97], ["curvas", 2.19], ["se", 2.64], ["separan", 2.76], ["Y", 3.9], ["los", 3.99], ["autores", 4.22], ["advierten", 4.78], ["algo", 5.42], ["más", 5.71], ["ninguna", 6.72], ["de", 7.19], ["las", 7.32], ["dos", 7.56], ["sigue", 7.81], ["una", 8.15], ["ley", 8.4], ["simple", 8.64], ["como", 9.57], ["la", 9.85], ["de", 9.97], ["un", 10.14], ["fractal", 10.32], ["Siguen", 11.44], ["leyes", 11.92], ["que", 12.4], ["se", 12.53], ["quiebran", 12.69]]}, {"texto": "Luego trataron cada imagen como una red, donde cada neurona o cada galaxia es un nodo unido a sus vecinos cercanos. Algunas medidas coinciden, como cuántos vecinos de un nodo están unidos entre sí. Otras no coinciden.", "fin": 16.64, "palabras": [["Luego", 0.08], ["trataron", 0.46], ["cada", 1.03], ["imagen", 1.33], ["como", 1.88], ["una", 2.15], ["red", 2.42], ["donde", 3.25], ["cada", 3.54], ["neurona", 3.83], ["o", 4.49], ["cada", 4.6], ["galaxia", 4.88], ["es", 5.62], ["un", 5.83], ["nodo", 5.97], ["unido", 6.29], ["a", 6.75], ["sus", 6.81], ["vecinos", 7.06], ["cercanos", 7.58], ["Algunas", 8.79], ["medidas", 9.35], ["coinciden", 9.86], ["como", 11.08], ["cuántos", 11.36], ["vecinos", 11.82], ["de", 12.38], ["un", 12.49], ["nodo", 12.67], ["están", 13.07], ["unidos", 13.46], ["entre", 13.97], ["sí", 14.26], ["Otras", 15.07], ["no", 15.54], ["coinciden", 15.76]]}, {"texto": "Los propios autores lo llaman un primer trabajo exploratorio. Las conexiones se definieron por cercanía, con una distancia elegida a mano, y un corte de tejido es una parte mínima del cerebro. El parecido está medido, pero no demuestra un mecanismo común.", "fin": 18.78, "palabras": [["Los", 0.07], ["propios", 0.35], ["autores", 0.81], ["lo", 1.51], ["llaman", 1.68], ["un", 2.1], ["primer", 2.25], ["trabajo", 2.71], ["exploratorio", 3.24], ["Las", 4.72], ["conexiones", 4.96], ["se", 5.64], ["definieron", 5.75], ["por", 6.4], ["cercanía", 6.58], ["con", 7.71], ["una", 7.89], ["distancia", 8.07], ["elegida", 8.76], ["a", 9.28], ["mano", 9.33], ["y", 10.28], ["un", 10.39], ["corte", 10.57], ["de", 10.93], ["tejido", 11.08], ["es", 11.67], ["una", 11.85], ["parte", 12.07], ["mínima", 12.49], ["del", 12.97], ["cerebro", 13.19], ["El", 14.24], ["parecido", 14.42], ["está", 15.01], ["medido", 15.32], ["pero", 16.26], ["no", 16.53], ["demuestra", 16.72], ["un", 17.36], ["mecanismo", 17.51], ["común", 18.22]]}, {"texto": "Para ver la red cósmica real, y no una simulación, hay que saber dónde está cada galaxia. Los telescopios miden su luz y, por cuánto se corre hacia el rojo, calculan a qué distancia está cada una.", "fin": 14.72, "palabras": [["Para", 0.1], ["ver", 0.29], ["la", 0.53], ["red", 0.68], ["cósmica", 0.96], ["real", 1.53], ["y", 2.51], ["no", 2.57], ["una", 2.75], ["simulación", 2.96], ["hay", 4.38], ["que", 4.51], ["saber", 4.65], ["dónde", 5.08], ["está", 5.38], ["cada", 5.69], ["galaxia", 6.07], ["Los", 7.24], ["telescopios", 7.47], ["miden", 8.25], ["su", 8.62], ["luz", 8.76], ["y", 9.14], ["por", 9.72], ["cuánto", 9.92], ["se", 10.24], ["corre", 10.4], ["hacia", 10.78], ["el", 11.04], ["rojo", 11.15], ["calculan", 12.0], ["a", 12.6], ["qué", 12.67], ["distancia", 12.81], ["está", 13.57], ["cada", 13.9], ["una", 14.28]]}, {"texto": "Los mapas muestran lo mismo que la simulación: galaxias agrupadas en cúmulos, unidas por filamentos, y vacíos de decenas de megapársecs que ocupan cerca del cuarenta por ciento del volumen.", "fin": 12.88, "palabras": [["Los", 0.08], ["mapas", 0.33], ["muestran", 0.75], ["lo", 1.19], ["mismo", 1.29], ["que", 1.69], ["la", 1.82], ["simulación", 1.93], ["galaxias", 3.24], ["agrupadas", 3.88], ["en", 4.53], ["cúmulos", 4.68], ["unidas", 5.68], ["por", 6.12], ["filamentos", 6.31], ["y", 7.49], ["vacíos", 7.57], ["de", 8.07], ["decenas", 8.17], ["de", 8.69], ["megapársecs", 8.79], ["que", 9.64], ["ocupan", 9.76], ["cerca", 10.24], ["del", 10.64], ["cuarenta", 10.85], ["por", 11.38], ["ciento", 11.61], ["del", 12.07], ["volumen", 12.26]]}, {"texto": "En los años ochenta, algunos físicos propusieron una idea audaz: que las galaxias forman un fractal sin fin. Que, por grande que sea la escala, siempre habría más agrupamiento y vacíos más grandes.", "fin": 15.1, "palabras": [["En", 0.1], ["los", 0.24], ["años", 0.46], ["ochenta", 0.79], ["algunos", 1.81], ["físicos", 2.32], ["propusieron", 2.89], ["una", 3.6], ["idea", 3.82], ["audaz", 4.22], ["que", 5.18], ["las", 5.31], ["galaxias", 5.49], ["forman", 6.15], ["un", 6.6], ["fractal", 6.74], ["sin", 7.29], ["fin", 7.56], ["Que", 8.43], ["por", 9.14], ["grande", 9.33], ["que", 9.72], ["sea", 9.86], ["la", 10.17], ["escala", 10.26], ["siempre", 11.29], ["habría", 11.74], ["más", 12.11], ["agrupamiento", 12.44], ["y", 13.36], ["vacíos", 13.46], ["más", 14.08], ["grandes", 14.39]]}, {"texto": "Si fuera así, el universo no tendría una densidad promedio. ¿Cómo se decide algo como esto? La respuesta está en contar galaxias, una por una, a escalas cada vez más grandes.", "fin": 14.22, "palabras": [["Si", 0.08], ["fuera", 0.31], ["así", 0.62], ["el", 1.5], ["universo", 1.65], ["no", 2.25], ["tendría", 2.46], ["una", 3.06], ["densidad", 3.32], ["promedio", 3.97], ["Cómo", 5.19], ["se", 5.38], ["decide", 5.56], ["algo", 6.15], ["como", 6.54], ["esto", 6.86], ["La", 7.79], ["respuesta", 7.96], ["está", 8.61], ["en", 8.92], ["contar", 9.04], ["galaxias", 9.47], ["una", 10.72], ["por", 10.92], ["una", 11.11], ["a", 11.83], ["escalas", 11.96], ["cada", 12.56], ["vez", 12.89], ["más", 13.19], ["grandes", 13.5]]}, {"texto": "Se elige una galaxia y se cuentan sus vecinas dentro de una esfera. Luego se agranda la esfera y se cuenta otra vez. Si la materia llenara el espacio de forma pareja, al duplicar el radio habría ocho veces más galaxias.", "fin": 16.39, "palabras": [["Se", 0.08], ["elige", 0.33], ["una", 0.75], ["galaxia", 0.97], ["y", 1.71], ["se", 1.83], ["cuentan", 2.01], ["sus", 2.49], ["vecinas", 2.69], ["dentro", 3.36], ["de", 3.76], ["una", 3.92], ["esfera", 4.18], ["Luego", 5.24], ["se", 5.64], ["agranda", 5.81], ["la", 6.26], ["esfera", 6.36], ["y", 6.96], ["se", 7.08], ["cuenta", 7.26], ["otra", 7.82], ["vez", 8.12], ["Si", 9.03], ["la", 9.24], ["materia", 9.36], ["llenara", 9.86], ["el", 10.32], ["espacio", 10.42], ["de", 10.97], ["forma", 11.08], ["pareja", 11.47], ["al", 12.51], ["duplicar", 12.68], ["el", 13.21], ["radio", 13.36], ["habría", 13.88], ["ocho", 14.38], ["veces", 14.69], ["más", 15.18], ["galaxias", 15.51]]}, {"texto": "En un fractal, el número crecería más lento. Ese ritmo de crecimiento es una dimensión, la misma idea de la costa y de las ramas. Tres significa que la materia es pareja. Menos de tres, que es fractal.", "fin": 16.47, "palabras": [["En", 0.1], ["un", 0.25], ["fractal", 0.4], ["el", 1.57], ["número", 1.72], ["crecería", 2.11], ["más", 2.78], ["lento", 3.15], ["Ese", 4.15], ["ritmo", 4.46], ["de", 4.89], ["crecimiento", 5.01], ["es", 5.86], ["una", 6.06], ["dimensión", 6.24], ["la", 7.58], ["misma", 7.71], ["idea", 8.12], ["de", 8.5], ["la", 8.64], ["costa", 8.78], ["y", 9.36], ["de", 9.46], ["las", 9.6], ["ramas", 9.81], ["Tres", 10.86], ["significa", 11.1], ["que", 11.81], ["la", 11.96], ["materia", 12.07], ["es", 12.72], ["pareja", 12.9], ["Menos", 13.96], ["de", 14.36], ["tres", 14.5], ["que", 15.38], ["es", 15.57], ["fractal", 15.76]]}, {"texto": "En dos mil doce, un censo hecho con el telescopio anglo-australiano repitió esa cuenta con casi ciento ochenta mil galaxias, hasta miles de millones de años luz de distancia.", "fin": 11.65, "palabras": [["En", 0.08], ["dos", 0.24], ["mil", 0.43], ["doce", 0.64], ["un", 1.47], ["censo", 1.6], ["hecho", 2.04], ["con", 2.35], ["el", 2.51], ["telescopio", 2.65], ["anglo-australiano", 3.38], ["repitió", 4.47], ["esa", 5.0], ["cuenta", 5.24], ["con", 5.64], ["casi", 5.9], ["ciento", 6.26], ["ochenta", 6.71], ["mil", 7.14], ["galaxias", 7.39], ["hasta", 8.57], ["miles", 8.86], ["de", 9.22], ["millones", 9.32], ["de", 9.83], ["años", 9.97], ["luz", 10.46], ["de", 10.72], ["distancia", 10.82]]}, {"texto": "A escalas pequeñas, la dimensión es menor que tres: las galaxias están agrupadas. Pero, a medida que crece la esfera, la dimensión sube y se acerca a tres. Desde unos setenta megapársecs, ya no se distingue de tres.", "fin": 17.32, "palabras": [["A", 0.08], ["escalas", 0.19], ["pequeñas", 0.72], ["la", 1.78], ["dimensión", 1.89], ["es", 2.5], ["menor", 2.67], ["que", 3.04], ["tres", 3.21], ["las", 4.08], ["galaxias", 4.32], ["están", 5.06], ["agrupadas", 5.44], ["Pero", 6.74], ["a", 7.51], ["medida", 7.64], ["que", 8.1], ["crece", 8.26], ["la", 8.65], ["esfera", 8.75], ["la", 9.76], ["dimensión", 9.85], ["sube", 10.47], ["y", 10.96], ["se", 11.08], ["acerca", 11.26], ["a", 11.81], ["tres", 11.88], ["Desde", 12.83], ["unos", 13.24], ["setenta", 13.54], ["megapársecs", 14.08], ["ya", 15.46], ["no", 15.65], ["se", 15.82], ["distingue", 15.99], ["de", 16.64], ["tres", 16.79]]}, {"texto": "Entre unos ochenta y trescientos megapársecs, el censo descartó un fractal con dimensión menor que dos coma noventa y siete, con una confianza del noventa y nueve coma noventa y nueve por ciento.", "fin": 12.26, "palabras": [["Entre", 0.08], ["unos", 0.42], ["ochenta", 0.72], ["y", 1.11], ["trescientos", 1.18], ["megapársecs", 1.81], ["el", 3.08], ["censo", 3.22], ["descartó", 3.6], ["un", 4.15], ["fractal", 4.29], ["con", 4.85], ["dimensión", 5.03], ["menor", 5.58], ["que", 6.01], ["dos", 6.18], ["coma", 6.51], ["noventa", 6.78], ["y", 7.18], ["siete", 7.25], ["con", 8.21], ["una", 8.39], ["confianza", 8.58], ["del", 9.25], ["noventa", 9.44], ["y", 9.83], ["nueve", 9.9], ["coma", 10.25], ["noventa", 10.6], ["y", 11.07], ["nueve", 11.14], ["por", 11.49], ["ciento", 11.69]]}, {"texto": "Por eso conviene separar cuatro afirmaciones que suelen confundirse. Las galaxias están agrupadas, y eso es cierto. Hay relaciones de escala en un tramo, y también es cierto. En cambio, la idea de un universo fractal a toda escala queda descartada por las mediciones. Y a gran escala, los datos son compatibles con un universo homogéneo.", "fin": 25.76, "palabras": [["Por", 0.1], ["eso", 0.26], ["conviene", 0.54], ["separar", 1.06], ["cuatro", 1.64], ["afirmaciones", 2.08], ["que", 3.03], ["suelen", 3.17], ["confundirse", 3.62], ["Las", 5.0], ["galaxias", 5.25], ["están", 5.92], ["agrupadas", 6.26], ["y", 7.54], ["eso", 7.71], ["es", 8.04], ["cierto", 8.17], ["Hay", 9.17], ["relaciones", 9.36], ["de", 10.07], ["escala", 10.17], ["en", 10.69], ["un", 10.82], ["tramo", 10.97], ["y", 11.99], ["también", 12.1], ["es", 12.57], ["cierto", 12.69], ["En", 13.71], ["cambio", 13.92], ["la", 14.92], ["idea", 15.03], ["de", 15.4], ["un", 15.57], ["universo", 15.75], ["fractal", 16.31], ["a", 16.92], ["toda", 17.03], ["escala", 17.36], ["queda", 17.83], ["descartada", 18.18], ["por", 19.0], ["las", 19.22], ["mediciones", 19.42], ["Y", 20.79], ["a", 20.92], ["gran", 21.0], ["escala", 21.29], ["los", 22.39], ["datos", 22.58], ["son", 22.96], ["compatibles", 23.17], ["con", 23.97], ["un", 24.19], ["universo", 24.35], ["homogéneo", 24.99]]}, {"texto": "La materia se agrupa, forma filamentos y deja enormes vacíos. Pero, al ampliar la escala, esas diferencias se atenúan.", "fin": 10.24, "palabras": [["La", 0.08], ["materia", 0.26], ["se", 0.79], ["agrupa", 0.96], ["forma", 2.01], ["filamentos", 2.38], ["y", 3.24], ["deja", 3.35], ["enormes", 3.74], ["vacíos", 4.33], ["Pero", 5.56], ["al", 6.36], ["ampliar", 6.54], ["la", 7.03], ["escala", 7.12], ["esas", 8.18], ["diferencias", 8.56], ["se", 9.35], ["atenúan", 9.47]]}, {"texto": "La pregunta no es solo si el universo tiene estructura, sino hasta qué escala podemos describirla con la misma ley.", "fin": 7.49, "palabras": [["La", 0.08], ["pregunta", 0.25], ["no", 0.79], ["es", 1.01], ["solo", 1.14], ["si", 1.46], ["el", 1.62], ["universo", 1.74], ["tiene", 2.33], ["estructura", 2.62], ["sino", 3.9], ["hasta", 4.19], ["qué", 4.46], ["escala", 4.6], ["podemos", 5.08], ["describirla", 5.57], ["con", 6.36], ["la", 6.58], ["misma", 6.69], ["ley", 7.08]]}, {"texto": "Y si la matemática describe tan bien el mundo, pero solo en ciertos tramos, ¿qué es, exactamente, lo que estamos describiendo?", "fin": 9.18, "palabras": [["Y", 0.08], ["si", 0.18], ["la", 0.35], ["matemática", 0.47], ["describe", 1.18], ["tan", 1.78], ["bien", 2.0], ["el", 2.24], ["mundo", 2.38], ["pero", 3.25], ["solo", 3.49], ["en", 3.83], ["ciertos", 3.96], ["tramos", 4.49], ["qué", 5.42], ["es", 5.64], ["exactamente", 6.19], ["lo", 7.57], ["que", 7.69], ["estamos", 7.82], ["describiendo", 8.31]]}]