[{"texto": "Hay algo profundamente extraño en estar vivos.", "fin": 3.39, "palabras": [["Hay", 0.08], ["algo", 0.32], ["profundamente", 0.64], ["extraño", 1.54], ["en", 2.25], ["estar", 2.38], ["vivos", 2.76]]}, {"texto": "Detente un segundo.", "fin": 1.61, "palabras": [["Detente", 0.06], ["un", 0.71], ["segundo", 0.9]]}, {"texto": "Estás aquí, consciente.", "fin": 2.29, "palabras": [["Estás", 0.1], ["aquí", 0.54], ["consciente", 1.43]]}, {"texto": "En un pequeño rincón del universo, sobre una roca que gira alrededor de una estrella, en medio de miles de millones de galaxias.", "fin": 8.85, "palabras": [["En", 0.08], ["un", 0.24], ["pequeño", 0.39], ["rincón", 0.89], ["del", 1.38], ["universo", 1.54], ["sobre", 2.64], ["una", 2.97], ["roca", 3.19], ["que", 3.56], ["gira", 3.71], ["alrededor", 4.07], ["de", 4.75], ["una", 4.88], ["estrella", 5.1], ["en", 6.14], ["medio", 6.32], ["de", 6.67], ["miles", 6.79], ["de", 7.22], ["millones", 7.32], ["de", 7.9], ["galaxias", 8.0]]}, {"texto": "Y puedes darte cuenta.", "fin": 1.71, "palabras": [["Y", 0.08], ["puedes", 0.18], ["darte", 0.68], ["cuenta", 1.07]]}, {"texto": "Puedes mirar el cielo y preguntarte qué es todo esto.", "fin": 3.6, "palabras": [["Puedes", 0.1], ["mirar", 0.47], ["el", 0.82], ["cielo", 0.97], ["y", 1.4], ["preguntarte", 1.47], ["qué", 2.31], ["es", 2.54], ["todo", 2.75], ["esto", 3.11]]}, {"texto": "Puedes escuchar una canción y sentir algo que ni siquiera sabes explicar.", "fin": 4.82, "palabras": [["Puedes", 0.1], ["escuchar", 0.46], ["una", 1.0], ["canción", 1.19], ["y", 1.78], ["sentir", 1.86], ["algo", 2.36], ["que", 2.75], ["ni", 2.89], ["siquiera", 3.04], ["sabes", 3.56], ["explicar", 4.03]]}, {"texto": "Durante siglos hemos buscado un propósito.", "fin": 3.08, "palabras": [["Durante", 0.07], ["siglos", 0.56], ["hemos", 1.11], ["buscado", 1.44], ["un", 2.04], ["propósito", 2.21]]}, {"texto": "Una razón.", "fin": 1.04, "palabras": [["Una", 0.08], ["razón", 0.38]]}, {"texto": "Una respuesta que justifique nuestra existencia.", "fin": 3.24, "palabras": [["Una", 0.08], ["respuesta", 0.32], ["que", 0.99], ["justifique", 1.14], ["nuestra", 1.88], ["existencia", 2.28]]}, {"texto": "Pero ¿y si no hubiera ninguna?", "fin": 2.69, "palabras": [["Pero", 0.1], ["y", 1.04], ["si", 1.17], ["no", 1.38], ["hubiera", 1.58], ["ninguna", 2.01]]}, {"texto": "¿Y si el universo no estuviera hecho para nosotros?", "fin": 3.58, "palabras": [["Y", 0.17], ["si", 0.21], ["el", 0.42], ["universo", 0.54], ["no", 1.18], ["estuviera", 1.43], ["hecho", 2.14], ["para", 2.47], ["nosotros", 2.71]]}, {"texto": "¿Y si no hubiera un significado escrito en alguna parte?", "fin": 3.85, "palabras": [["Y", 0.17], ["si", 0.19], ["no", 0.38], ["hubiera", 0.56], ["un", 0.99], ["significado", 1.14], ["escrito", 1.97], ["en", 2.68], ["alguna", 2.85], ["parte", 3.29]]}, {"texto": "No creo que eso lo haga menos extraordinario.", "fin": 3.33, "palabras": [["No", 0.07], ["creo", 0.31], ["que", 0.69], ["eso", 0.94], ["lo", 1.26], ["haga", 1.46], ["menos", 1.71], ["extraordinario", 2.17]]}, {"texto": "Al contrario.", "fin": 1.15, "palabras": [["Al", 0.1], ["contrario", 0.29]]}, {"texto": "Piensa en todo lo que tuvo que ocurrir para que, durante un instante diminuto de la historia cósmica, la materia pudiera organizarse, respirar, sentir, amar y preguntarse por sí misma.", "fin": 13.25, "palabras": [["Piensa", 0.1], ["en", 0.49], ["todo", 0.64], ["lo", 0.94], ["que", 1.07], ["tuvo", 1.22], ["que", 1.53], ["ocurrir", 1.65], ["para", 2.15], ["que", 2.39], ["durante", 3.24], ["un", 3.67], ["instante", 3.82], ["diminuto", 4.42], ["de", 4.99], ["la", 5.11], ["historia", 5.19], ["cósmica", 5.68], ["la", 6.83], ["materia", 6.93], ["pudiera", 7.42], ["organizarse", 7.88], ["respirar", 9.15], ["sentir", 10.18], ["amar", 11.11], ["y", 11.46], ["preguntarse", 11.53], ["por", 12.36], ["sí", 12.57], ["misma", 12.72]]}, {"texto": "Somos parte de ese universo intentando comprenderse.", "fin": 3.85, "palabras": [["Somos", 0.08], ["parte", 0.56], ["de", 0.94], ["ese", 1.17], ["universo", 1.43], ["intentando", 2.12], ["comprenderse", 2.9]]}, {"texto": "Y cuanto más aprendemos sobre él, más increíble parece.", "fin": 4.28, "palabras": [["Y", 0.08], ["cuanto", 0.19], ["más", 0.6], ["aprendemos", 0.88], ["sobre", 1.53], ["él", 1.88], ["más", 2.65], ["increíble", 2.96], ["parece", 3.65]]}, {"texto": "Descubrir que una flor sigue reglas matemáticas no la hace menos hermosa.", "fin": 5.11, "palabras": [["Descubrir", 0.07], ["que", 0.72], ["una", 0.88], ["flor", 1.12], ["sigue", 1.44], ["reglas", 1.81], ["matemáticas", 2.28], ["no", 3.22], ["la", 3.47], ["hace", 3.69], ["menos", 3.99], ["hermosa", 4.44]]}, {"texto": "Entender las estrellas no apaga su luz.", "fin": 3.01, "palabras": [["Entender", 0.1], ["las", 0.68], ["estrellas", 0.89], ["no", 1.65], ["apaga", 1.92], ["su", 2.36], ["luz", 2.53]]}, {"texto": "Encontrar una explicación no destruye el misterio.", "fin": 3.67, "palabras": [["Encontrar", 0.07], ["una", 0.75], ["explicación", 0.92], ["no", 1.85], ["destruye", 2.11], ["el", 2.78], ["misterio", 2.9]]}, {"texto": "A veces, lo multiplica.", "fin": 2.31, "palabras": [["A", 0.1], ["veces", 0.19], ["lo", 1.24], ["multiplica", 1.4]]}, {"texto": "Quizás no estamos aquí para cumplir un propósito.", "fin": 3.36, "palabras": [["Quizás", 0.08], ["no", 0.57], ["estamos", 0.74], ["aquí", 1.22], ["para", 1.57], ["cumplir", 1.85], ["un", 2.38], ["propósito", 2.5]]}, {"texto": "Quizás simplemente estamos aquí.", "fin": 2.31, "palabras": [["Quizás", 0.08], ["simplemente", 0.53], ["estamos", 1.33], ["aquí", 1.88]]}, {"texto": "Y, sinceramente...", "fin": 2.01, "palabras": [["Y", 0.08], ["sinceramente", 0.83]]}, {"texto": "¿No te parece extraordinario?", "fin": 2.25, "palabras": [["No", 0.14], ["te", 0.33], ["parece", 0.49], ["extraordinario", 1.0]]}]