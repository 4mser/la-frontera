[{"texto": "Hay algo profundamente extraño en estar vivos.", "fin": 3.0, "palabras": [["Hay", 0.06], ["algo", 0.11], ["profundamente", 0.19], ["extraño", 1.47], ["en", 2.08], ["estar", 2.27], ["vivos", 2.74]]}, {"texto": "Detente un segundo.", "fin": 1.53, "palabras": [["Detente", 0.06], ["un", 0.3], ["segundo", 0.52]]}, {"texto": "Estás aquí, consciente.", "fin": 2.19, "palabras": [["Estás", 0.06], ["aquí", 0.11], ["consciente", 1.26]]}, {"texto": "En un pequeño rincón del universo, sobre una roca que gira alrededor de una estrella, en medio de miles de millones de galaxias.", "fin": 8.27, "palabras": [["En", 0.06], ["un", 0.11], ["pequeño", 0.16], ["rincón", 0.3], ["del", 0.72], ["universo", 0.93], ["sobre", 2.23], ["una", 2.49], ["roca", 3.04], ["que", 3.64], ["gira", 3.69], ["alrededor", 3.77], ["de", 3.89], ["una", 4.02], ["estrella", 4.14], ["en", 5.21], ["medio", 5.54], ["de", 5.78], ["miles", 6.0], ["de", 6.59], ["millones", 6.73], ["de", 7.3], ["galaxias", 7.44]]}, {"texto": "Y puedes darte cuenta.", "fin": 1.59, "palabras": [["Y", 0.06], ["puedes", 0.11], ["darte", 0.2], ["cuenta", 0.62]]}, {"texto": "Puedes mirar al cielo y preguntarte qué es todo esto.", "fin": 3.49, "palabras": [["Puedes", 0.06], ["mirar", 0.34], ["al", 0.52], ["cielo", 0.7], ["y", 1.2], ["preguntarte", 1.3], ["qué", 1.96], ["es", 2.51], ["todo", 2.57], ["esto", 2.97]]}, {"texto": "Puedes escuchar una canción y sentir algo que ni siquiera sabes explicar.", "fin": 4.78, "palabras": [["Puedes", 0.06], ["escuchar", 0.19], ["una", 1.09], ["canción", 1.43], ["y", 1.58], ["sentir", 1.87], ["algo", 2.14], ["que", 2.42], ["ni", 2.65], ["siquiera", 2.8], ["sabes", 3.41], ["explicar", 3.79]]}, {"texto": "Durante siglos hemos buscado un propósito.", "fin": 2.81, "palabras": [["Durante", 0.06], ["siglos", 0.19], ["hemos", 0.75], ["buscado", 1.23], ["un", 1.89], ["propósito", 2.08]]}, {"texto": "Una razón.", "fin": 0.74, "palabras": [["Una", 0.07], ["razón", 0.12]]}, {"texto": "Una respuesta que justifique nuestra existencia.", "fin": 3.15, "palabras": [["Una", 0.06], ["respuesta", 0.11], ["que", 0.47], ["justifique", 0.7], ["nuestra", 1.48], ["existencia", 2.03]]}, {"texto": "Pero ¿y si no hubiera ninguna?", "fin": 2.16, "palabras": [["Pero", 0.07], ["¿y", 0.21], ["si", 0.71], ["no", 0.87], ["hubiera", 1.3], ["ninguna?", 1.73]]}, {"texto": "¿Y si el universo no estuviera hecho para nosotros?", "fin": 3.59, "palabras": [["¿Y", 0.06], ["si", 0.11], ["el", 0.16], ["universo", 0.27], ["no", 1.33], ["estuviera", 1.43], ["hecho", 2.11], ["para", 2.41], ["nosotros?", 2.69]]}, {"texto": "¿Y si no hubiera un significado escrito en alguna parte?", "fin": 3.01, "palabras": [["¿Y", 0.06], ["si", 0.11], ["no", 0.16], ["hubiera", 0.21], ["un", 0.57], ["significado", 0.73], ["escrito", 1.67], ["en", 2.07], ["alguna", 2.13], ["parte?", 2.44]]}, {"texto": "No creo que eso lo haga menos extraordinario.", "fin": 2.89, "palabras": [["No", 0.06], ["creo", 0.11], ["que", 0.16], ["eso", 0.26], ["lo", 0.5], ["haga", 0.66], ["menos", 0.99], ["extraordinario", 1.4]]}, {"texto": "Al contrario.", "fin": 0.84, "palabras": [["Al", 0.06], ["contrario", 0.11]]}, {"texto": "Piensa en todo lo que tuvo que ocurrir para que, durante un instante diminuto de la historia cósmica, la materia pudiera organizarse, respirar, sentir, amar y preguntarse por sí misma.", "fin": 14.16, "palabras": [["Piensa", 0.06], ["en", 0.17], ["todo", 0.38], ["lo", 0.81], ["que", 1.02], ["tuvo", 1.34], ["que", 1.77], ["ocurrir", 2.09], ["para", 2.89], ["que", 2.94], ["durante", 2.99], ["un", 3.04], ["instante", 3.09], ["diminuto", 3.72], ["de", 4.42], ["la", 4.58], ["historia", 4.8], ["cósmica", 5.41], ["la", 5.81], ["materia", 6.14], ["pudiera", 6.6], ["organizarse", 7.39], ["respirar", 8.59], ["sentir", 10.32], ["amar", 11.43], ["y", 11.88], ["preguntarse", 12.43], ["por", 13.06], ["sí", 13.36], ["misma", 13.56]]}, {"texto": "Somos parte de ese universo intentando comprenderse.", "fin": 2.92, "palabras": [["Somos", 0.06], ["parte", 0.11], ["de", 0.33], ["ese", 0.5], ["universo", 0.74], ["intentando", 1.37], ["comprenderse", 2.17]]}, {"texto": "Y cuanto más aprendemos sobre él, más increíble parece.", "fin": 4.3, "palabras": [["Y", 0.06], ["cuanto", 0.11], ["más", 0.26], ["aprendemos", 0.7], ["sobre", 1.62], ["él", 2.13], ["más", 2.4], ["increíble", 2.96], ["parece", 3.38]]}, {"texto": "Descubrir que una flor sigue reglas matemáticas no la hace menos hermosa.", "fin": 4.23, "palabras": [["Descubrir", 0.11], ["que", 0.41], ["una", 0.63], ["flor", 0.68], ["sigue", 0.93], ["reglas", 1.31], ["matemáticas", 1.75], ["no", 2.65], ["la", 2.78], ["hace", 2.91], ["menos", 3.18], ["hermosa", 3.52]]}, {"texto": "Entender las estrellas no apaga su luz.", "fin": 2.65, "palabras": [["Entender", 0.06], ["las", 0.28], ["estrellas", 0.56], ["no", 1.39], ["apaga", 1.58], ["su", 2.05], ["luz", 2.24]]}, {"texto": "Encontrar una explicación no destruye el misterio.", "fin": 2.71, "palabras": [["Encontrar", 0.06], ["una", 0.2], ["explicación", 0.43], ["no", 1.29], ["destruye", 1.41], ["el", 1.87], ["misterio", 1.99]]}, {"texto": "A veces, lo multiplica.", "fin": 1.78, "palabras": [["A", 0.06], ["veces", 0.11], ["lo", 0.49], ["multiplica", 0.83]]}, {"texto": "Quizá no estamos aquí para cumplir un propósito.", "fin": 3.12, "palabras": [["Quizá", 0.06], ["no", 0.18], ["estamos", 0.33], ["aquí", 1.13], ["para", 1.61], ["cumplir", 1.93], ["un", 2.48], ["propósito", 2.64]]}, {"texto": "Quizá simplemente estamos aquí.", "fin": 2.23, "palabras": [["Quizá", 0.06], ["simplemente", 0.61], ["estamos", 1.1], ["aquí", 1.64]]}, {"texto": "Y, sinceramente...", "fin": 2.39, "palabras": [["Y", 0.06], ["sinceramente", 0.83]]}, {"texto": "¿No te parece extraordinario?", "fin": 1.84, "palabras": [["¿No", 0.06], ["te", 0.11], ["parece", 0.16], ["extraordinario?", 0.41]]}]