[{"texto": "Hay algo profundamente extraño en estar vivos.", "fin": 2.63, "palabras": [["Hay", 0.06], ["algo", 0.11], ["profundamente", 0.16], ["extraño", 1.09], ["en", 1.63], ["estar", 1.78], ["vivos", 2.17]]}, {"texto": "Detente un segundo.", "fin": 1.16, "palabras": [["Detente", 0.06], ["un", 0.34], ["segundo", 0.57]]}, {"texto": "Estás aquí, consciente.", "fin": 1.87, "palabras": [["Estás", 0.06], ["aquí", 0.11], ["consciente", 1.06]]}, {"texto": "En un pequeño rincón del universo, sobre una roca que gira alrededor de una estrella, en medio de miles de millones de galaxias.", "fin": 7.86, "palabras": [["En", 0.06], ["un", 0.11], ["pequeño", 0.16], ["rincón", 0.32], ["del", 0.75], ["universo", 0.97], ["sobre", 1.79], ["una", 2.05], ["roca", 2.15], ["que", 2.47], ["gira", 2.71], ["alrededor", 3.08], ["de", 3.77], ["una", 3.93], ["estrella", 4.17], ["en", 4.74], ["medio", 5.28], ["de", 5.33], ["miles", 5.47], ["de", 5.88], ["millones", 6.04], ["de", 6.72], ["galaxias", 6.86]]}, {"texto": "Y puedes darte cuenta.", "fin": 1.49, "palabras": [["Y", 0.06], ["puedes", 0.11], ["darte", 0.25], ["cuenta", 0.76]]}, {"texto": "Puedes mirar el cielo y preguntarte qué es todo esto.", "fin": 3.39, "palabras": [["Puedes", 0.06], ["mirar", 0.11], ["el", 0.56], ["cielo", 0.75], ["y", 1.22], ["preguntarte", 1.31], ["qué", 1.9], ["es", 2.39], ["todo", 2.45], ["esto", 2.72]]}, {"texto": "Puedes escuchar una canción y sentir algo que ni siquiera sabes explicar.", "fin": 4.41, "palabras": [["Puedes", 0.06], ["escuchar", 0.11], ["una", 0.75], ["canción", 0.96], ["y", 1.59], ["sentir", 1.89], ["algo", 2.15], ["que", 2.44], ["ni", 2.69], ["siquiera", 2.9], ["sabes", 3.53], ["explicar", 3.94]]}, {"texto": "Durante siglos hemos buscado un propósito.", "fin": 2.42, "palabras": [["Durante", 0.06], ["siglos", 0.13], ["hemos", 0.65], ["buscado", 1.08], ["un", 1.68], ["propósito", 1.85]]}, {"texto": "Una razón.", "fin": 0.71, "palabras": [["Una", 0.06], ["razón", 0.11]]}, {"texto": "Una respuesta que justifique nuestra existencia.", "fin": 2.7, "palabras": [["Una", 0.06], ["respuesta", 0.11], ["que", 0.46], ["justifique", 0.68], ["nuestra", 1.36], ["existencia", 1.88]]}, {"texto": "Pero ¿y si no hubiera ninguna?", "fin": 2.12, "palabras": [["Pero", 0.08], ["¿y", 0.18], ["si", 0.47], ["no", 0.52], ["hubiera", 0.73], ["ninguna?", 1.16]]}, {"texto": "¿Y si el universo no estuviera hecho para nosotros?", "fin": 3.14, "palabras": [["¿Y", 0.06], ["si", 0.11], ["el", 0.16], ["universo", 0.21], ["no", 0.59], ["estuviera", 0.74], ["hecho", 1.44], ["para", 1.83], ["nosotros?", 2.14]]}, {"texto": "¿Y si no hubiera un significado escrito en alguna parte?", "fin": 2.94, "palabras": [["¿Y", 0.06], ["si", 0.11], ["no", 0.16], ["hubiera", 0.21], ["un", 0.38], ["significado", 0.51], ["escrito", 1.25], ["en", 1.72], ["alguna", 1.87], ["parte?", 2.25]]}, {"texto": "No creo que eso lo haga menos extraordinario.", "fin": 2.54, "palabras": [["No", 0.06], ["creo", 0.11], ["que", 0.16], ["eso", 0.31], ["lo", 0.59], ["haga", 0.74], ["menos", 1.09], ["extraordinario", 1.53]]}, {"texto": "Al contrario.", "fin": 0.8, "palabras": [["Al", 0.06], ["contrario", 0.11]]}, {"texto": "Piensa en todo lo que tuvo que ocurrir para que, durante un instante diminuto de la historia cósmica, la materia pudiera organizarse, respirar, sentir, amar y preguntarse por sí misma.", "fin": 13.02, "palabras": [["Piensa", 0.06], ["en", 0.15], ["todo", 0.4], ["lo", 0.55], ["que", 0.72], ["tuvo", 0.97], ["que", 1.32], ["ocurrir", 1.56], ["para", 2.15], ["que", 2.49], ["durante", 2.54], ["un", 2.82], ["instante", 2.95], ["diminuto", 3.61], ["de", 4.13], ["la", 4.28], ["historia", 4.43], ["cósmica", 5.03], ["la", 5.71], ["materia", 6.08], ["pudiera", 6.34], ["organizarse", 6.97], ["respirar", 8.38], ["sentir", 9.61], ["amar", 10.85], ["y", 11.26], ["preguntarse", 11.67], ["por", 12.17], ["sí", 12.42], ["misma", 12.57]]}, {"texto": "Somos parte de ese universo intentando comprenderse.", "fin": 2.96, "palabras": [["Somos", 0.06], ["parte", 0.11], ["de", 0.33], ["ese", 0.5], ["universo", 0.75], ["intentando", 1.38], ["comprenderse", 2.19]]}, {"texto": "Y cuanto más aprendemos sobre él, más increíble parece.", "fin": 4.11, "palabras": [["Y", 0.06], ["cuanto", 0.11], ["más", 0.29], ["aprendemos", 0.61], ["sobre", 1.69], ["él", 2.22], ["más", 2.36], ["increíble", 2.91], ["parece", 3.69]]}, {"texto": "Descubrir que una flor sigue reglas matemáticas no la hace menos hermosa.", "fin": 4.24, "palabras": [["Descubrir", 0.06], ["que", 0.44], ["una", 0.49], ["flor", 0.73], ["sigue", 1.05], ["reglas", 1.45], ["matemáticas", 1.93], ["no", 2.82], ["la", 2.97], ["hace", 3.13], ["menos", 3.45], ["hermosa", 3.85]]}, {"texto": "Entender las estrellas no apaga su luz.", "fin": 2.58, "palabras": [["Entender", 0.07], ["las", 0.39], ["estrellas", 0.71], ["no", 1.36], ["apaga", 1.41], ["su", 1.95], ["luz", 2.19]]}, {"texto": "Encontrar una explicación no destruye el misterio.", "fin": 3.13, "palabras": [["Encontrar", 0.06], ["una", 0.6], ["explicación", 0.65], ["no", 1.65], ["destruye", 2.01], ["el", 2.41], ["misterio", 2.6]]}, {"texto": "A veces, lo multiplica.", "fin": 1.86, "palabras": [["A", 0.06], ["veces", 0.11], ["lo", 0.54], ["multiplica", 1.09]]}, {"texto": "Quizás no estamos aquí para cumplir un propósito.", "fin": 2.8, "palabras": [["Quizás", 0.06], ["no", 0.13], ["estamos", 0.33], ["aquí", 1.03], ["para", 1.45], ["cumplir", 1.74], ["un", 2.24], ["propósito", 2.38]]}, {"texto": "Quizás simplemente estamos aquí.", "fin": 2.64, "palabras": [["Quizás", 0.06], ["simplemente", 1.1], ["estamos", 1.72], ["aquí", 2.44]]}, {"texto": "Y, sinceramente...", "fin": 1.71, "palabras": [["Y", 0.07], ["sinceramente", 0.47]]}, {"texto": "¿No te parece extraordinario?", "fin": 1.59, "palabras": [["¿No", 0.06], ["te", 0.11], ["parece", 0.16], ["extraordinario?", 0.3]]}]