[{"texto": "Hay algo súper extraño en estar vivo.", "fin": 2.26, "palabras": [["Hay", 0.06], ["algo", 0.13], ["súper", 0.28], ["extraño", 1.03], ["en", 1.23], ["estar", 1.44], ["vivo", 1.83]]}, {"texto": "Mira… para un segundo.", "fin": 2.25, "palabras": [["Mira", 0.08], ["para", 0.96], ["un", 1.22], ["segundo", 1.27]]}, {"texto": "Estái aquí. Estái consciente.", "fin": 1.98, "palabras": [["Estái", 0.08], ["aquí", 0.13], ["Estái", 0.71], ["consciente", 1.35]]}, {"texto": "En una pequeña roca, en un rincón del universo, que está girando alrededor de una estrella, en medio de un montón de galaxias, más que la mierda.", "fin": 9.39, "palabras": [["En", 0.06], ["una", 0.11], ["pequeña", 0.23], ["roca", 1.21], ["en", 1.79], ["un", 1.98], ["rincón", 2.17], ["del", 2.73], ["universo", 3.01], ["que", 3.69], ["está", 3.83], ["girando", 4.02], ["alrededor", 4.5], ["de", 4.84], ["una", 4.97], ["estrella", 5.05], ["en", 6.56], ["medio", 6.82], ["de", 6.87], ["un", 6.92], ["montón", 7.23], ["de", 7.51], ["galaxias", 7.63], ["más", 8.11], ["que", 8.43], ["la", 8.76], ["mierda", 8.98]]}, {"texto": "Y te podís dar cuenta.", "fin": 1.12, "palabras": [["Y", 0.06], ["te", 0.11], ["podís", 0.16], ["dar", 0.21], ["cuenta", 0.33]]}, {"texto": "Podís mirar el cielo y te podís preguntar qué chucha es todo lo que estái viendo.", "fin": 3.59, "palabras": [["Podís", 0.06], ["mirar", 0.18], ["el", 0.86], ["cielo", 1.09], ["y", 1.79], ["te", 1.84], ["podís", 1.89], ["preguntar", 1.94], ["qué", 1.99], ["chucha", 2.12], ["es", 2.38], ["todo", 2.47], ["lo", 2.56], ["que", 2.72], ["estái", 2.92], ["viendo", 3.13]]}, {"texto": "Podís escuchar un temita y podís sentir una weaíta que no sabís qué es.", "fin": 4.1, "palabras": [["Podís", 0.31], ["escuchar", 0.53], ["un", 0.76], ["temita", 0.85], ["y", 1.39], ["podís", 1.76], ["sentir", 2.13], ["una", 2.4], ["weaíta", 2.68], ["que", 2.95], ["no", 3.29], ["sabís", 3.63], ["qué", 3.97], ["es", 4.02]]}, {"texto": "Y durante cualquier tiempo hemos buscado un propósito.", "fin": 2.89, "palabras": [["Y", 0.06], ["durante", 0.11], ["cualquier", 0.37], ["tiempo", 1.33], ["hemos", 2.22], ["buscado", 2.27], ["un", 2.44], ["propósito", 2.67]]}, {"texto": "Alguna razón.", "fin": 0.93, "palabras": [["Alguna", 0.06], ["razón", 0.11]]}, {"texto": "Alguna weaíta que justifique la existencia.", "fin": 2.41, "palabras": [["Alguna", 0.06], ["weaíta", 0.11], ["que", 0.48], ["justifique", 0.7], ["la", 1.51], ["existencia", 1.61]]}, {"texto": "Pero… ¿y si no hay nada?", "fin": 2.44, "palabras": [["Pero", 0.06], ["¿y", 0.92], ["si", 1.09], ["no", 1.26], ["hay", 1.43], ["nada?", 1.69]]}, {"texto": "¿Y si este universo de mierda no está hecho pa' nosotros?", "fin": 2.71, "palabras": [["¿Y", 0.06], ["si", 0.11], ["este", 0.16], ["universo", 0.23], ["de", 1.08], ["mierda", 1.16], ["no", 1.51], ["está", 1.64], ["hecho", 1.69], ["pa", 1.84], ["nosotros?", 2.1]]}, {"texto": "¿Por qué tendría que haber un significado escrito? ¿Por qué po?", "fin": 2.85, "palabras": [["¿Por", 0.06], ["qué", 0.11], ["tendría", 0.16], ["que", 0.46], ["haber", 0.66], ["un", 0.99], ["significado", 1.12], ["escrito?", 1.86], ["¿Por", 1.91], ["qué", 2.41], ["po?", 2.63]]}, {"texto": "Yo la verdad no creo que eso haga todo esto menos bacán.", "fin": 2.88, "palabras": [["Yo", 0.06], ["la", 0.11], ["verdad", 0.16], ["no", 0.38], ["creo", 0.55], ["que", 0.89], ["eso", 1.14], ["haga", 1.43], ["todo", 1.73], ["esto", 2.03], ["menos", 2.33], ["bacán", 2.72]]}, {"texto": "Al contrario…", "fin": 0.98, "palabras": [["Al", 0.06], ["contrario", 0.11]]}, {"texto": "Tenís que pensar en todo lo que tuvo que ocurrir durante un instante diminuto de toda la historia del universo. Hermano, la materia se pudo organizar, se puso a respirar, se puso a sentir, se puso a amar, loco, se puso a preguntarse sobre sí misma.", "fin": 14.06, "palabras": [["Tenís", 0.06], ["que", 0.11], ["pensar", 0.16], ["en", 0.33], ["todo", 0.44], ["lo", 0.69], ["que", 0.81], ["tuvo", 0.99], ["que", 1.24], ["ocurrir", 1.42], ["durante", 1.93], ["un", 2.51], ["instante", 2.85], ["diminuto", 3.29], ["de", 3.94], ["toda", 4.04], ["la", 4.09], ["historia", 4.28], ["del", 4.86], ["universo", 5.12], ["Hermano", 5.91], ["la", 6.22], ["materia", 6.33], ["se", 7.22], ["pudo", 7.28], ["organizar", 7.67], ["se", 7.98], ["puso", 8.29], ["a", 8.6], ["respirar", 8.91], ["se", 9.72], ["puso", 9.77], ["a", 10.23], ["sentir", 10.36], ["se", 10.73], ["puso", 10.81], ["a", 11.14], ["amar", 11.46], ["loco", 11.78], ["se", 11.9], ["puso", 12.14], ["a", 12.38], ["preguntarse", 12.45], ["sobre", 13.04], ["sí", 13.34], ["misma", 13.47]]}, {"texto": "Hermano, somos parte de ese universo que está intentando comprenderse, ¿cachái?", "fin": 4.48, "palabras": [["Hermano", 0.06], ["somos", 0.13], ["parte", 0.47], ["de", 0.93], ["ese", 0.98], ["universo", 1.15], ["que", 1.77], ["está", 1.9], ["intentando", 2.23], ["comprenderse", 2.71], ["¿cachái?", 3.6]]}, {"texto": "Y cuanto más aprendemos sobre él, se pone más pulento.", "fin": 3.82, "palabras": [["Y", 0.06], ["cuanto", 0.11], ["más", 0.16], ["aprendemos", 0.39], ["sobre", 1.26], ["él", 1.7], ["se", 2.03], ["pone", 2.35], ["más", 2.52], ["pulento", 2.72]]}, {"texto": "Descubrir que una flor sigue reglas matemáticas no por eso va a ser menos linda.", "fin": 3.35, "palabras": [["Descubrir", 0.06], ["que", 0.11], ["una", 0.16], ["flor", 0.24], ["sigue", 0.48], ["reglas", 0.65], ["matemáticas", 0.93], ["no", 1.93], ["por", 2.03], ["eso", 2.18], ["va", 2.33], ["a", 2.44], ["ser", 2.49], ["menos", 2.66], ["linda", 2.88]]}, {"texto": "No porque entendái las estrellas se les va a apagar la luz.", "fin": 2.88, "palabras": [["No", 0.06], ["porque", 0.11], ["entendái", 0.57], ["las", 1.06], ["estrellas", 1.56], ["se", 2.05], ["les", 2.12], ["va", 2.18], ["a", 2.31], ["apagar", 2.37], ["la", 2.76], ["luz", 3.13]]}, {"texto": "Aparte, si encontrái una explicación, eso no va a destruir el misterio.", "fin": 2.84, "palabras": [["Aparte", 0.06], ["si", 0.11], ["encontrái", 0.35], ["una", 0.63], ["explicación", 0.81], ["eso", 1.7], ["no", 1.8], ["va", 1.91], ["a", 2.02], ["destruir", 2.12], ["el", 2.51], ["misterio", 2.64]]}, {"texto": "Lo va a multiplicar, perrito.", "fin": 1.82, "palabras": [["Lo", 0.06], ["va", 0.11], ["a", 0.16], ["multiplicar", 0.21], ["perrito", 1.11]]}, {"texto": "Yo creo que no estamos aquí pa' cumplir un propósito.", "fin": 2.94, "palabras": [["Yo", 0.06], ["creo", 0.11], ["que", 0.65], ["no", 0.7], ["estamos", 0.85], ["aquí", 1.11], ["pa", 1.33], ["cumplir", 1.54], ["un", 1.94], ["propósito", 2.09]]}, {"texto": "Porque quizás estamos aquí no más po. Y era.", "fin": 2.79, "palabras": [["Porque", 0.08], ["quizás", 0.38], ["estamos", 0.69], ["aquí", 1.12], ["no", 1.38], ["más", 1.66], ["po", 1.94], ["Y", 2.23], ["era", 2.51]]}, {"texto": "¿Pero sabís qué? Sinceramente…", "fin": 1.74, "palabras": [["¿Pero", 0.06], ["sabís", 0.11], ["qué?", 0.24], ["Sinceramente", 0.7]]}, {"texto": "¿No te parece bacán esa weá?", "fin": 1.39, "palabras": [["¿No", 0.06], ["te", 0.11], ["parece", 0.16], ["bacán", 0.3], ["esa", 0.65], ["weá?", 1.02]]}]