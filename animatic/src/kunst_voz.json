[{"texto": "En 1864, un joven biólogo perdió a su esposa el mismo día en que cumplía treinta años.", "fin": 7.71, "palabras": [["En", 0.08], ["1864", 0.25], ["un", 2.54], ["joven", 2.69], ["biólogo", 3.07], ["perdió", 3.58], ["a", 4.04], ["su", 4.1], ["esposa", 4.25], ["el", 4.79], ["mismo", 4.92], ["día", 5.28], ["en", 5.67], ["que", 5.82], ["cumplía", 5.96], ["treinta", 6.54], ["años", 7.14]]}, {"texto": "Se llamaba Ernst Haeckel. Y se refugió en lo que más amaba: los seres más pequeños del océano.", "fin": 7.21, "palabras": [["Se", 0.1], ["llamaba", 0.28], ["Ernst", 0.88], ["Haeckel", 1.36], ["Y", 2.49], ["se", 2.58], ["refugió", 2.75], ["en", 3.33], ["lo", 3.43], ["que", 3.56], ["más", 3.69], ["amaba", 3.99], ["los", 4.9], ["seres", 5.07], ["más", 5.44], ["pequeños", 5.76], ["del", 6.36], ["océano", 6.53]]}, {"texto": "Criaturas de una sola célula que construyen esqueletos de vidrio.", "fin": 4.39, "palabras": [["Criaturas", 0.08], ["de", 0.75], ["una", 0.88], ["sola", 1.11], ["célula", 1.46], ["que", 2.01], ["construyen", 2.19], ["esqueletos", 2.96], ["de", 3.69], ["vidrio", 3.79]]}, {"texto": "Los dibujó durante décadas, con una paciencia casi imposible.", "fin": 4.87, "palabras": [["Los", 0.08], ["dibujó", 0.35], ["durante", 0.82], ["décadas", 1.29], ["con", 2.4], ["una", 2.6], ["paciencia", 2.81], ["casi", 3.57], ["imposible", 4.04]]}, {"texto": "En 1904 reunió cien láminas en un libro: Kunstformen der Natur. Formas artísticas de la naturaleza.", "fin": 8.86, "palabras": [["En", 0.1], ["1904", 0.25], ["reunió", 1.62], ["cien", 2.1], ["láminas", 2.46], ["en", 3.04], ["un", 3.18], ["libro", 3.33], ["Kunstformen", 4.17], ["der", 4.99], ["Natur", 5.21], ["Formas", 6.22], ["artísticas", 6.79], ["de", 7.65], ["la", 7.76], ["naturaleza", 7.88]]}, {"texto": "Medusas, diatomeas y corales, cada uno con una simetría que parece pensada por un arquitecto.", "fin": 7.21, "palabras": [["Medusas", 0.08], ["diatomeas", 1.17], ["y", 1.9], ["corales", 1.97], ["cada", 3.03], ["uno", 3.33], ["con", 3.64], ["una", 3.85], ["simetría", 4.04], ["que", 4.72], ["parece", 4.89], ["pensada", 5.33], ["por", 5.97], ["un", 6.21], ["arquitecto", 6.39]]}, {"texto": "Hoy sabemos que muchas de esas formas pueden surgir de reglas muy simples.", "fin": 4.86, "palabras": [["Hoy", 0.08], ["sabemos", 0.28], ["que", 0.82], ["muchas", 0.94], ["de", 1.4], ["esas", 1.56], ["formas", 1.85], ["pueden", 2.4], ["surgir", 2.76], ["de", 3.22], ["reglas", 3.35], ["muy", 3.89], ["simples", 4.14]]}, {"texto": "Una espuma de burbujas puede servir de molde para un esqueleto.", "fin": 4.22, "palabras": [["Una", 0.08], ["espuma", 0.31], ["de", 0.75], ["burbujas", 0.86], ["puede", 1.61], ["servir", 1.93], ["de", 2.39], ["molde", 2.5], ["para", 2.97], ["un", 3.26], ["esqueleto", 3.44]]}, {"texto": "Dos sustancias que reaccionan pueden dibujar los patrones de un coral.", "fin": 4.69, "palabras": [["Dos", 0.07], ["sustancias", 0.36], ["que", 1.18], ["reaccionan", 1.32], ["pueden", 2.08], ["dibujar", 2.46], ["los", 3.01], ["patrones", 3.22], ["de", 3.86], ["un", 3.99], ["coral", 4.17]]}, {"texto": "Y unas pocas leyes de crecimiento bastan para que algo parezca vivo.", "fin": 4.53, "palabras": [["Y", 0.08], ["unas", 0.21], ["pocas", 0.53], ["leyes", 0.94], ["de", 1.38], ["crecimiento", 1.49], ["bastan", 2.25], ["para", 2.78], ["que", 3.03], ["algo", 3.22], ["parezca", 3.56], ["vivo", 4.06]]}, {"texto": "Sus dibujos llegaron al arte y a la arquitectura: a la gran puerta de la Exposición de París de mil novecientos.", "fin": 7.57, "palabras": [["Sus", 0.08], ["dibujos", 0.35], ["llegaron", 0.88], ["al", 1.35], ["arte", 1.51], ["y", 1.93], ["a", 2.1], ["la", 2.18], ["arquitectura", 2.29], ["a", 3.72], ["la", 3.83], ["gran", 3.96], ["puerta", 4.28], ["de", 4.68], ["la", 4.82], ["Exposición", 4.9], ["de", 5.68], ["París", 5.81], ["de", 6.22], ["mil", 6.33], ["novecientos", 6.61]]}, {"texto": "Pero en una de sus láminas hay una medusa con nombre de mujer.", "fin": 4.12, "palabras": [["Pero", 0.1], ["en", 0.32], ["una", 0.44], ["de", 0.65], ["sus", 0.79], ["láminas", 1.04], ["hay", 1.74], ["una", 1.94], ["medusa", 2.14], ["con", 2.71], ["nombre", 2.99], ["de", 3.42], ["mujer", 3.54]]}, {"texto": "No era la primera: ese mismo año había llamado Anna a otra medusa, cuyos tentáculos, escribió, le recordaban su cabello.", "fin": 9.68, "palabras": [["No", 0.07], ["era", 0.36], ["la", 0.56], ["primera", 0.69], ["ese", 1.79], ["mismo", 2.07], ["año", 2.5], ["había", 2.82], ["llamado", 3.1], ["Anna", 3.68], ["a", 4.01], ["otra", 4.12], ["medusa", 4.43], ["cuyos", 5.49], ["tentáculos", 5.86], ["escribió", 7.03], ["le", 8.07], ["recordaban", 8.18], ["su", 8.92], ["cabello", 9.06]]}, {"texto": "Hoy sabemos que esa belleza es la huella visible de leyes simples: simetría, crecimiento y economía de materia.", "fin": 8.28, "palabras": [["Hoy", 0.08], ["sabemos", 0.26], ["que", 0.83], ["esa", 1.0], ["belleza", 1.24], ["es", 1.89], ["la", 2.06], ["huella", 2.19], ["visible", 2.54], ["de", 3.11], ["leyes", 3.25], ["simples", 3.67], ["simetría", 4.69], ["crecimiento", 5.86], ["y", 6.74], ["economía", 6.88], ["de", 7.49], ["materia", 7.61]]}, {"texto": "Haeckel las dibujó sin conocerlas del todo, y entre ellas dejó el nombre de Anna. Más de un siglo después, sus láminas siguen enseñándonos a mirar.", "fin": 10.97, "palabras": [["Haeckel", 0.08], ["las", 0.58], ["dibujó", 0.75], ["sin", 1.21], ["conocerlas", 1.44], ["del", 2.14], ["todo", 2.33], ["y", 3.25], ["entre", 3.36], ["ellas", 3.74], ["dejó", 4.15], ["el", 4.5], ["nombre", 4.65], ["de", 5.07], ["Anna", 5.25], ["Más", 6.17], ["de", 6.49], ["un", 6.61], ["siglo", 6.81], ["después", 7.19], ["sus", 8.22], ["láminas", 8.51], ["siguen", 9.04], ["enseñándonos", 9.43], ["a", 10.38], ["mirar", 10.44]]}]