[{"texto": "Si toda la historia del universo cupiera en un solo año, tu vida entera duraría menos que un parpadeo.", "fin": 7.07, "palabras": [["Si", 0.08], ["toda", 0.33], ["la", 0.65], ["historia", 0.76], ["del", 1.28], ["universo", 1.47], ["cupiera", 2.08], ["en", 2.58], ["un", 2.69], ["solo", 2.85], ["año", 3.22], ["tu", 4.11], ["vida", 4.25], ["entera", 4.51], ["duraría", 4.94], ["menos", 5.49], ["que", 5.96], ["un", 6.11], ["parpadeo", 6.31]]}, {"texto": "Para entenderlo, primero hay que preguntarse qué es un segundo.", "fin": 4.44, "palabras": [["Para", 0.1], ["entenderlo", 0.28], ["primero", 1.56], ["hay", 2.03], ["que", 2.21], ["preguntarse", 2.36], ["qué", 3.19], ["es", 3.43], ["un", 3.62], ["segundo", 3.76]]}, {"texto": "En ese tiempo, la luz podría recorrer siete veces y media la vuelta a la Tierra.", "fin": 5.57, "palabras": [["En", 0.08], ["ese", 0.25], ["tiempo", 0.51], ["la", 1.5], ["luz", 1.6], ["podría", 1.82], ["recorrer", 2.24], ["siete", 2.79], ["veces", 3.17], ["y", 3.72], ["media", 3.83], ["la", 4.24], ["vuelta", 4.36], ["a", 4.82], ["la", 4.86], ["Tierra", 5.0]]}, {"texto": "Y la radiación del cesio oscila más de nueve mil millones de veces: así definimos el segundo.", "fin": 6.58, "palabras": [["Y", 0.08], ["la", 0.17], ["radiación", 0.33], ["del", 0.92], ["cesio", 1.1], ["oscila", 1.64], ["más", 2.1], ["de", 2.43], ["nueve", 2.53], ["mil", 2.85], ["millones", 3.14], ["de", 3.67], ["veces", 3.76], ["así", 4.72], ["definimos", 5.06], ["el", 5.79], ["segundo", 5.92]]}, {"texto": "Y aun así, ese segundo no dura lo mismo en todas partes. Tu cabeza envejece un poco más rápido que tus pies.", "fin": 8.36, "palabras": [["Y", 0.08], ["aun", 0.21], ["así", 0.44], ["ese", 1.35], ["segundo", 1.6], ["no", 2.17], ["dura", 2.35], ["lo", 2.62], ["mismo", 2.76], ["en", 3.25], ["todas", 3.43], ["partes", 3.85], ["Tu", 4.94], ["cabeza", 5.04], ["envejece", 5.51], ["un", 6.12], ["poco", 6.29], ["más", 6.61], ["rápido", 6.93], ["que", 7.44], ["tus", 7.6], ["pies", 7.83]]}, {"texto": "Cada reloj lleva su propio ritmo. Los físicos lo llaman tiempo propio.", "fin": 5.62, "palabras": [["Cada", 0.1], ["reloj", 0.39], ["lleva", 0.9], ["su", 1.31], ["propio", 1.5], ["ritmo", 1.96], ["Los", 2.97], ["físicos", 3.25], ["lo", 3.9], ["llaman", 4.06], ["tiempo", 4.56], ["propio", 5.01]]}, {"texto": "Con esa idea, volvamos al año del universo. Las primeras estrellas se encienden en los primeros días de enero.", "fin": 8.32, "palabras": [["Con", 0.08], ["esa", 0.26], ["idea", 0.54], ["volvamos", 1.61], ["al", 2.26], ["año", 2.44], ["del", 2.75], ["universo", 2.94], ["Las", 4.12], ["primeras", 4.36], ["estrellas", 4.86], ["se", 5.54], ["encienden", 5.71], ["en", 6.38], ["los", 6.49], ["primeros", 6.68], ["días", 7.26], ["de", 7.67], ["enero", 7.79]]}, {"texto": "El Sol nace a fines de agosto. La vida aparece a fines de septiembre.", "fin": 5.6, "palabras": [["El", 0.1], ["Sol", 0.28], ["nace", 0.61], ["a", 1.06], ["fines", 1.18], ["de", 1.64], ["agosto", 1.74], ["La", 2.82], ["vida", 3.0], ["aparece", 3.38], ["a", 4.07], ["fines", 4.22], ["de", 4.68], ["septiembre", 4.79]]}, {"texto": "Los dinosaurios llegan recién para Navidad.", "fin": 3.11, "palabras": [["Los", 0.08], ["dinosaurios", 0.33], ["llegan", 1.21], ["recién", 1.64], ["para", 2.19], ["Navidad", 2.42]]}, {"texto": "Y nosotros, el treinta y uno, a once minutos de la medianoche.", "fin": 5.0, "palabras": [["Y", 0.08], ["nosotros", 0.18], ["el", 1.39], ["treinta", 1.57], ["y", 1.99], ["uno", 2.11], ["a", 2.9], ["once", 3.07], ["minutos", 3.43], ["de", 3.99], ["la", 4.08], ["medianoche", 4.19]]}, {"texto": "Toda la historia escrita cabe en los últimos doce segundos.", "fin": 4.03, "palabras": [["Toda", 0.08], ["la", 0.36], ["historia", 0.47], ["escrita", 1.0], ["cabe", 1.57], ["en", 1.96], ["los", 2.06], ["últimos", 2.26], ["doce", 2.86], ["segundos", 3.21]]}, {"texto": "Y una vida humana entera cabe en ese destello.", "fin": 3.33, "palabras": [["Y", 0.08], ["una", 0.21], ["vida", 0.43], ["humana", 0.74], ["entera", 1.19], ["cabe", 1.68], ["en", 2.14], ["ese", 2.31], ["destello", 2.57]]}, {"texto": "Pero piensa en todo lo que cabe ahí.", "fin": 2.49, "palabras": [["Pero", 0.1], ["piensa", 0.32], ["en", 0.86], ["todo", 1.06], ["lo", 1.43], ["que", 1.58], ["cabe", 1.74], ["ahí", 2.11]]}, {"texto": "Alguien que te sostuvo antes de que pudieras recordarlo.", "fin": 3.6, "palabras": [["Alguien", 0.08], ["que", 0.51], ["te", 0.65], ["sostuvo", 0.78], ["antes", 1.43], ["de", 1.88], ["que", 2.0], ["pudieras", 2.15], ["recordarlo", 2.75]]}, {"texto": "Una noche en la que no querías que amaneciera.", "fin": 2.99, "palabras": [["Una", 0.08], ["noche", 0.32], ["en", 0.82], ["la", 0.94], ["que", 1.07], ["no", 1.22], ["querías", 1.43], ["que", 2.0], ["amaneciera", 2.12]]}, {"texto": "La última conversación con alguien que ya no está.", "fin": 3.39, "palabras": [["La", 0.08], ["última", 0.28], ["conversación", 0.72], ["con", 1.61], ["alguien", 1.85], ["que", 2.35], ["ya", 2.49], ["no", 2.72], ["está", 2.9]]}, {"texto": "Todo eso cabe en menos de dos décimas de segundo.", "fin": 3.49, "palabras": [["Todo", 0.08], ["eso", 0.39], ["cabe", 0.74], ["en", 1.08], ["menos", 1.21], ["de", 1.64], ["dos", 1.76], ["décimas", 2.11], ["de", 2.67], ["segundo", 2.78]]}, {"texto": "El universo tardó trece mil ochocientos millones de años en llegar hasta aquí.", "fin": 5.01, "palabras": [["El", 0.08], ["universo", 0.25], ["tardó", 0.85], ["trece", 1.25], ["mil", 1.61], ["ochocientos", 1.86], ["millones", 2.57], ["de", 3.1], ["años", 3.24], ["en", 3.78], ["llegar", 3.97], ["hasta", 4.33], ["aquí", 4.61]]}, {"texto": "Para él, tu vida es un parpadeo. Para ti, es todo el tiempo que existe.", "fin": 6.44, "palabras": [["Para", 0.1], ["él", 0.4], ["tu", 1.25], ["vida", 1.4], ["es", 1.83], ["un", 2.03], ["parpadeo", 2.18], ["Para", 3.42], ["ti", 3.64], ["es", 4.53], ["todo", 4.74], ["el", 5.03], ["tiempo", 5.18], ["que", 5.61], ["existe", 5.74]]}, {"texto": "Y aunque dure apenas un parpadeo, es el único tiempo que tienes para mirar el cielo, para abrazar, para equivocarte y volver a empezar.", "fin": 9.56, "palabras": [["Y", 0.08], ["aunque", 0.21], ["dure", 0.53], ["apenas", 0.78], ["un", 1.26], ["parpadeo", 1.39], ["es", 2.56], ["el", 2.76], ["único", 2.92], ["tiempo", 3.28], ["que", 3.72], ["tienes", 3.89], ["para", 4.31], ["mirar", 4.53], ["el", 4.88], ["cielo", 5.01], ["para", 5.94], ["abrazar", 6.18], ["para", 7.15], ["equivocarte", 7.39], ["y", 8.26], ["volver", 8.38], ["a", 8.82], ["empezar", 8.88]]}, {"texto": "Cada risa, cada conversación, cada momento que regalas, sigue viajando en los demás.", "fin": 6.87, "palabras": [["Cada", 0.08], ["risa", 0.39], ["cada", 1.29], ["conversación", 1.58], ["cada", 2.99], ["momento", 3.26], ["que", 3.79], ["regalas", 3.92], ["sigue", 4.97], ["viajando", 5.36], ["en", 6.0], ["los", 6.1], ["demás", 6.29]]}, {"texto": "Como la luz de una estrella, que sigue llegando mucho después de apagarse.", "fin": 5.1, "palabras": [["Como", 0.08], ["la", 0.33], ["luz", 0.46], ["de", 0.75], ["una", 0.88], ["estrella", 1.1], ["que", 2.17], ["sigue", 2.31], ["llegando", 2.65], ["mucho", 3.19], ["después", 3.64], ["de", 4.21], ["apagarse", 4.31]]}, {"texto": "Así que no lo apures, míralo, siéntelo y compártelo, porque para nosotros, este parpadeo lo es todo.", "fin": 8.4, "palabras": [["Así", 0.1], ["que", 0.43], ["no", 0.57], ["lo", 0.76], ["apures", 0.89], ["míralo", 1.97], ["siéntelo", 2.94], ["y", 3.56], ["compártelo", 3.62], ["porque", 4.85], ["para", 5.18], ["nosotros", 5.4], ["este", 6.53], ["parpadeo", 6.83], ["lo", 7.51], ["es", 7.74], ["todo", 7.94]]}]